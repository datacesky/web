---
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/montserrat/900.css';
import '../styles/global.css';
import { web } from '../data/web';
import { hlasovaniZapnute } from '../data/hlasovani';
import Hledani from '../components/Hledani.astro';

interface Props {
  titul: string;
  popis?: string;
  obrazek?: string;
}

const {
  titul,
  popis = 'Česko v mapách, grafech a číslech. Ověřená data z ČSÚ, Eurostatu a dalších primárních zdrojů.',
  obrazek,
} = Astro.props;

const kanonicka = new URL(Astro.url.pathname, Astro.site);
const ogObrazek = new URL(obrazek ?? '/og/uvod.png', Astro.site);
const cesta = Astro.url.pathname;
const aktivni = (prefix: string) => (cesta.startsWith(prefix) ? 'page' : undefined);
const rok = new Date().getFullYear();

const IG = 'https://www.instagram.com/data.cesky/';
const TT = 'https://www.tiktok.com/@data.cesky';
const FB = 'https://www.facebook.com/data.cesky';

// Ikony sítí (Tabler, obrys 24×24)
const SITE = [
  { nazev: 'Instagram', url: IG, d: 'M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z M9 12a3 3 0 1 0 6 0a3 3 0 0 0-6 0 M16.5 7.5v.01' },
  { nazev: 'TikTok', url: TT, d: 'M21 7.9v4a10 10 0 0 1-5-1.9v4.5a6.5 6.5 0 1 1-8-6.3v4.3a2.5 2.5 0 1 0 4 2V3h4.1A6 6 0 0 0 21 7.9z' },
  { nazev: 'Facebook', url: FB, d: 'M7 10v4h3v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3V3h-3a5 5 0 0 0-5 5v2z' },
];

// Spodní lišta na telefonu: pět hlavních míst webu
const DOK = [
  { href: '/novinky/', nazev: 'Novinky', aktivni: aktivni('/novinky'), d: 'M13 3L4 14h7l-1 7 9-11h-7z' },
  { href: '/zebricky/', nazev: 'Žebříčky', aktivni: aktivni('/zebricky') ?? aktivni('/grafy'), d: 'M4 5h10 M4 10h16 M4 15h13 M4 20h7' },
  { href: '/mapa/', nazev: 'Mapa', aktivni: aktivni('/mapa'), d: 'M3 7l6-3 6 3 6-3v13l-6 3-6-3-6 3z M9 4v13 M15 7v13' },
  { href: '/svet/', nazev: 'Svět', aktivni: aktivni('/svet'), d: 'M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18' },
  { href: '/serie/', nazev: 'Série', aktivni: aktivni('/serie'), d: 'M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M10 9.5v5l4.5-2.5z' },
];
const LUPA = 'M10 4a6 6 0 1 0 0 12a6 6 0 1 0 0-12 M20 20l-5.6-5.6';
const MESIC = 'M12 3c.13 0 .26 0 .39 0a7.5 7.5 0 0 0 7.92 12.45A9 9 0 1 1 12 3z';
const SLUNCE = 'M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8 M3 12h1 M20 12h1 M12 3v1 M12 20v1 M5.6 5.6l.7.7 M17.7 17.7l.7.7 M5.6 18.4l.7-.7 M17.7 6.3l.7-.7';
// Volba vzhledu v patičce
const VZHLED = [
  { v: 'auto', nazev: 'Podle zařízení' },
  { v: 'svetly', nazev: 'Světlý' },
  { v: 'tmavy', nazev: 'Tmavý' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titul}</title>
    <meta name="description" content={popis} />
    <link rel="canonical" href={kanonicka} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Vzhled se nastaví ještě před vykreslením, ať stránka neprobliká: volba z patičky, jinak podle zařízení
      (function () {
        var d = document.documentElement, v = 'auto';
        d.classList.add('js');
        try { v = localStorage.getItem('tema') || 'auto'; } catch (e) {}
        if (v !== 'svetly' && v !== 'tmavy') v = 'auto';
        var t = v === 'auto' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'tmavy' : 'svetly') : v;
        d.dataset.tema = t; d.dataset.temaVolba = v;
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="data.cesky" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={titul} />
    <meta property="og:description" content={popis} />
    <meta property="og:url" content={kanonicka} />
    <meta property="og:image" content={ogObrazek} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F2EDE3" data-barva-listy />
    <meta name="color-scheme" content="light dark" />
    {web.google && <meta name="google-site-verification" content={web.google} />}
    {web.seznam && <meta name="seznam-wmt" content={web.seznam} />}
    {cesta === '/' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'data.cesky', alternateName: 'Data Česky', url: 'https://datacesky.cz/', inLanguage: 'cs', description: popis, sameAs: [IG, TT, FB] })} />
    )}
    {web.goatcounter && <script is:inline data-goatcounter={`https://${web.goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <header class="hlavicka">
      <div class="obal hlavicka__obsah">
        <a class="logo" href="/" aria-label="data.cesky, úvodní stránka">data<span class="logo__cesky">.cesky</span></a>
        <nav class="navigace" aria-label="Hlavní navigace">
          <a href="/novinky/" aria-current={aktivni('/novinky')}>Novinky</a>
          <a href="/zebricky/" aria-current={aktivni('/zebricky') ?? aktivni('/grafy')}>Žebříčky</a>
          <a href="/mapa/" aria-current={aktivni('/mapa')}>Mapa Česka</a>
          <a href="/svet/" aria-current={aktivni('/svet')}>Svět</a>
          <a href="/serie/" aria-current={aktivni('/serie')}>Série</a>
          <a href="/metodika/" aria-current={aktivni('/metodika')}>Metodika</a>
        </nav>
        <div class="hlavicka__akce">
          <button type="button" class="hlavicka__hledat" data-hledat aria-label="Hledat na webu" aria-keyshortcuts="Control+K Meta+K">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d={LUPA} /></svg>
            <span class="hlavicka__hledat-text">Hledat</span>
            <kbd class="hlavicka__zkratka" data-zkratka>⌘K</kbd>
          </button>
          <button type="button" class="hlavicka__tema" data-tema-prepni aria-label="Přepnout vzhled" title="Přepnout světlý a tmavý vzhled">
            <svg class="hlavicka__mesic" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={MESIC} /></svg>
            <svg class="hlavicka__slunce" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={SLUNCE} /></svg>
          </button>
          {hlasovaniZapnute && <a href="/hlasovani/" class="hlavicka__hlasuj" aria-current={aktivni('/hlasovani')}>Hlasuj</a>}
          <div class="hlavicka__site">
            {SITE.map((x) => (
              <a href={x.url} aria-label={x.nazev} title={x.nazev}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={x.d} /></svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="patka">
      <div class="obal">
        <div class="patka__mrizka">
          <div class="sloupec patka__znacka">
            <a class="logo" href="/" aria-label="data.cesky, úvodní stránka">data<span class="logo__cesky">.cesky</span></a>
            <p class="drobne" style="max-width: 40ch;">
              Česko v mapách, grafech a číslech. Zdroj je vždy uvedený u každého grafu.
            </p>
            <div class="patka__site">
              {SITE.map((x) => (
                <a href={x.url} aria-label={x.nazev} title={x.nazev}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={x.d} /></svg>
                </a>
              ))}
            </div>
          </div>
          <div class="sloupec">
            <h2>Obsah</h2>
            <ul class="patka__odkazy">
              <li><a href="/novinky/">Novinky z dat</a></li>
              <li><a href="/zebricky/">Žebříčky a grafy</a></li>
              <li><a href="/mapa/">Mapa Česka</a></li>
              <li><a href="/svet/">Svět</a></li>
              <li><a href="/serie/">Série</a></li>
              {hlasovaniZapnute && <li><a href="/hlasovani/">Hlasuj o dalším dílu</a></li>}
            </ul>
          </div>
          <div class="sloupec">
            <h2>O projektu</h2>
            <ul class="patka__odkazy">
              <li><a href="/metodika/">Metodika a zdroje</a></li>
              <li><a href="/metodika/#opravy">Opravy</a></li>
              <li><a href="/metodika/#soukromi">Soukromí a cookies</a></li>
              <li><a href="mailto:data.cesky@gmail.com">Kontakt</a></li>
            </ul>
          </div>
          <div class="sloupec patka__hledani">
            <h2>Nenašel jsi to?</h2>
            <button type="button" class="tlacitko tlacitko--male patka__hledat" data-hledat>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d={LUPA} /></svg>
              Hledat na webu
            </button>
            <p class="drobne">Země, kraje, města, žebříčky i díly sérií.</p>
          </div>
        </div>
        <div class="patka__spodek">
          <p class="drobne">
            © {rok} data.cesky. Grafy jsou pod licencí <a href="https://creativecommons.org/licenses/by/4.0/deed.cs">CC BY 4.0</a>.
            Kontakt: <a href="mailto:data.cesky@gmail.com">data.cesky@gmail.com</a>
          </p>
          <div class="rada">
            <div class="patka__vzhled">
              <span class="drobne" id="vzhled-nadpis">Vzhled</span>
              <div class="segment segment--male" role="group" aria-labelledby="vzhled-nadpis" data-vzhled-volba>
                {VZHLED.map((x) => <button type="button" data-v={x.v} aria-pressed={x.v === 'auto' ? 'true' : 'false'}>{x.nazev}</button>)}
              </div>
            </div>
            <a class="patka__nahoru" href="#" data-nahoru>Nahoru<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5 M6 11l6-6 6 6" /></svg></a>
            <span class="znacka">@data<span>.cesky</span></span>
          </div>
        </div>
      </div>
    </footer>

    <nav class="dok" aria-label="Hlavní navigace" data-dok>
      {DOK.map((x) => (
        <a href={x.href} aria-current={x.aktivni}>
          <span class="dok__ikona"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={x.d} /></svg></span>
          <span class="dok__nazev">{x.nazev}</span>
        </a>
      ))}
    </nav>

    <Hledani />

    <script>
      // Vzhled (světlý / tmavý). Mapy a grafy kreslené skriptem poslouchají událost „tema“ a překreslí se.
      {
        const koren = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        const lista = document.querySelector<HTMLMetaElement>('[data-barva-listy]');
        const prepni = document.querySelector<HTMLButtonElement>('[data-tema-prepni]');
        const volby = document.querySelectorAll<HTMLButtonElement>('[data-vzhled-volba] button');
        const vyres = (v: string) => (v === 'auto' ? (system.matches ? 'tmavy' : 'svetly') : v);
        const ukaz = () => {
          const t = koren.dataset.tema, v = koren.dataset.temaVolba || 'auto';
          lista?.setAttribute('content', t === 'tmavy' ? '#0E1628' : '#F2EDE3');
          prepni?.setAttribute('aria-label', t === 'tmavy' ? 'Přepnout na světlý vzhled' : 'Přepnout na tmavý vzhled');
          volby.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
        };
        const nastav = (v: string, animuj: boolean) => {
          const t = vyres(v);
          const zmena = t !== koren.dataset.tema;
          const proved = () => { koren.dataset.tema = t; koren.dataset.temaVolba = v; ukaz(); if (zmena) document.dispatchEvent(new CustomEvent('tema', { detail: { tema: t } })); };
          try { if (v === 'auto') localStorage.removeItem('tema'); else localStorage.setItem('tema', v); } catch {}
          const vt = (document as any).startViewTransition;
          if (animuj && zmena && vt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            koren.classList.add('meni-tema');
            vt.call(document, proved).finished.finally(() => koren.classList.remove('meni-tema'));
          } else proved();
        };
        ukaz();
        prepni?.addEventListener('click', () => nastav(koren.dataset.tema === 'tmavy' ? 'svetly' : 'tmavy', true));
        volby.forEach((b) => b.addEventListener('click', () => nastav(b.dataset.v || 'auto', true)));
        system.addEventListener('change', () => { if ((koren.dataset.temaVolba || 'auto') === 'auto') nastav('auto', false); });
      }

      // Hlavička: stín jen ve chvíli, kdy pod ní jede obsah
      const hlavicka = document.querySelector('.hlavicka');
      if (hlavicka) {
        let pod = false;
        const zkontroluj = () => {
          const ted = window.scrollY > 2;
          if (ted !== pod) { pod = ted; hlavicka.classList.toggle('je-pod', ted); }
        };
        addEventListener('scroll', zkontroluj, { passive: true });
        zkontroluj();
      }

      // Segmentové přepínače: tmavá pilulka přejede pod vybrané tlačítko místo skoku
      for (const seg of document.querySelectorAll<HTMLElement>('.segment')) {
        const jezdec = document.createElement('span');
        jezdec.className = 'segment__jezdec bez-prechodu';
        jezdec.setAttribute('aria-hidden', 'true');
        seg.prepend(jezdec);
        const posun = () => {
          const b = seg.querySelector<HTMLElement>('button[aria-pressed="true"]');
          jezdec.hidden = !b;
          if (!b) return;
          jezdec.style.setProperty('--x', `${b.offsetLeft}px`);
          jezdec.style.setProperty('--y', `${b.offsetTop}px`);
          jezdec.style.setProperty('--w', `${b.offsetWidth}px`);
          jezdec.style.setProperty('--h', `${b.offsetHeight}px`);
        };
        posun();
        seg.classList.add('ma-jezdec');
        requestAnimationFrame(() => jezdec.classList.remove('bez-prechodu'));
        new MutationObserver(posun).observe(seg, { attributes: true, subtree: true, attributeFilter: ['aria-pressed'] });
        new ResizeObserver(() => {
          jezdec.classList.add('bez-prechodu');
          posun();
          requestAnimationFrame(() => jezdec.classList.remove('bez-prechodu'));
        }).observe(seg);
      }

      // Spodní lišta na telefonu: při čtení dolů ustoupí, při posunu nahoru (nebo na konci stránky) se vrátí.
      // Když se píše do pole, schová se, ať nepřekáží klávesnici.
      const dok = document.querySelector<HTMLElement>('[data-dok]');
      if (dok) {
        let posledni = scrollY, schovany = false;
        const nastav = (s: boolean) => { if (s !== schovany) { schovany = s; dok.classList.toggle('dok--schovany', s); } };
        addEventListener('scroll', () => {
          const y = scrollY, dy = y - posledni;
          const naKonci = innerHeight + y >= document.documentElement.scrollHeight - 40;
          if (naKonci || y < 80) nastav(false);
          else if (dy > 6) nastav(true);
          else if (dy < -6) nastav(false);
          if (Math.abs(dy) > 6) posledni = y;
        }, { passive: true });
        addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches('input, textarea, select')) dok.classList.add('dok--pise'); });
        addEventListener('focusout', () => dok.classList.remove('dok--pise'));
      }

      // Nahoru: plynule, bez # v adrese
      document.querySelector('[data-nahoru]')?.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });

      // Karty posouvané do strany (mobil): tečky pod nimi ukazují, kde jsi
      for (const pas of document.querySelectorAll<HTMLElement>('[data-posuvnik]')) {
        const tecky = Array.from(pas.parentElement?.querySelectorAll<HTMLElement>('[data-tecky] i') ?? []);
        if (!tecky.length) continue;
        let i0 = 0;
        pas.addEventListener('scroll', () => {
          const prvni = pas.firstElementChild as HTMLElement | null;
          if (!prvni) return;
          const krok = prvni.offsetWidth + parseFloat(getComputedStyle(pas).columnGap || '0');
          const i = Math.min(tecky.length - 1, Math.round(pas.scrollLeft / krok));
          if (i !== i0) { tecky[i0].classList.remove('je-aktivni'); tecky[i].classList.add('je-aktivni'); i0 = i; }
        }, { passive: true });
      }

      // Velká čísla naskočí od nuly, až přijedou do obrazu. Text na konci je vždy přesně ten původní.
      const klid = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const CISLO = /([+−-]?)(\d{1,3}(?:[ \u00a0]\d{3})+|\d+)(?:,(\d+))?/;
      const pocitej = (el: HTMLElement) => {
        if (el.dataset.bezi) return;
        const puvodni = el.dataset.puvodni ?? el.textContent ?? '';
        el.dataset.puvodni = puvodni;
        const m = puvodni.match(CISLO);
        if (!m || klid) { el.textContent = puvodni; return; }
        const des = m[3]?.length ?? 0;
        const cil = Number(m[2].replace(/[ \u00a0]/g, '') + (des ? '.' + m[3] : ''));
        const nf = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: des, maximumFractionDigits: des });
        const pred = puvodni.slice(0, m.index! + m[1].length), po = puvodni.slice(m.index! + m[0].length);
        const zacatek = performance.now(), doba = cil > 999 ? 1400 : 1000;
        el.dataset.bezi = '1';
        const krok = (t: number) => {
          const k = Math.min(1, (t - zacatek) / doba);
          const e = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? pred + nf.format(cil * e).replace(/\u00a0/g, ' ') + po : puvodni;
          if (k < 1) requestAnimationFrame(krok); else delete el.dataset.bezi;
        };
        requestAnimationFrame(krok);
      };
      document.addEventListener('pocitej', (e) => (e.target as HTMLElement).querySelectorAll<HTMLElement>('[data-pocitej]').forEach(pocitej));

      const prvky = document.querySelectorAll('.odhal, .odhal-graf, [data-pocitej]');
      if ('IntersectionObserver' in window) {
        const pozorovatel = new IntersectionObserver((zaznamy) => {
          for (const z of zaznamy) if (z.isIntersecting) {
            if ((z.target as HTMLElement).dataset.pocitej !== undefined) pocitej(z.target as HTMLElement);
            else z.target.classList.add('odhal--videt');
            pozorovatel.unobserve(z.target);
          }
        }, { rootMargin: '0px 0px -10% 0px' });
        prvky.forEach((p) => pozorovatel.observe(p));
      } else prvky.forEach((p) => p.classList.add('odhal--videt'));
    </script>
  </body>
</html>
