---
import geo from '../data/kraje.json';
import { vrstvy } from '../data/vrstvy';
import { hranice, barvaKraje } from '../lib/mapa';

const vrstva = vrstvy[0];
const hr = vrstva.typ === 'ciselna' ? hranice(Object.values(vrstva.hodnoty).map(Number)) : [];
const kraje = [...geo.kraje].sort((a, b) => Number(a.id === 'praha') - Number(b.id === 'praha'));
---

<svg viewBox={`0 0 ${geo.sirka} ${geo.vyska}`} class="mapa-nahled" role="img" aria-label={`Mapa krajů Česka: ${vrstva.nazev}`}>
  {kraje.map((k) => (
    <path d={k.d} fill={barvaKraje(vrstva, k.id, hr)} fill-rule="evenodd" stroke="#F2EDE3" stroke-width="2" stroke-linejoin="round" />
  ))}
</svg>

<style>
  .mapa-nahled { width: 100%; height: auto; display: block; }
</style>
