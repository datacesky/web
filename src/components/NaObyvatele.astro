---
// „Porovnej se" pro počty míst (prodejny): na kolik lidí připadá jedno místo a kolik by jich
// v průměru připadlo na tvou obec. Počet obyvatel: ČSÚ, k 31. 12. 2025 (stejná vrstva jako Mapa Česka).
import { vrstvy } from '../data/vrstvy';

interface Props {
  polozky: { nazev: string; hodnota: number }[];
  // tvary po číslovce: „prodejna“, „prodejny“, „prodejen“
  tvary: [string, string, string];
  // 4. pád: „na jednu prodejnu“
  naJednu: string;
}
const { polozky, tvary, naJednu } = Astro.props;
const v = vrstvy.find((x) => x.id === 'obyvatele')!;
const obyvatel = Object.values(v.hodnoty as Record<string, number>).reduce((s, x) => s + x, 0);
const fmt = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 0 });
// Hustota sítě: kolik prodejen připadá na 100 000 lidí (delší pruh = hustší síť)
const radky = [...polozky].map((p) => ({ ...p, naJednu: obyvatel / p.hodnota, hustota: (p.hodnota / obyvatel) * 100000 })).sort((a, b) => b.hustota - a.hustota);
const maxHustota = Math.max(...radky.map((r) => r.hustota));
const fmt1 = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const celkem = polozky.reduce((s, p) => s + p.hodnota, 0);
const data = JSON.stringify({ obyvatel, polozky, tvary });
---

<div class="no" data-no data-nastaveni={data}>
  <p class="no__uvod">Kolik {tvary[2]} připadá na 100 000 lidí</p>
  <ul class="no__radky">
    {radky.map((r) => (
      <li class="no__radek" title={`Jedna ${tvary[0]} na ${fmt.format(r.naJednu)} lidí`}>
        <span class="no__nazev">{r.nazev}</span>
        <span class="no__draha"><span class="no__pruh" style={`width: ${(r.hustota / maxHustota) * 100}%;`}></span></span>
        <span class="no__hodnota">{fmt1.format(r.hustota)}</span>
      </li>
    ))}
  </ul>
  <p class="drobne">Počítáno na {fmt.format(obyvatel)} obyvatel Česka ({v.zdroj}, {v.obdobi}). Třeba u {radky[0].nazev} připadá jedna {tvary[0]} na {fmt.format(radky[0].naJednu)} lidí.</p>

  <div class="no__obec">
    <label class="no__pole">
      <span class="no__popisek">Kolik lidí žije ve tvé obci?</span>
      <span class="no__vstup"><input type="text" inputmode="numeric" autocomplete="off" enterkeyhint="done" value="10 000" data-no-obec /> <span aria-hidden="true">lidí</span></span>
    </label>
    <p class="no__vysledek" aria-live="polite" data-no-vysledek></p>
  </div>
  <p class="drobne">Je to průměr za celé Česko. Ve skutečnosti jsou prodejny hlavně ve městech, takže na vesnici jich bývá méně a ve městě víc. Všechny sledované řetězce mají dohromady {fmt.format(celkem)} {tvary[2]}.</p>
</div>

<style>
  .no { display: flex; flex-direction: column; gap: 0.9rem; }
  .no__uvod { font-weight: 700; }
  .no__radky { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .no__radek { display: grid; grid-template-columns: minmax(70px, 110px) minmax(0, 1fr) 2.6rem; gap: 0.8rem; align-items: center; font-size: 0.92rem; font-weight: 800; }
  .no__nazev { text-align: right; }
  .no__draha { height: 12px; border-radius: 999px; background: var(--draha); overflow: hidden; }
  .no__pruh { display: block; height: 100%; border-radius: 999px; background: var(--navy); }
  .no__hodnota { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .no__obec { display: flex; flex-wrap: wrap; gap: 0.9rem 1.4rem; align-items: flex-end; padding: 1.1rem 1.2rem; margin-top: 0.4rem; border-radius: 18px; background: var(--navy); color: var(--cream); }
  .no__pole { display: flex; flex-direction: column; gap: 0.35rem; flex: 0 1 240px; min-width: 0; }
  .no__popisek { font-size: 0.92rem; font-weight: 800; }
  .no__vstup { display: flex; align-items: center; gap: 0.4rem; min-height: 48px; padding: 0 1rem; border-radius: 999px; background: var(--paper); color: var(--navy); font-weight: 800; }
  .no__vstup input { flex: 1 1 auto; min-width: 0; width: 100%; min-height: 44px; padding: 0; border: 0; background: transparent; outline: none; font-family: inherit; font-size: 1.05rem; font-weight: 800; color: var(--navy); }
  .no__vstup:focus-within { box-shadow: 0 0 0 3px var(--orange); }
  .no__vysledek { flex: 1 1 260px; min-width: 0; font-size: 1.02rem; font-weight: 700; line-height: 1.5; }
  :global(.no__vysledek strong) { color: var(--orange); font-weight: 900; }
  @media (max-width: 560px) {
    .no__radek { grid-template-columns: 70px minmax(0, 1fr) 2.4rem; gap: 0.5rem; font-size: 0.84rem; }
    .no__obec { padding: 1rem; }
    .no__pole { flex-basis: 100%; }
  }
</style>

<script>
  const fmt0 = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 0 });
  const fmt1 = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 1 });
  for (const koren of document.querySelectorAll<HTMLElement>('[data-no]')) {
    const N = JSON.parse(koren.dataset.nastaveni!) as { obyvatel: number; polozky: { nazev: string; hodnota: number }[]; tvary: [string, string, string] };
    const vstup = koren.querySelector<HTMLInputElement>('[data-no-obec]')!;
    const vysl = koren.querySelector<HTMLElement>('[data-no-vysledek]')!;
    const celkem = N.polozky.reduce((s, p) => s + p.hodnota, 0);
    const tvar = (n: number) => (!Number.isInteger(n) ? N.tvary[1] : n === 1 ? N.tvary[0] : n >= 2 && n <= 4 ? N.tvary[1] : N.tvary[2]);
    function prepocitej() {
      const lidi = Number(vstup.value.replace(/[^\d]/g, '')) || 0;
      if (lidi < 1) { vysl.textContent = 'Napiš počet obyvatel své obce.'; return; }
      const prumer = (lidi / N.obyvatel) * celkem;
      const n = prumer >= 10 ? Math.round(prumer) : Math.round(prumer * 10) / 10;
      const s = document.createElement('strong');
      s.textContent = `${n >= 10 ? fmt0.format(n) : fmt1.format(n)} ${tvar(n)}`;
      const nej = [...N.polozky].sort((a, b) => b.hodnota - a.hodnota)[0];
      const nNej = (lidi / N.obyvatel) * nej.hodnota;
      vysl.replaceChildren(
        `Kdyby byly prodejny rozmístěné podle počtu lidí, připadlo by na ${fmt0.format(lidi)} lidí `, s,
        ` všech sledovaných řetězců dohromady. Z toho ${nej.nazev}: ${nNej >= 10 ? fmt0.format(nNej) : fmt1.format(nNej)}.`,
      );
    }
    vstup.addEventListener('input', prepocitej);
    vstup.addEventListener('blur', () => { const n = Number(vstup.value.replace(/[^\d]/g, '')); if (n) vstup.value = fmt0.format(n); });
    prepocitej();
  }
</script>
