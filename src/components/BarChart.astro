---
import { barvaKategorie, cislo } from '../lib/format';

interface Polozka {
  nazev: string;
  hodnota: number;
  kategorie?: string;
}

interface Props {
  polozky: Polozka[];
  barvy?: Record<string, string>;
  velikost?: 'mala' | 'stredni';
  legenda?: boolean;
  desetinna?: number;
}

const { polozky, barvy = {}, velikost = 'stredni', legenda = false, desetinna } = Astro.props;
const max = Math.max(...polozky.map((p) => p.hodnota));
const sirkaHodnot = `calc(${Math.max(...polozky.map((p) => cislo(p.hodnota, desetinna).length))}ch + 0.3rem)`;
const kategorie = [...new Set(polozky.map((p) => p.kategorie).filter(Boolean))] as string[];
---

<div class:list={['sg', `sg--${velikost}`, 'odhal-graf']} style={`--sirka-hodnot: ${sirkaHodnot};`}>
  {legenda && kategorie.length > 1 && (
    <ul class="legenda">
      {kategorie.map((k) => (
        <li><span class="legenda__tecka" style={`background: ${barvaKategorie(k, barvy)};`}></span>{k}</li>
      ))}
    </ul>
  )}
  <ul class="sg__radky" aria-hidden="true">
    {polozky.map((p, i) => (
      <li class:list={['sg__radek', { 'sg__radek--cesko': p.kategorie === 'Česko' }]} style={`--i: ${i};`}>
        <span class="sg__jmeno">{p.nazev}</span>
        <span class="sg__draha">
          <span class="sg__pruh" style={`width: ${(p.hodnota / max) * 100}%; background: ${barvaKategorie(p.kategorie, barvy)};`}></span>
        </span>
        <span class="sg__hodnota">{cislo(p.hodnota, desetinna)}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .sg { display: flex; flex-direction: column; gap: 1rem; width: 100%; }
  .sg__radky { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .sg__radek { display: grid; align-items: center; }
  .sg__jmeno { text-align: right; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sg__radek--cesko .sg__jmeno, .sg__radek--cesko .sg__hodnota { color: var(--orange-text); font-weight: 900; }
  .sg__draha { display: block; background: var(--draha); border-radius: 999px; }
  .sg__pruh { display: block; border-radius: 999px; min-width: 6px; height: 100%; transform-origin: left center; }
  .sg__hodnota { font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .sg--stredni .sg__radky { gap: 0.75rem; }
  .sg--stredni .sg__radek { grid-template-columns: minmax(70px, 125px) minmax(0, 1fr) var(--sirka-hodnot); gap: 0.8rem; }
  .sg--stredni .sg__jmeno { font-size: 0.95rem; line-height: 1.5; }
  .sg--stredni .sg__draha { height: 24px; }
  .sg--stredni .sg__hodnota { font-size: 1rem; }

  .sg--mala .sg__radky { gap: 0.55rem; }
  .sg--mala .sg__radek { grid-template-columns: 84px minmax(0, 1fr) var(--sirka-hodnot); gap: 0.55rem; }
  .sg--mala .sg__jmeno { font-size: 0.78rem; line-height: 1.45; }
  .sg--mala .sg__draha { height: 13px; }
  .sg--mala .sg__hodnota { font-size: 0.78rem; }

  /* Pruhy pomalu vyrostou, až graf vjede do obrazu. Rostou ořezem, ne roztažením,
     takže zaoblený konec zůstává po celou dobu kulatý. */
  :global(.js) .odhal-graf .sg__pruh { clip-path: inset(0 100% 0 0 round 999px); }
  :global(.js) .odhal-graf .sg__hodnota { opacity: 0; transform: translateX(-6px); }
  :global(.js) .odhal-graf:global(.odhal--videt) .sg__pruh { clip-path: inset(0 0 0 0 round 999px); transition: clip-path 1.4s cubic-bezier(0.22, 0.8, 0.24, 1) calc(var(--i) * 90ms); }
  :global(.js) .odhal-graf:global(.odhal--videt) .sg__hodnota { opacity: 1; transform: none; transition: opacity 0.6s var(--ease-out) calc(var(--i) * 90ms + 0.7s), transform 0.6s var(--ease-out) calc(var(--i) * 90ms + 0.7s); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .odhal-graf .sg__pruh { clip-path: none; transition: none !important; }
    :global(.js) .odhal-graf .sg__hodnota { opacity: 1; transform: none; transition: none !important; }
  }
</style>
