---
// Hledání napříč webem: země, kraje, města, vrstvy mapy, žebříčky, grafy, novinky a díly sérií.
// Otevře se tlačítkem v hlavičce, zkratkou ⌘K / Ctrl+K nebo klávesou „/“.
// Rejstřík (/hledani.json) se stáhne až při prvním otevření.
---

<dialog class="hl" aria-label="Hledat na webu" data-hledani-okno>
  <div class="hl__panel">
    <div class="hl__pole">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M10 4a6 6 0 1 0 0 12a6 6 0 1 0 0-12 M20 20l-5.6-5.6" /></svg>
      <input type="search" enterkeyhint="go" autocomplete="off" spellcheck="false" placeholder="Země, kraj, město, žebříček…" aria-label="Hledat" aria-controls="hl-vysledky" aria-autocomplete="list" role="combobox" aria-expanded="true" />
      <button type="button" class="hl__zavrit" data-hledani-zavrit aria-label="Zavřít hledání"><span class="hl__esc">Esc</span><span class="hl__x" aria-hidden="true">Zavřít</span></button>
    </div>
    <div class="hl__telo">
      <p class="hl__nadpis" data-hledani-nadpis>Kam dál</p>
      <ul class="hl__seznam" id="hl-vysledky" role="listbox" aria-label="Výsledky hledání"></ul>
      <p class="hl__nic" data-hledani-nic hidden></p>
    </div>
    <div class="hl__napoveda" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> výběr</span>
      <span><kbd>Enter</kbd> otevřít</span>
      <span><kbd>Esc</kbd> zavřít</span>
    </div>
  </div>
</dialog>

<script>
  import { IKONY } from '../lib/ikony';

  type Radek = [string, string, string, string, string?, string?];
  type Polozka = { druh: string; nazev: string; popis: string; url: string; znak?: string; hn: string; hv: string; slova: string[] };

  // Ikony navíc k těm, co web už má (obrys 24×24, styl Tabler)
  const IK: Record<string, string> = {
    ...IKONY,
    blesk: 'M13 3L4 14h7l-1 7 9-11h-7z',
    mapa: 'M3 7l6-3 6 3 6-3v13l-6 3-6-3-6 3z M9 4v13 M15 7v13',
    serie: 'M4 6h16v12H4z M10 9.5v5l4.5-2.5z',
    kniha: 'M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6v13 M12 6v13 M21 6v13',
    kostka: 'M12 3l8 4.5v9L12 21l-8-4.5v-9z M12 12l8-4.5 M12 12v9 M12 12L4 7.5',
    hlas: 'M9 11l3 3 8-8 M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9',
    mesto: 'M3 21h18 M5 21V7l8-4v18 M19 21V11l-6-4 M9 9v.01 M9 12v.01 M9 15v.01 M9 18v.01',
    video: 'M4 6h16v12H4z M10 9.5v5l4.5-2.5z',
  };
  const DRUH: Record<string, string> = {
    stranka: 'Stránka', mapa: 'Mapa', kraj: 'Kraj', mesto: 'Město', zebricek: 'Žebříček',
    graf: 'Graf', novinka: 'Novinka', dil: 'Video', zeme: 'Země',
  };
  // Při stejné shodě má přednost to, co lidé hledají nejčastěji
  const VAHA: Record<string, number> = { stranka: 9, mapa: 7, kraj: 6, zeme: 5, zebricek: 5, mesto: 4, graf: 4, novinka: 3, dil: 2 };

  const okno = document.querySelector<HTMLDialogElement>('[data-hledani-okno]');
  if (okno) {
    const pole = okno.querySelector('input')!;
    const seznam = okno.querySelector<HTMLUListElement>('.hl__seznam')!;
    const nadpis = okno.querySelector<HTMLElement>('[data-hledani-nadpis]')!;
    const nic = okno.querySelector<HTMLElement>('[data-hledani-nic]')!;
    let data: Polozka[] | null = null;
    let nacitani: Promise<void> | null = null;
    let vybrany = 0;
    let odkazy: HTMLAnchorElement[] = [];

    // Bez háčků a čárek a malými písmeny: „cesko“ najde „Česko“
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    const nacti = () => {
      nacitani ??= fetch('/hledani.json')
        .then((r) => r.json())
        .then((radky: Radek[]) => {
          data = radky.map(([druh, nazev, popis, url, znak, navic]) => {
            const hn = norm(nazev);
            return { druh, nazev, popis, url, znak, hn, hv: norm(`${nazev} ${navic ?? ''} ${popis}`), slova: hn.split(/[\s\-–.,()/]+/).filter(Boolean) };
          });
        })
        .catch(() => { nacitani = null; });
      return nacitani;
    };

    const skore = (p: Polozka, d: string, tokeny: string[]) => {
      let s = 0;
      if (p.hn === d) s = 120;
      else if (p.hn.startsWith(d)) s = 100;
      else if (p.slova.some((w) => w.startsWith(d))) s = 75;
      else if (p.hn.includes(d)) s = 55;
      else if (tokeny.every((t) => p.hv.includes(t))) s = 30;
      if (!s) return 0;
      return s + VAHA[p.druh];
    };

    const zvyrazni = (text: string, d: string) => {
      const i = d ? norm(text).indexOf(d) : -1;
      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      if (i < 0) return esc(text);
      return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + d.length)) + '</mark>' + esc(text.slice(i + d.length));
    };

    const znak = (p: Polozka) => {
      if (p.znak && /^[a-z]{2}(-[a-z]+)?$/.test(p.znak)) return `<img class="hl__vlajka" src="/vlajky/${p.znak}.svg" alt="" loading="lazy" />`;
      const d = IK[p.znak ?? ''] ?? IK.graf;
      return `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="${d}" /></svg>`;
    };

    const vyber = (i: number, posunout = true) => {
      if (!odkazy.length) return;
      odkazy[vybrany]?.setAttribute('aria-selected', 'false');
      vybrany = (i + odkazy.length) % odkazy.length;
      const a = odkazy[vybrany];
      a.setAttribute('aria-selected', 'true');
      pole.setAttribute('aria-activedescendant', a.id);
      if (posunout) a.scrollIntoView({ block: 'nearest' });
    };

    const vykresli = () => {
      if (!data) return;
      const d = norm(pole.value.trim());
      const tokeny = d.split(/\s+/).filter(Boolean);
      let vysledky: Polozka[];
      if (!d) {
        // Bez dotazu: hlavní stránky a interaktivní mapy z videí
        const TIPY = ['/mapa/#v=vlaky', '/mapa/#cesko-3d', '/svet/#capi'];
        vysledky = data.filter((p) => p.druh === 'stranka' || TIPY.includes(p.url));
        nadpis.textContent = 'Kam dál';
      } else {
        vysledky = data.map((p) => ({ p, s: skore(p, d, tokeny) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s).slice(0, 40).map((x) => x.p);
        nadpis.textContent = vysledky.length ? `Výsledky (${vysledky.length})` : '';
      }
      nic.hidden = vysledky.length > 0;
      if (!vysledky.length) nic.textContent = `Pro „${pole.value.trim()}“ jsme nic nenašli. Zkus název země, kraje nebo města.`;
      seznam.innerHTML = vysledky.map((p, i) => {
        const venku = /^https?:/.test(p.url);
        return `<li role="none"><a role="option" id="hl-v${i}" aria-selected="false" class="hl__radek" href="${p.url}"${venku ? ' target="_blank" rel="noopener"' : ''}>
          <span class="hl__znak">${znak(p)}</span>
          <span class="hl__text"><strong>${zvyrazni(p.nazev, d)}</strong><small>${zvyrazni(p.popis, '')}</small></span>
          <span class="hl__druh">${DRUH[p.druh] ?? ''}${venku ? ' ↗' : ''}</span>
        </a></li>`;
      }).join('');
      odkazy = Array.from(seznam.querySelectorAll('a'));
      vybrany = 0;
      seznam.scrollTop = 0;
      if (odkazy.length) vyber(0, false); else pole.removeAttribute('aria-activedescendant');
    };

    const otevri = async () => {
      if (okno.open) return;
      okno.showModal();
      document.documentElement.classList.add('hl-otevreno');
      pole.value = '';
      pole.focus();
      if (!data) { nadpis.textContent = 'Načítám…'; seznam.innerHTML = ''; await nacti(); }
      vykresli();
    };
    const zavri = () => { if (okno.open) okno.close(); };
    okno.addEventListener('close', () => document.documentElement.classList.remove('hl-otevreno'));

    // Odkaz na stejnou stránku jen s jiným #nastavením: stránka si ho čte při načtení, tak ji obnovíme
    seznam.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a || a.target === '_blank' || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const cil = new URL(a.href);
      zavri();
      if (cil.pathname === location.pathname && cil.hash.includes('=')) {
        e.preventDefault();
        location.hash = cil.hash;
        location.reload();
      }
    });

    pole.addEventListener('input', () => { if (data) vykresli(); });
    pole.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); vyber(vybrany + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); vyber(vybrany - 1); }
      else if (e.key === 'Enter' && odkazy[vybrany]) { e.preventDefault(); odkazy[vybrany].click(); }
    });
    seznam.addEventListener('mousemove', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      const i = a ? odkazy.indexOf(a as HTMLAnchorElement) : -1;
      if (i >= 0 && i !== vybrany) vyber(i, false);
    });

    // Klik vedle panelu zavře
    okno.addEventListener('click', (e) => { if (e.target === okno) zavri(); });
    okno.querySelector('[data-hledani-zavrit]')!.addEventListener('click', zavri);

    for (const b of document.querySelectorAll('[data-hledat]')) {
      b.addEventListener('click', otevri);
      // Rejstřík začneme stahovat, už když na tlačítko najede myš
      b.addEventListener('pointerenter', () => nacti(), { once: true });
    }
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      const piseSe = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); okno.open ? zavri() : otevri(); }
      else if (e.key === '/' && !piseSe && !okno.open) { e.preventDefault(); otevri(); }
    });

    // Na Macu ukážeme ⌘K, jinde Ctrl K
    if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
      for (const k of document.querySelectorAll('[data-zkratka]')) k.textContent = 'Ctrl K';
    }
  }
</script>

<style>
  .hl {
    width: min(640px, calc(100% - 2rem)); max-width: none; max-height: none; margin: 10vh auto auto; padding: 0;
    border: 0; background: transparent; color: var(--navy); overflow: visible;
  }
  .hl::backdrop { background: rgba(27, 42, 74, 0.38); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .hl[open] { animation: hl-vjezd 0.26s var(--ease-out); }
  .hl[open]::backdrop { animation: hl-zatmeni 0.26s ease; }
  @keyframes hl-vjezd { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }
  @keyframes hl-zatmeni { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hl[open], .hl[open]::backdrop { animation: none; } }
  .hl__panel {
    display: flex; flex-direction: column; max-height: min(620px, 78vh); overflow: hidden;
    background: var(--paper); border: 1px solid var(--line); border-radius: 22px;
    box-shadow: 0 2px 4px rgba(27, 42, 74, 0.06), 0 30px 70px -20px rgba(27, 42, 74, 0.5);
  }
  .hl__pole { display: flex; align-items: center; gap: 0.75rem; padding: 0.55rem 0.75rem 0.55rem 1.15rem; border-bottom: 1px solid var(--line); }
  .hl__pole svg { color: var(--orange); flex-shrink: 0; }
  .hl__pole input {
    flex: 1 1 auto; min-width: 0; min-height: 48px; padding: 0; border: 0; background: transparent; outline: none;
    font-family: inherit; font-size: 1.1rem; font-weight: 700; color: var(--navy);
  }
  .hl__pole input::placeholder { color: #8A93A6; font-weight: 600; }
  .hl__pole input::-webkit-search-cancel-button { display: none; }
  .hl__zavrit {
    flex-shrink: 0; min-height: 32px; padding: 0 0.6rem; border: 1px solid var(--line); border-radius: 9px; background: var(--plocha-2);
    color: var(--muted); font-family: inherit; font-size: 0.75rem; font-weight: 800; cursor: pointer;
  }
  .hl__x { display: none; }
  .hl__telo { overflow-y: auto; overscroll-behavior: contain; padding: 0.5rem 0.5rem 0.6rem; }
  .hl__nadpis { padding: 0.45rem 0.75rem 0.35rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .hl__nadpis:empty { display: none; }
  .hl__seznam { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .hl__nic { padding: 1.4rem 0.9rem; font-size: 0.92rem; font-weight: 600; color: var(--muted); text-align: center; }
  :global(.hl__radek) {
    display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; align-items: center; gap: 0.8rem;
    padding: 0.5rem 0.7rem; border-radius: 13px; color: var(--navy); text-decoration: none; scroll-margin: 0.5rem;
  }
  :global(.hl__radek[aria-selected='true']) { background: var(--plocha-2); box-shadow: inset 0 0 0 1px var(--line); }
  :global(.hl__radek:hover) { color: var(--navy); }
  :global(.hl__radek:active) { background: var(--draha); }
  :global(.hl__znak) { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: #FBF1E6; color: var(--orange-text); }
  :global(.hl__vlajka) { width: 26px; height: 19.5px; border-radius: 3px; object-fit: cover; box-shadow: 0 0 0 1px rgba(27, 42, 74, 0.14); }
  :global(.hl__text) { display: flex; flex-direction: column; min-width: 0; line-height: 1.35; }
  :global(.hl__text strong) { font-size: 0.97rem; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.hl__text small) { font-size: 0.78rem; font-weight: 600; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.hl__text mark) { background: rgba(240, 136, 41, 0.22); color: inherit; border-radius: 3px; padding: 0 1px; }
  :global(.hl__druh) { font-size: 0.72rem; font-weight: 800; color: var(--slate); white-space: nowrap; }
  .hl__napoveda { display: flex; gap: 1.1rem; padding: 0.6rem 1.15rem; border-top: 1px solid var(--line); background: var(--plocha-2); font-size: 0.75rem; font-weight: 700; color: var(--muted); }
  .hl__napoveda span { display: inline-flex; align-items: center; gap: 0.3rem; }
  kbd {
    display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 0.3rem; border: 1px solid var(--line-2); border-bottom-width: 2px;
    border-radius: 5px; background: var(--paper); font-family: inherit; font-size: 0.68rem; font-weight: 800; color: var(--navy);
  }
  /* Telefon: panel přes celou šířku nahoře, výsledky až k dolnímu okraji */
  @media (max-width: 700px) {
    .hl { width: calc(100% - 1rem); margin: 0.5rem auto auto; }
    .hl__panel { max-height: calc(100dvh - 1rem); border-radius: 20px; }
    .hl__pole { padding-left: 0.95rem; }
    .hl__pole input { font-size: 16px; }
    .hl__esc { display: none; }
    .hl__x { display: inline; }
    .hl__zavrit { min-height: 36px; padding: 0 0.75rem; font-size: 0.82rem; color: var(--navy); }
    .hl__napoveda { display: none; }
    :global(.hl__radek) { padding: 0.6rem 0.6rem; }
  }
  :global(html.hl-otevreno) { overflow: hidden; }
</style>
