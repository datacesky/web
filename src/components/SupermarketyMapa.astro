---
// Mapa supermarketů ve stylu Google Maps: mapa přes celou obrazovku, nahoře hledání a filtry (řetězce, otevřeno teď,
// oblíbené), vlevo (na mobilu zespodu) panel s nejbližšími prodejnami nebo s kartou vybrané prodejny.
// Prodejny: public/data/obchody.json (skripty/data_obchody.py z OpenStreetMap), obce: public/data/obce.json.
// Vzdálenost, čas a čára trasy po silnici přes Mapy.com, když je v src/data/web.ts adresa Workeru „trasy“
// (navody/trasy/), jinak vzdušnou čarou. Podklad: OpenFreeMap (src/lib/mapa-styl.ts).
// V prohlížeči si mapa pamatuje oblíbené prodejny (sm-oblibene) a poslední pohled (sm-pohled), nic se neposílá ven.
import { web } from '../data/web';
import { logo } from '../lib/loga';
import { datum, cislo } from '../lib/format';
import { nactiObchody, BARVY_RETEZCU as BARVY } from '../lib/obchody';

const data = nactiObchody();
const celkem = data.body.length;
const loga = Object.fromEntries(data.retezce.map((r) => [r.id, logo(r.nazev)]));

const nastaveni = JSON.stringify({
  retezce: data.retezce, formaty: data.formaty, barvy: BARVY, trasy: web.trasy,
  loga: Object.fromEntries(Object.entries(loga).map(([id, l]) => [id, l ? { src: l.src, tmave: l.tmave, pomer: l.pomer } : null])),
});
const IKONA_JA = 'M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8z M12 2v3 M12 19v3 M2 12h3 M19 12h3';
---

<section class="sm" id="mapa-prodejen" data-sm data-stav="uvod" data-nastaveni={nastaveni}>
  <div class="sm__mapa" data-sm-mapa role="application" aria-label="Mapa supermarketů v Česku"></div>

  <!-- Nahoře: hledání a filtry jako v Google Maps -->
  <div class="sm__horni" data-sm-horni>
    <div class="sm__hledani">
      <a class="sm__domu" href="/" aria-label="Zpět na datacesky.cz" title="Zpět na datacesky.cz">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
      </a>
      <svg class="sm__lupa" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M10 4a6 6 0 1 0 0 12a6 6 0 1 0 0-12 M20 20l-5.6-5.6" /></svg>
      <input
        type="text" inputmode="search" enterkeyhint="search" autocomplete="off" spellcheck="false"
        class="sm__pole" placeholder="Hledat obec, město nebo řetězec" aria-label="Hledat obec nebo řetězec"
        role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sm-naseptavac" data-sm-hledat
      />
      <button type="button" class="sm__smazat" data-sm-smazat aria-label="Smazat hledání" hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <ul class="sm__naseptavac" id="sm-naseptavac" role="listbox" aria-label="Návrhy" data-sm-naseptavac hidden></ul>
    </div>
    <div class="sm__cipy" role="group" aria-label="Filtr prodejen">
      <button type="button" class="sm__cip" data-sm-oblibene aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 20s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.4a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z" /></svg>
        Oblíbené
      </button>
      <button type="button" class="sm__cip" data-sm-otevreno aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
        Otevřeno teď
      </button>
      {data.retezce.map((r) => (
        <button type="button" class="sm__cip sm__cip--retezec" data-r={r.id} aria-pressed="false" aria-label={`Jen ${r.nazev}`} title={`${r.nazev}: ${r.pocet} prodejen na mapě`} style={`--barva: ${BARVY[r.id]};`}>
          <span class:list={['sm__logo', 'sm__logo--cip', { 'sm__logo--tmave': loga[r.id]?.tmave }]}>
            {loga[r.id] ? <img src={loga[r.id]!.src} alt="" width="40" height="20" /> : r.nazev}
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- Nástroje na počítači: celá obrazovka nahoře, moje poloha dole nad přiblížením -->
  <button type="button" class="sm__nastroj sm__cela" data-sm-cela aria-pressed="false" aria-label="Mapa na celou obrazovku" title="Na celou obrazovku">
    <svg class="sm__ikona-zvetsit" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
    <svg class="sm__ikona-zmensit" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
  </button>
  <button type="button" class="sm__nastroj sm__ja sm__ja--pc" data-sm-ja aria-label="Moje poloha" title="Moje poloha">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d={IKONA_JA} /></svg>
  </button>

  <aside class="sm__panel" data-sm-panel data-vyska="nizko" aria-label="Supermarkety">
    <!-- moje poloha na mobilu: jezdí nad panelem -->
    <button type="button" class="sm__nastroj sm__ja sm__ja--mobil" data-sm-ja aria-label="Moje poloha">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d={IKONA_JA} /></svg>
    </button>
    <div class="sm__karta">
      <button type="button" class="sm__uchyt" data-sm-uchyt aria-label="Rozbalit nebo sbalit panel"><span></span></button>
      <div class="sm__obsah" data-sm-obsah>
        <header class="sm__hlava">
          <h1 class="sm__titul">Supermarkety v Česku</h1>
          <p class="sm__fakt">
            <strong>{cislo(celkem)} prodejen</strong> Penny, Albertu, Lidlu, Billy, Tesca, Kauflandu a Globusu s otevírací dobou.
          </p>
          <button type="button" class="tlacitko tlacitko--oranzovy tlacitko--plna-sirka sm__najdi" data-sm-poloha>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <span>Nejbližší ke mně</span>
          </button>
        </header>

        <div class="sm__vysledky" data-sm-vysledky aria-live="polite"></div>

        <p class="sm__pata drobne">
          Prodejny: © přispěvatelé <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, stav {datum(new Date(data.stav))}.
          <a href="#supermarkety-v-cislech">Kolik jich je a metodika</a>
        </p>
      </div>
    </div>
  </aside>

  <a href="#supermarkety-v-cislech" class="sm__dolu" aria-label="Kolik supermarketů je v Česku, přehled pod mapou">
    <span>Kolik jich je</span>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
  </a>
  <div class="sm__oznameni" data-sm-oznameni role="status" aria-live="polite" hidden></div>
</section>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { stylMapy, prebarvi, PODKLAD } from '../lib/mapa-styl';
  import { nactiDobu, radkyDoby, stavTed } from '../lib/oteviraci';

  type Retezec = { id: string; nazev: string; pocet: number };
  type Logo = { src: string; tmave: boolean; pomer: number } | null;
  type N = { retezce: Retezec[]; formaty: string[]; barvy: Record<string, string>; trasy: string; loga: Record<string, Logo> };
  // [lon, lat, řetězec, formát, adresa, obec, otevírací doba, id v OSM]
  type Bod = [number, number, number, number, string, string, string, string];
  type Obec = [string, number, number, number, number, string]; // název, lon, lat, typ, kraj, u
  type Cas = { m: number; s: number } | null;
  type Rezim = 'pesky' | 'autem';

  const koren = document.querySelector<HTMLElement>('[data-sm]');
  if (koren) spust(koren);

  function spust(el: HTMLElement) {
    const N: N = JSON.parse(el.dataset.nastaveni!);
    const $ = <T extends Element = HTMLElement>(s: string) => el.querySelector<T>(s)!;
    const mapaEl = $('[data-sm-mapa]'), panel = $('[data-sm-panel]'), obsah = $('[data-sm-obsah]'), vysledkyEl = $('[data-sm-vysledky]');
    const horni = $('[data-sm-horni]'), oznameni = $('[data-sm-oznameni]');
    const pole = $<HTMLInputElement>('[data-sm-hledat]'), naseptavac = $<HTMLUListElement>('[data-sm-naseptavac]'), smazat = $('[data-sm-smazat]');
    const ids = N.retezce.map((r) => r.id);
    const tmavy = () => document.documentElement.dataset.tema === 'tmavy';
    const mobil = matchMedia('(max-width: 760px)');
    const fmt = new Intl.NumberFormat('cs-CZ');
    const MODRA = '#1A73E8';

    let body: Bod[] = [];
    let obce: Obec[] | null = null, nazvyKraju: string[] = [];
    // Filtry: prázdná množina řetězců = všechny
    let vybrane = new Set<string>();
    let jenOtevrene = false, jenOblibene = false;
    let otevreneTed = new Set<number>();
    // Výchozí bod seznamu: poloha člověka nebo hledaná obec
    let ref: { lon: number; lat: number; typ: 'poloha' | 'obec'; nazev: string; dosah: number } | null = null;
    // Poslední známá poloha (modrá tečka), i když seznam ukazuje obec
    let poloha: { lon: number; lat: number; presnost: number } | null = null;
    let seznam: number[] = [], kolikUkazat = 12, vybrana = -1;
    let rezim: Rezim = 'autem';
    const casy = new Map<string, Cas>();
    let cekaCasy = false, chybaCasu = false;
    // Nakreslená trasa k vybrané prodejně
    let trasa: { i: number; rezim: Rezim; m: number; s: number; vzduchem: boolean } | null = null;
    let cekaTrasa = false, nabidkaNavigace = false;

    // ---------- pomocné ----------
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const bezDiakritiky = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    function metru(a: [number, number], b: [number, number]) {
      const r = Math.PI / 180, dLat = (b[1] - a[1]) * r, dLon = (b[0] - a[0]) * r;
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(a[1] * r) * Math.cos(b[1] * r) * Math.sin(dLon / 2) ** 2;
      return 12742000 * Math.asin(Math.sqrt(h));
    }
    const vzdalenost = (m: number) => (m < 950 ? `${Math.max(10, Math.round(m / 10) * 10)} m` : m < 9950 ? `${(m / 1000).toFixed(1).replace('.', ',')} km` : `${fmt.format(Math.round(m / 1000))} km`);
    const doba = (s: number) => { const min = Math.max(1, Math.round(s / 60)); return min < 60 ? `${min} min` : `${Math.floor(min / 60)} h ${min % 60} min`; };
    const nazevProdejny = (b: Bod) => (b[3] >= 0 ? N.formaty[b[3]] : N.retezce[b[2]].nazev);
    const adresa = (b: Bod) => [b[4], b[5]].filter(Boolean).join(', ');
    const vzduchem = (i: number) => (ref ? metru([ref.lon, ref.lat], [body[i][0], body[i][1]]) : 0);
    const odMe = (i: number) => (poloha ? metru([poloha.lon, poloha.lat], [body[i][0], body[i][1]]) : 0);
    const klicCasu = (i: number, r = rezim) => `${r}|${poloha?.lon.toFixed(4)},${poloha?.lat.toFixed(4)}|${body[i][7]}`;
    // Čas po silnici: jen když vycházíme z polohy (u obce se počítá od středu, tam stačí vzdušná čára)
    const cas = (i: number) => (poloha ? casy.get(klicCasu(i)) : undefined);
    const ulozeno = <T,>(klic: string, vychozi: T): T => { try { const v = localStorage.getItem(klic); return v ? JSON.parse(v) : vychozi; } catch { return vychozi; } };
    const uloz = (klic: string, v: unknown) => { try { localStorage.setItem(klic, JSON.stringify(v)); } catch {} };
    let casOznameni = 0;
    function oznam(text: string) {
      oznameni.textContent = text; oznameni.hidden = false;
      clearTimeout(casOznameni); casOznameni = window.setTimeout(() => (oznameni.hidden = true), 2600);
    }
    function logoHtml(r: number, velke = false) {
      const id = ids[r], l = N.loga[id];
      return `<span class="sm__logo${l?.tmave ? ' sm__logo--tmave' : ''}${velke ? ' sm__logo--velke' : ''}" style="--barva:${N.barvy[id]}">${l ? `<img src="${l.src}" alt="" />` : esc(N.retezce[r].nazev)}</span>`;
    }

    // ---------- oblíbené (jen v tomto prohlížeči) ----------
    const oblibene = new Set<string>(ulozeno<string[]>('sm-oblibene', []));
    const jeOblibena = (i: number) => oblibene.has(body[i][7]);

    // ---------- mapa ----------
    // Začátek: poslední pohled z tohoto prohlížeče, napoprvé Praha zblízka. Kdo už polohu povolil, toho mapa po načtení přiblíží k němu.
    const pohled = ulozeno<{ c: [number, number]; z: number } | null>('sm-pohled', null);
    const platnyPohled = pohled && Array.isArray(pohled.c) && pohled.c[0] > 11.5 && pohled.c[0] < 19.5 && pohled.c[1] > 48 && pohled.c[1] < 51.5 && pohled.z >= 6 && pohled.z <= 18.5;
    let bezPodkladu = false;
    function ukazObrysKraju() {
      if (map.getSource('kraje')) return;
      map.addSource('kraje', { type: 'geojson', data: '/data/kraje-obrys.json' });
      map.addLayer({ id: 'kraje-zaloha', type: 'line', source: 'kraje', paint: { 'line-color': '#B9AE9B', 'line-width': 1 } }, map.getLayer('ref-dosah') ? 'ref-dosah' : undefined);
    }
    const map = new maplibregl.Map({
      container: mapaEl, style: stylMapy(tmavy()),
      center: platnyPohled ? pohled!.c : [14.4378, 50.0755], zoom: platnyPohled ? pohled!.z : mobil.matches ? 12.4 : 12.8,
      minZoom: 5.5, maxZoom: 18.5, dragRotate: false, pitchWithRotate: false, touchPitch: false,
      attributionControl: false,
      locale: { 'NavigationControl.ZoomIn': 'Přiblížit', 'NavigationControl.ZoomOut': 'Oddálit', 'AttributionControl.ToggleAttribution': 'Zdroje mapy' },
    });
    map.touchZoomRotate.disableRotation();
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');
    map.addControl(new maplibregl.AttributionControl({ compact: true, customAttribution: '<a href="https://openfreemap.org">OpenFreeMap</a>' }), 'top-right');

    // Odsazení mapy: nahoře hledání, vlevo panel (počítač), dole panel (mobil, podle vysunutí)
    const NIZKO = 172;
    function odsazeni(vyska = panel.dataset.vyska) {
      const top = horni.offsetTop + horni.offsetHeight + 8;
      if (!mobil.matches) return { top: el.dataset.stav === 'uvod' ? top : 16, right: 64, bottom: 16, left: panel.offsetWidth + 30 };
      const H = el.clientHeight;
      return { top, right: 0, left: 0, bottom: vyska === 'nizko' ? NIZKO : H * 0.5 };
    }

    // Odznaky s logy: bílá pilulka s barevným okrajem a špičkou dole, logo uvnitř
    async function odznak(id: string, l: Logo): Promise<ImageData> {
      const dpr = 2, barva = N.barvy[id], pomer = l?.pomer ?? 2;
      const vyska = 30, logoV = pomer > 1.4 ? 15 : 22, logoS = Math.min(logoV * pomer, 58);
      const sirka = Math.max(vyska, logoS + (pomer > 1.4 ? 14 : 8)), spicka = 6, okraj = 4;
      const c = document.createElement('canvas');
      c.width = (sirka + okraj * 2) * dpr; c.height = (vyska + spicka + okraj * 2) * dpr;
      const g = c.getContext('2d')!;
      g.scale(dpr, dpr); g.translate(okraj, okraj);
      const tvar = () => {
        g.beginPath();
        const r = 9;
        g.moveTo(r, 0); g.lineTo(sirka - r, 0); g.arcTo(sirka, 0, sirka, r, r); g.lineTo(sirka, vyska - r); g.arcTo(sirka, vyska, sirka - r, vyska, r);
        g.lineTo(sirka / 2 + spicka, vyska); g.lineTo(sirka / 2, vyska + spicka); g.lineTo(sirka / 2 - spicka, vyska);
        g.lineTo(r, vyska); g.arcTo(0, vyska, 0, vyska - r, r); g.lineTo(0, r); g.arcTo(0, 0, r, 0, r); g.closePath();
      };
      g.shadowColor = 'rgba(27, 42, 74, 0.35)'; g.shadowBlur = 4; g.shadowOffsetY = 1;
      tvar(); g.fillStyle = l?.tmave ? '#1B2A4A' : '#FFFFFF'; g.fill();
      g.shadowColor = 'transparent'; g.lineWidth = 2; g.strokeStyle = barva; g.stroke();
      if (l) {
        const img = new Image();
        img.src = l.src;
        await img.decode().catch(() => {});
        g.drawImage(img, (sirka - logoS) / 2, (vyska - logoV) / 2, logoS, logoV);
      }
      return g.getImageData(0, 0, c.width, c.height);
    }
    // Srdíčko u oblíbených prodejen
    function srdce(): ImageData {
      const dpr = 2, s = 18, c = document.createElement('canvas');
      c.width = c.height = s * dpr;
      const g = c.getContext('2d')!;
      g.scale(dpr, dpr);
      g.beginPath(); g.arc(s / 2, s / 2, s / 2 - 1, 0, Math.PI * 2); g.fillStyle = '#FFFFFF'; g.fill();
      g.lineWidth = 1.5; g.strokeStyle = 'rgba(27, 42, 74, 0.25)'; g.stroke();
      g.translate(s / 2, s / 2 + 0.5); g.scale(0.62, 0.62);
      g.beginPath(); g.moveTo(0, 6); g.bezierCurveTo(-9, 0, -8, -8, -3.5, -8); g.bezierCurveTo(-1.5, -8, 0, -6.5, 0, -5);
      g.bezierCurveTo(0, -6.5, 1.5, -8, 3.5, -8); g.bezierCurveTo(8, -8, 9, 0, 0, 6); g.closePath();
      g.fillStyle = '#E5484D'; g.fill();
      return g.getImageData(0, 0, c.width, c.height);
    }

    const prazdne = { type: 'FeatureCollection', features: [] } as any;
    function vrstvyObchodu() {
      const p = PODKLAD(tmavy());
      for (const z of ['obchody', 'vybrana', 'ref', 'presnost', 'trasa']) if (!map.getSource(z)) map.addSource(z, { type: 'geojson', data: prazdne });
      if (bezPodkladu) ukazObrysKraju();
      map.addLayer({ id: 'presnost', type: 'fill', source: 'presnost', paint: { 'fill-color': MODRA, 'fill-opacity': 0.12 } });
      map.addLayer({ id: 'presnost-okraj', type: 'line', source: 'presnost', paint: { 'line-color': MODRA, 'line-opacity': 0.35, 'line-width': 1 } });
      map.addLayer({ id: 'trasa-obrys', type: 'line', source: 'trasa', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': '#FFFFFF', 'line-width': ['interpolate', ['linear'], ['zoom'], 10, 6, 16, 11] } });
      map.addLayer({ id: 'trasa', type: 'line', source: 'trasa', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': MODRA, 'line-width': ['interpolate', ['linear'], ['zoom'], 10, 3.5, 16, 6.5] } });
      map.addLayer({ id: 'ref-dosah', type: 'circle', source: 'ref', paint: { 'circle-radius': 10, 'circle-color': 'rgba(27, 42, 74, 0.12)', 'circle-stroke-color': p.text, 'circle-stroke-width': 2 } });
      map.addLayer({ id: 'obchody-tecky', type: 'circle', source: 'obchody', paint: {
        'circle-color': barvaRetezce,
        'circle-radius': ['interpolate', ['linear'], ['zoom'], 5, 1.8, 8, 3, 11, 4.5, 15, 6],
        'circle-stroke-color': p.pozadi, 'circle-stroke-width': ['interpolate', ['linear'], ['zoom'], 5, 0.4, 10, 1.2],
      } });
      map.addLayer({ id: 'vybrana-kruh', type: 'circle', source: 'vybrana', paint: { 'circle-radius': 22, 'circle-color': 'rgba(240, 136, 41, 0.22)', 'circle-stroke-color': '#F08829', 'circle-stroke-width': 2 } });
      map.addLayer({ id: 'obchody-loga', type: 'symbol', source: 'obchody', minzoom: 9.5, layout: {
        'icon-image': ['concat', 'odznak-', ['get', 'id']] as any, 'icon-anchor': 'bottom',
        'icon-size': ['interpolate', ['linear'], ['zoom'], 9.5, 0.82, 12, 0.92, 14, 1] as any, 'icon-padding': 0,
      } });
      map.addLayer({ id: 'obchody-srdce', type: 'symbol', source: 'obchody', minzoom: 9.5, filter: ['==', ['get', 'f'], 1], layout: {
        'icon-image': 'srdce', 'icon-anchor': 'bottom-left', 'icon-offset': [10, -30], 'icon-allow-overlap': true, 'icon-ignore-placement': true,
      } });
      map.addLayer({ id: 'vybrana-logo', type: 'symbol', source: 'vybrana', layout: { 'icon-image': ['concat', 'odznak-', ['get', 'id']] as any, 'icon-anchor': 'bottom', 'icon-size': 1.3, 'icon-allow-overlap': true, 'icon-ignore-placement': true } });
    }
    const barvaRetezce = ['match', ['get', 'r'], ...ids.flatMap((id, i) => [i, N.barvy[id]]), '#1B2A4A'] as any;

    const nacteni = Promise.all(N.retezce.map(async (r) => [r.id, await odznak(r.id, N.loga[r.id])] as const));
    // Prodejny se stahují hned, souběžně s podkladem mapy
    const nacteniProdejen = fetch('/data/obchody.json').then((r) => r.json());

    // Vrstvy s prodejnami se přidají hned po načtení stylu, nečeká se na dlaždice podkladu
    // (když server s podkladem nejde, prodejny jsou na mapě aspoň s obrysem krajů)
    map.once('style.load', async () => {
      for (const [id, obr] of await nacteni) if (!map.hasImage(`odznak-${id}`)) map.addImage(`odznak-${id}`, obr, { pixelRatio: 2 });
      if (!map.hasImage('srdce')) map.addImage('srdce', srdce(), { pixelRatio: 2 });
      vrstvyObchodu();
      body = (await nacteniProdejen).body;
      aktualizujProdejny();
      el.classList.add('je-nacteno');
      // na mobilu zdroje mapy jen jako ikonka „i“, ať nezabírají místo
      if (mobil.matches) mapaEl.querySelector('.maplibregl-ctrl-attrib')?.classList.remove('maplibregl-compact-show');
      map.setPadding(odsazeni());
      vykresli();
      const m = /prodejna=([nwr]\d+)/.exec(location.hash);
      if (m) { const i = body.findIndex((b) => b[7] === m[1]); if (i >= 0) vyber(i, true); }
      else if (!(await zHashe())) {
        // Kdo už polohu dřív povolil, toho rovnou ukážeme u něj (bez dotazu prohlížeče)
        try {
          const s = await navigator.permissions?.query({ name: 'geolocation' as PermissionName });
          if (s?.state === 'granted') najdiPolohu();
        } catch {}
      }
      window.addEventListener('hashchange', () => zHashe());
    });

    // Poslední pohled si pamatuje prohlížeč, příště mapa začne tam
    let casPohledu = 0;
    map.on('moveend', () => {
      clearTimeout(casPohledu);
      casPohledu = window.setTimeout(() => { const c = map.getCenter(); uloz('sm-pohled', { c: [+c.lng.toFixed(5), +c.lat.toFixed(5)], z: +map.getZoom().toFixed(2) }); }, 500);
    });

    // Odkaz z úvodní stránky: #obec=Brno (i=pořadí v obce.json, když je víc obcí stejného jména) nebo #poloha
    async function zHashe() {
      const h = new URLSearchParams(location.hash.slice(1));
      if (h.has('poloha')) { najdiPolohu(); return true; }
      const nazev = h.get('obec')?.trim();
      if (!nazev) return false;
      await nactiObce();
      const i = Number(h.get('i'));
      const q = bezDiakritiky(nazev);
      const o = (Number.isInteger(i) && obce![i] && bezDiakritiky(obce![i][0]) === q ? obce![i] : null)
        ?? obce!.filter((x) => bezDiakritiky(x[0]) === q).sort((a, b) => a[3] - b[3])[0]
        ?? obce!.filter((x) => bezDiakritiky(x[0]).startsWith(q)).sort((a, b) => a[3] - b[3])[0];
      if (o) vyberObec(o);
      else { pole.value = nazev; smazat.hidden = false; hlaska(`Obec „${nazev}“ neznám. Zkus napsat jiný název, nebo si nech najít nejbližší prodejny podle polohy.`); }
      return true;
    }

    map.on('error', (e: any) => {
      if (bezPodkladu || e?.sourceId !== 'openmaptiles') return;
      bezPodkladu = true;
      if (map.getSource('obchody')) ukazObrysKraju();
    });

    for (const vrstva of ['obchody-tecky', 'obchody-loga', 'vybrana-logo']) {
      map.on('click', vrstva, (e) => { const f = e.features?.[0]; if (f) vyber(Number(f.properties!.i)); });
      map.on('mouseenter', vrstva, () => (map.getCanvas().style.cursor = 'pointer'));
      map.on('mouseleave', vrstva, () => (map.getCanvas().style.cursor = ''));
    }

    document.addEventListener('tema', () => {
      prebarvi(map, tmavy());
      const p = PODKLAD(tmavy());
      if (map.getLayer('obchody-tecky')) map.setPaintProperty('obchody-tecky', 'circle-stroke-color', p.pozadi);
      if (map.getLayer('ref-dosah')) map.setPaintProperty('ref-dosah', 'circle-stroke-color', p.text);
      if (map.getLayer('trasa-obrys')) map.setPaintProperty('trasa-obrys', 'line-color', tmavy() ? '#0E1628' : '#FFFFFF');
    });

    // Prodejny na mapě podle filtrů (řetězce, otevřeno teď, oblíbené)
    const projde = (i: number) => {
      const b = body[i];
      return (!vybrane.size || vybrane.has(ids[b[2]])) && (!jenOtevrene || otevreneTed.has(i)) && (!jenOblibene || oblibene.has(b[7]));
    };
    function aktualizujProdejny() {
      const f = [];
      for (let i = 0; i < body.length; i++) {
        if (!projde(i)) continue;
        const b = body[i];
        f.push({ type: 'Feature', id: i, properties: { i, r: b[2], id: ids[b[2]], f: oblibene.has(b[7]) ? 1 : 0 }, geometry: { type: 'Point', coordinates: [b[0], b[1]] } });
      }
      (map.getSource('obchody') as maplibregl.GeoJSONSource | undefined)?.setData({ type: 'FeatureCollection', features: f } as any);
    }

    function nastavRef(r: typeof ref) {
      ref = r;
      // Bod na mapě jen u obce, poloha má modrou tečku
      (map.getSource('ref') as maplibregl.GeoJSONSource | undefined)?.setData({
        type: 'FeatureCollection',
        features: r?.typ === 'obec' ? [{ type: 'Feature', properties: {}, geometry: { type: 'Point', coordinates: [r.lon, r.lat] } }] : [],
      } as any);
    }

    // ---------- moje poloha: modré kolečko s kruhem přesnosti ----------
    const tecka = document.createElement('div');
    tecka.className = 'sm-tecka';
    tecka.innerHTML = '<span class="sm-tecka__pulz"></span><span class="sm-tecka__bod"></span>';
    tecka.setAttribute('aria-label', 'Moje poloha');
    const znackaJa = new maplibregl.Marker({ element: tecka });
    function kruh(lon: number, lat: number, m: number) {
      const k = [];
      for (let a = 0; a <= 64; a++) {
        const u = (a / 64) * Math.PI * 2;
        k.push([lon + (m / (111320 * Math.cos((lat * Math.PI) / 180))) * Math.cos(u), lat + (m / 110540) * Math.sin(u)]);
      }
      return { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [k] } };
    }
    function nastavPolohu(p: GeolocationPosition) {
      poloha = { lon: p.coords.longitude, lat: p.coords.latitude, presnost: Math.min(p.coords.accuracy || 0, 2000) };
      znackaJa.setLngLat([poloha.lon, poloha.lat]).addTo(map);
      (map.getSource('presnost') as maplibregl.GeoJSONSource | undefined)?.setData(poloha.presnost > 25 ? kruh(poloha.lon, poloha.lat, poloha.presnost) as any : prazdne);
      el.classList.add('ma-polohu');
    }
    let sleduji = false;
    function sleduj() {
      if (sleduji || !('geolocation' in navigator)) return;
      sleduji = true;
      navigator.geolocation.watchPosition((p) => nastavPolohu(p), () => {}, { enableHighAccuracy: true, maximumAge: 15000 });
    }

    // ---------- seznam ----------
    function prepocitej() {
      if (!ref || !body.length) { seznam = []; return; }
      const vse = body.map((_, i) => i).filter(projde).map((i) => [i, vzduchem(i)] as const).sort((a, b) => a[1] - b[1]);
      const vDosahu = ref.typ === 'obec' ? vse.filter(([, d]) => d <= ref!.dosah) : [];
      seznam = (vDosahu.length ? vDosahu : vse.slice(0, 10)).map(([i]) => i);
      if (ref.typ === 'poloha') {
        seznam = seznam.slice(0, 10);
        if (seznam.every((i) => cas(i))) seznam.sort((a, b) => (cas(a)!.s - cas(b)!.s) || (cas(a)!.m - cas(b)!.m));
      }
    }

    // Nejbližší prodejna každého řetězce (bez ohledu na filtr)
    function nejblizsiZRetezcu() {
      if (!ref || !body.length) return [];
      const nej: [number, number][] = ids.map(() => [-1, Infinity]);
      body.forEach((b, i) => { const d = vzduchem(i); if (d < nej[b[2]][1]) nej[b[2]] = [i, d]; });
      return nej.filter(([i]) => i >= 0);
    }

    // Čas a vzdálenost po silnici k víc prodejnám najednou (Matrix přes Worker)
    async function nactiCasy(navic: number[] = []) {
      if (!N.trasy || !poloha || !body.length) return;
      const kandidati = ref?.typ === 'poloha' ? [...seznam, ...nejblizsiZRetezcu().map(([i]) => i)] : [];
      const cile = [...new Set([...kandidati, ...navic])].filter((i) => !casy.has(klicCasu(i)) && odMe(i) < 80000).slice(0, 25);
      if (!cile.length) return;
      cekaCasy = true; chybaCasu = false; vykresli();
      try {
        const u = new URL(N.trasy);
        u.searchParams.set('z', `${poloha.lon.toFixed(4)},${poloha.lat.toFixed(4)}`);
        u.searchParams.set('do', cile.map((i) => `${body[i][0]},${body[i][1]}`).join(';'));
        u.searchParams.set('typ', rezim === 'pesky' ? 'foot_fast' : 'car_fast');
        const odp = await fetch(u);
        if (!odp.ok) throw new Error(String(odp.status));
        const radek = (await odp.json()).matrix?.[0] ?? [];
        cile.forEach((i, k) => { const x = radek[k]; casy.set(klicCasu(i), x && x.length >= 0 && x.duration >= 0 ? { m: x.length, s: x.duration } : null); });
      } catch {
        chybaCasu = true;
      }
      cekaCasy = false;
      prepocitej(); vykresli();
    }

    function vzdalenostHtml(i: number, podrobne = false) {
      const t = cas(i);
      if (t) return `<span class="sm__vzd"><strong>${doba(t.s)}</strong> ${rezim === 'pesky' ? 'pěšky' : 'autem'} · ${vzdalenost(t.m)}</span>`;
      if (ref?.typ === 'obec' && !podrobne) return `<span class="sm__vzd"><strong>${vzdalenost(vzduchem(i))}</strong> <span class="drobne">od středu obce</span></span>`;
      if (poloha) return `<span class="sm__vzd"><strong>${vzdalenost(odMe(i))}</strong>${podrobne ? ' <span class="drobne">vzdušnou čarou</span>' : ''}</span>`;
      if (ref) return `<span class="sm__vzd"><strong>${vzdalenost(vzduchem(i))}</strong> <span class="drobne">od středu obce</span></span>`;
      return '';
    }

    function stavHtml(b: Bod) {
      const s = stavTed(nactiDobu(b[6]));
      return s ? `<span class="sm__stav ${s.otevreno ? 'je-otevreno' : 'je-zavreno'}">${esc(s.text)}</span>` : '';
    }

    function polozkaHtml(i: number) {
      const b = body[i];
      return `<li><button type="button" class="sm__polozka${i === vybrana ? ' je-vybrana' : ''}" data-i="${i}">
        ${logoHtml(b[2])}
        <span class="sm__polozka-text"><strong>${esc(nazevProdejny(b))}${jeOblibena(i) ? ' <span class="sm__srdicko" aria-label="oblíbená">♥</span>' : ''}</strong><span class="drobne">${esc(adresa(b) || 'adresa v OpenStreetMap chybí')}</span>${stavHtml(b)}</span>
        ${vzdalenostHtml(i)}
      </button></li>`;
    }

    function rezimHtml() {
      if (!poloha || !N.trasy) return '';
      return `<div class="segment segment--male sm__rezim" role="group" aria-label="Jak se dostaneš">
        <button type="button" data-rezim="pesky" aria-pressed="${rezim === 'pesky'}">Pěšky</button>
        <button type="button" data-rezim="autem" aria-pressed="${rezim === 'autem'}">Autem</button>
      </div>`;
    }

    // Seznam oblíbených (seřazený podle vzdálenosti, když ji známe)
    function oblibeneSeznam() {
      const s = body.map((_, i) => i).filter((i) => oblibene.has(body[i][7]));
      const d = (i: number) => (poloha ? odMe(i) : ref ? vzduchem(i) : 0);
      return s.sort((a, b) => d(a) - d(b));
    }

    function vykresli() {
      if (vybrana >= 0) { el.dataset.stav = 'detail'; return vykresliDetail(); }
      if (jenOblibene) {
        el.dataset.stav = 'oblibene';
        const s = oblibeneSeznam();
        vysledkyEl.innerHTML = `<div class="sm__vysledky-hlava"><h2>Oblíbené prodejny</h2>${rezimHtml()}</div>
          ${s.length ? `<ol class="sm__seznam">${s.map(polozkaHtml).join('')}</ol>` : `<p class="sm__tip">Zatím tu nic není. Otevři prodejnu na mapě a klikni na <strong>Uložit</strong>. Oblíbené si pamatuje jen tento prohlížeč.</p>`}`;
        return;
      }
      if (!ref) {
        el.dataset.stav = 'uvod';
        const s = oblibeneSeznam();
        vysledkyEl.innerHTML = s.length
          ? `<h2 class="sm__mezinadpis">Tvoje oblíbené</h2><ol class="sm__seznam">${s.slice(0, 3).map(polozkaHtml).join('')}</ol>`
          : `<p class="sm__tip">Klikni na prodejnu na mapě nebo nahoře napiš obec. Filtr nahoře ukáže jen jeden řetězec nebo jen otevřené prodejny.</p>`;
        return;
      }
      el.dataset.stav = 'seznam';
      const vDosahu = ref.typ === 'obec' && seznam.length && vzduchem(seznam[seznam.length - 1]) <= ref.dosah;
      const nadpis = ref.typ === 'poloha'
        ? 'Nejblíž k tobě'
        : !seznam.length ? `Žádná prodejna neodpovídá filtru` : vDosahu ? `${esc(ref.nazev)}: ${seznam.length} ${seznam.length === 1 ? 'prodejna' : seznam.length < 5 ? 'prodejny' : 'prodejen'} do ${vzdalenost(ref.dosah)}` : `V obci ${esc(ref.nazev)} žádná prodejna není. Nejbližší:`;
      const zRetezcu = nejblizsiZRetezcu();
      const poznamka = ref.typ === 'poloha'
        ? cekaCasy ? 'Počítám cestu…' : chybaCasu ? 'Cestu po silnici se teď nepodařilo spočítat, vzdálenosti jsou vzdušnou čarou.' : N.trasy ? '' : 'Vzdálenosti jsou vzdušnou čarou.'
        : '';
      vysledkyEl.innerHTML = `
        <div class="sm__vysledky-hlava">
          <button type="button" class="sm__zavrit sm__zavrit--maly" data-zrusit aria-label="Zavřít seznam"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
          <h2>${nadpis}</h2>${ref.typ === 'poloha' ? rezimHtml() : ''}
        </div>
        ${poznamka ? `<p class="drobne sm__poznamka">${poznamka}</p>` : ''}
        ${!seznam.length && (vybrane.size || jenOtevrene) ? `<p class="sm__tip">Zkus vypnout filtr nahoře.</p>` : ''}
        <ol class="sm__seznam">${seznam.slice(0, kolikUkazat).map(polozkaHtml).join('')}</ol>
        ${seznam.length > kolikUkazat ? `<button type="button" class="tlacitko tlacitko--plna-sirka" data-dalsi>Ukázat další (${seznam.length - kolikUkazat})</button>` : ''}
        <h3 class="sm__mezinadpis">Nejbližší z každého řetězce</h3>
        <ul class="sm__kazdy">${zRetezcu.map(([i]) => `<li><button type="button" class="sm__kazdy-tl" data-i="${i}" aria-label="Nejbližší ${esc(N.retezce[body[i][2]].nazev)}">${logoHtml(body[i][2])}${vzdalenostHtml(i)}</button></li>`).join('')}</ul>`;
    }

    const IKONA = {
      trasa: '<path d="M6 19a2 2 0 1 0 0-4a2 2 0 1 0 0 4z M18 9a2 2 0 1 0 0-4a2 2 0 1 0 0 4z M8 17h6.5a3.5 3.5 0 0 0 0-7h-5a3.5 3.5 0 0 1 0-7H16" transform="translate(0 2)"/>',
      srdce: '<path d="M12 20s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.4a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/>',
      navigovat: '<path d="M20 4L4 11l7 2 2 7z"/>',
      sdilet: '<path d="M12 15V4 M8 8l4-4 4 4 M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/>',
      pesky: '<path d="M13 4.5a1.5 1.5 0 1 0 0 .01 M10 21l2-6 3 3v3 M9 12l2-4 3 1 2 3 M11 8l-2 5"/>',
      auto: '<path d="M5 16V11l2-5h10l2 5v5 M5 16h14 M5 16v2 M19 16v2 M7.5 13h.01 M16.5 13h.01"/>',
    };
    const svg = (d: string, plne = false) => `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="${plne ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;

    function odkazyNavigace(b: Bod) {
      const mapy = new URL('https://mapy.com/fnc/v1/route');
      if (poloha) mapy.searchParams.set('start', `${poloha.lon.toFixed(5)},${poloha.lat.toFixed(5)}`);
      mapy.searchParams.set('end', `${b[0]},${b[1]}`);
      mapy.searchParams.set('routeType', rezim === 'pesky' ? 'foot_fast' : 'car_fast');
      mapy.searchParams.set('navigate', 'true');
      const google = `https://www.google.com/maps/dir/?api=1&destination=${b[1]},${b[0]}&travelmode=${rezim === 'pesky' ? 'walking' : 'driving'}`;
      return { mapy: mapy.toString(), google };
    }

    function vykresliDetail() {
      const b = body[vybrana], d = nactiDobu(b[6]), radky = radkyDoby(d, b[6]);
      const osm = `https://www.openstreetmap.org/${({ n: 'node', w: 'way', r: 'relation' } as Record<string, string>)[b[7][0]]}/${b[7].slice(1)}`;
      const nav = odkazyNavigace(b);
      const oblib = jeOblibena(vybrana);
      const maTrasu = trasa?.i === vybrana;
      const t = cas(vybrana);
      let cesta = '';
      if (maTrasu) {
        cesta = `<div class="sm__cesta je-trasa">
          <span class="sm__cesta-ikona">${svg(rezim === 'pesky' ? IKONA.pesky : IKONA.auto)}</span>
          <span class="sm__cesta-text"><strong>${doba(trasa!.s)}</strong> <span>${vzdalenost(trasa!.m)}</span></span>
          ${rezimHtml()}
        </div>
        ${trasa!.vzduchem ? '<p class="drobne sm__poznamka-trasy">Cestu po silnici se teď nepodařilo spočítat. Čára i čas jsou jen odhad vzdušnou čarou, pro navigaci použij Navigovat.</p>' : ''}`;
      } else if (poloha || ref) {
        cesta = `<div class="sm__cesta">${vzdalenostHtml(vybrana, true)}${t || !poloha ? '' : cekaCasy ? '<span class="drobne">Počítám cestu…</span>' : ''}${poloha ? rezimHtml() : ''}</div>`;
      }
      vysledkyEl.innerHTML = `
        <article class="sm__detail">
          <div class="sm__detail-hlava">
            ${logoHtml(b[2], true)}
            <div class="sm__detail-nazev"><h2>${esc(nazevProdejny(b))}</h2><p>${esc(adresa(b) || 'Adresa v OpenStreetMap chybí')}</p>${stavHtml(b)}</div>
            <button type="button" class="sm__zavrit" data-zavrit aria-label="Zavřít">${svg('<path d="M6 6l12 12M18 6L6 18"/>')}</button>
          </div>
          <div class="sm__akce">
            <button type="button" class="sm__akce-tl sm__akce-tl--hlavni" data-trasa aria-pressed="${maTrasu}" ${cekaTrasa ? 'disabled' : ''}>
              <span class="sm__akce-kruh">${svg(IKONA.trasa)}</span><span>${cekaTrasa ? 'Hledám…' : maTrasu ? 'Skrýt trasu' : 'Trasa'}</span>
            </button>
            <button type="button" class="sm__akce-tl" data-oblibit aria-pressed="${oblib}">
              <span class="sm__akce-kruh">${svg(IKONA.srdce, oblib)}</span><span>${oblib ? 'Uloženo' : 'Uložit'}</span>
            </button>
            <button type="button" class="sm__akce-tl" data-navigovat aria-expanded="${nabidkaNavigace}">
              <span class="sm__akce-kruh">${svg(IKONA.navigovat)}</span><span>Navigovat</span>
            </button>
            <button type="button" class="sm__akce-tl" data-sdilet>
              <span class="sm__akce-kruh">${svg(IKONA.sdilet)}</span><span>Sdílet</span>
            </button>
          </div>
          ${nabidkaNavigace ? `<div class="sm__navigace">
            <p class="drobne">Navigace krok za krokem v aplikaci (v mobilu se otevře, když ji máš):</p>
            <div class="sm__navigace-tl">
              <a class="tlacitko tlacitko--oranzovy" href="${nav.mapy}" target="_blank" rel="noopener">Mapy.com</a>
              <a class="tlacitko" href="${nav.google}" target="_blank" rel="noopener">Google Mapy</a>
            </div>
          </div>` : ''}
          ${cesta}
          ${radky.length ? `<div class="sm__doba"><h3>Otevírací doba</h3><ul>${radky.map((r) => `<li>${esc(r)}</li>`).join('')}</ul></div>` : `<p class="drobne">Otevírací doba v OpenStreetMap chybí.</p>`}
          <p class="drobne">Chybí adresa nebo nesedí otevírací doba? <a href="${osm}" target="_blank" rel="noopener">Oprav ji v OpenStreetMap</a>, na web se dostane při další aktualizaci.</p>
        </article>`;
    }

    // Přiblížit na body. MapLibre k odsazení v options přičítá i odsazení mapy, proto se nastaví zvlášť
    // a do fitBounds jde jen malý okraj.
    function priblizNa(pts: number[][], maxZoom = 15.5, duration = 900) {
      const lon = pts.map((p) => p[0]), lat = pts.map((p) => p[1]);
      map.setPadding(odsazeni());
      map.fitBounds([[Math.min(...lon), Math.min(...lat)], [Math.max(...lon), Math.max(...lat)]], { padding: 36, maxZoom, duration });
    }

    function zobrazSeznamNaMape() {
      if (!ref || !seznam.length) return;
      priblizNa([[ref.lon, ref.lat], ...seznam.slice(0, Math.min(seznam.length, ref.typ === 'poloha' ? 5 : 30)).map((i) => [body[i][0], body[i][1]])]);
    }

    function vyber(i: number, zPrikazu = false) {
      if (trasa && trasa.i !== i) zrusTrasu();
      vybrana = i; nabidkaNavigace = false;
      const b = body[i];
      (map.getSource('vybrana') as maplibregl.GeoJSONSource).setData({ type: 'Feature', properties: { id: ids[b[2]] }, geometry: { type: 'Point', coordinates: [b[0], b[1]] } } as any);
      vykresli();
      vysun('stred', false);
      requestAnimationFrame(() => map.easeTo({ center: [b[0], b[1]], zoom: Math.max(map.getZoom(), 15), padding: odsazeni(), duration: zPrikazu ? 0 : 700 }));
      history.replaceState(null, '', `#prodejna=${b[7]}`);
      obsah.scrollTo({ top: 0 });
      // čas cesty k této prodejně, i když není v seznamu nejbližších
      if (poloha && !casy.has(klicCasu(i))) nactiCasy([i]);
    }

    function zrusVyber() {
      vybrana = -1; nabidkaNavigace = false;
      zrusTrasu();
      (map.getSource('vybrana') as maplibregl.GeoJSONSource | undefined)?.setData(prazdne);
      history.replaceState(null, '', location.pathname + location.search + '#mapa-prodejen');
      vykresli();
      map.easeTo({ padding: odsazeni(), duration: 300 });
    }

    // ---------- trasa na mapě ----------
    function zrusTrasu() {
      trasa = null;
      (map.getSource('trasa') as maplibregl.GeoJSONSource | undefined)?.setData(prazdne);
    }
    async function ukazTrasu(i: number) {
      if (!poloha) { najdiPolohu(() => ukazTrasu(i)); return; }
      const b = body[i];
      cekaTrasa = true; vykresli();
      let cara: [number, number][] = [[poloha.lon, poloha.lat], [b[0], b[1]]];
      let vysledek: { m: number; s: number; vzduchem: boolean };
      try {
        if (!N.trasy) throw new Error('bez Workeru');
        const u = new URL(N.trasy);
        u.searchParams.set('trasa', '1');
        u.searchParams.set('z', `${poloha.lon.toFixed(4)},${poloha.lat.toFixed(4)}`);
        u.searchParams.set('do', `${b[0]},${b[1]}`);
        u.searchParams.set('typ', rezim === 'pesky' ? 'foot_fast' : 'car_fast');
        const odp = await fetch(u);
        if (!odp.ok) throw new Error(String(odp.status));
        const j = await odp.json();
        if (!Array.isArray(j.cara) || j.cara.length < 2) throw new Error('bez čáry');
        cara = j.cara;
        vysledek = { m: j.m, s: j.s, vzduchem: false };
        casy.set(klicCasu(i), { m: j.m, s: j.s });
      } catch {
        // Bez trasy po silnici aspoň přímá čára a odhad času (pěšky 4,5 km/h, autem 40 km/h po městě)
        const m = odMe(i);
        vysledek = { m, s: m / (rezim === 'pesky' ? 1.25 : 11), vzduchem: true };
      }
      cekaTrasa = false;
      if (vybrana !== i) return;
      trasa = { i, rezim, ...vysledek };
      map.setPaintProperty('trasa', 'line-dasharray', rezim === 'pesky' || vysledek.vzduchem ? [0.1, 1.9] : [1, 0]);
      (map.getSource('trasa') as maplibregl.GeoJSONSource).setData({ type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: cara } } as any);
      vykresli();
      vysun('stred', false);
      requestAnimationFrame(() => priblizNa(cara, 16.5, 800));
    }

    async function sdilej(i: number) {
      const b = body[i];
      const url = `${location.origin}${location.pathname}#prodejna=${b[7]}`;
      const titul = `${nazevProdejny(b)}${adresa(b) ? `, ${adresa(b)}` : ''}`;
      try {
        if (navigator.share && mobil.matches) { await navigator.share({ title: titul, url }); return; }
        await navigator.clipboard.writeText(url);
        oznam('Odkaz na prodejnu je zkopírovaný');
      } catch {}
    }

    vysledkyEl.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const polozka = t.closest<HTMLElement>('[data-i]');
      if (polozka) return vyber(Number(polozka.dataset.i));
      if (t.closest('[data-zavrit]')) { zrusVyber(); if (ref) zobrazSeznamNaMape(); return; }
      if (t.closest('[data-zrusit]')) { pole.value = ''; smazat.hidden = true; nastavRef(null); seznam = []; vykresli(); vysun('nizko'); return; }
      if (t.closest('[data-trasa]')) { if (trasa?.i === vybrana) { zrusTrasu(); vykresli(); } else ukazTrasu(vybrana); return; }
      if (t.closest('[data-oblibit]')) {
        const id = body[vybrana][7];
        if (oblibene.has(id)) { oblibene.delete(id); oznam('Odebráno z oblíbených'); } else { oblibene.add(id); oznam('Uloženo do oblíbených'); }
        uloz('sm-oblibene', [...oblibene]);
        aktualizujProdejny(); vykresli();
        return;
      }
      if (t.closest('[data-navigovat]')) { nabidkaNavigace = !nabidkaNavigace; vykresli(); return; }
      if (t.closest('[data-sdilet]')) { sdilej(vybrana); return; }
      if (t.closest('[data-dalsi]')) { kolikUkazat += 20; vykresli(); return; }
      const r = t.closest<HTMLElement>('[data-rezim]');
      if (r && r.dataset.rezim !== rezim) {
        rezim = r.dataset.rezim as Rezim;
        prepocitej(); vykresli(); nactiCasy(vybrana >= 0 ? [vybrana] : []);
        if (trasa && vybrana >= 0) ukazTrasu(vybrana);
      }
    });

    // ---------- filtry nahoře ----------
    const tlRetezcu = [...el.querySelectorAll<HTMLButtonElement>('[data-r]')];
    const tlOtevreno = $<HTMLButtonElement>('[data-sm-otevreno]'), tlOblibene = $<HTMLButtonElement>('[data-sm-oblibene]');
    function nastavFiltr() {
      for (const tl of tlRetezcu) tl.setAttribute('aria-pressed', String(vybrane.has(tl.dataset.r!)));
      tlOtevreno.setAttribute('aria-pressed', String(jenOtevrene));
      tlOblibene.setAttribute('aria-pressed', String(jenOblibene));
      el.classList.toggle('je-filtr', vybrane.size > 0);
      aktualizujProdejny();
      prepocitej(); kolikUkazat = 12; vykresli(); nactiCasy();
      if (vybrana < 0) {
        if (jenOblibene) {
          const s = oblibeneSeznam();
          if (s.length) priblizNa(s.map((i) => [body[i][0], body[i][1]]), 15, 800);
          vysun('stred');
        } else zobrazSeznamNaMape();
      }
    }
    for (const tl of tlRetezcu) tl.addEventListener('click', () => {
      const id = tl.dataset.r!;
      if (vybrane.has(id)) vybrane.delete(id); else vybrane.add(id);
      nastavFiltr();
    });
    tlOtevreno.addEventListener('click', () => {
      jenOtevrene = !jenOtevrene;
      if (jenOtevrene) {
        const ted = new Date();
        otevreneTed = new Set(body.map((b, i) => [i, stavTed(nactiDobu(b[6]), ted)] as const).filter(([, s]) => s?.otevreno).map(([i]) => i));
      }
      nastavFiltr();
    });
    tlOblibene.addEventListener('click', () => { jenOblibene = !jenOblibene; if (vybrana >= 0 && jenOblibene) { vybrana = -1; (map.getSource('vybrana') as maplibregl.GeoJSONSource | undefined)?.setData(prazdne); zrusTrasu(); } nastavFiltr(); });

    // ---------- poloha ----------
    const tlPoloha = $<HTMLButtonElement>('[data-sm-poloha]');
    function najdiPolohu(potom?: () => void) {
      if (!('geolocation' in navigator)) { hlaska('Tvůj prohlížeč polohu nezjistí. Napiš obec.'); return; }
      tlPoloha.disabled = true; tlPoloha.querySelector('span')!.textContent = 'Zjišťuji polohu…';
      el.classList.add('hleda-polohu');
      navigator.geolocation.getCurrentPosition(
        (p) => {
          tlPoloha.disabled = false; tlPoloha.querySelector('span')!.textContent = 'Nejbližší ke mně';
          el.classList.remove('hleda-polohu');
          nastavPolohu(p); sleduj();
          if (potom) { potom(); return; }
          pole.value = ''; smazat.hidden = true;
          nastavRef({ lon: poloha!.lon, lat: poloha!.lat, typ: 'poloha', nazev: 'Moje poloha', dosah: 0 });
          zrusTrasu();
          vybrana = -1; kolikUkazat = 12; jenOblibene = false; tlOblibene.setAttribute('aria-pressed', 'false');
          (map.getSource('vybrana') as maplibregl.GeoJSONSource | undefined)?.setData(prazdne);
          prepocitej();
          rezim = seznam.length && vzduchem(seznam[0]) < 1500 ? 'pesky' : 'autem';
          prepocitej(); vykresli(); vysun('stred'); zobrazSeznamNaMape(); nactiCasy();
        },
        (chyba) => {
          tlPoloha.disabled = false; tlPoloha.querySelector('span')!.textContent = 'Nejbližší ke mně';
          el.classList.remove('hleda-polohu');
          hlaska(chyba.code === 1 ? 'Polohu jsi nepovolil(a). Povol ji v nastavení prohlížeče, nebo nahoře napiš obec.' : 'Polohu se nepodařilo zjistit. Zkus to znovu, nebo nahoře napiš obec.');
        },
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 },
      );
    }
    function hlaska(text: string) {
      vybrana = -1; el.dataset.stav = 'uvod';
      vysledkyEl.innerHTML = `<p class="sm__tip sm__tip--chyba">${esc(text)}</p>`;
      vysun('stred');
    }
    tlPoloha.addEventListener('click', () => najdiPolohu());
    // Tlačítko na mapě: když polohu známe, jen k ní přiletí, jinak najde nejbližší
    for (const tl of el.querySelectorAll<HTMLButtonElement>('[data-sm-ja]')) tl.addEventListener('click', () => {
      if (poloha) map.flyTo({ center: [poloha.lon, poloha.lat], zoom: Math.max(map.getZoom(), 15), padding: odsazeni(), duration: 800 });
      else najdiPolohu();
    });

    // ---------- hledání: obec, město, nebo řetězec („lidl“, „lidl brno“) ----------
    const TYPY = ['město', 'město', 'obec', 'část obce'];
    const DOSAH = [8000, 4000, 2500, 2000];
    const NAZVY_RETEZCU = N.retezce.map((r) => bezDiakritiky(r.nazev));
    type Navrh = { obec?: Obec; retezec?: number };
    let navrhy: Navrh[] = [], aktivni = -1;
    async function nactiObce() {
      if (obce) return;
      const d = await (await fetch('/data/obce.json')).json();
      obce = d.obce; nazvyKraju = d.kraje;
      for (const o of obce!) (o as any).hledat = bezDiakritiky(o[0]);
    }
    // „lidl brno“ → řetězec Lidl + obec Brno
    function rozeber(text: string) {
      const slova = bezDiakritiky(text.trim()).split(/\s+/).filter(Boolean);
      let retezec = -1;
      for (const k of [0, slova.length - 1]) {
        const r = slova[k] && slova[k].length >= 3 ? NAZVY_RETEZCU.findIndex((n) => n.startsWith(slova[k])) : -1;
        if (r >= 0) { retezec = r; slova.splice(k, 1); break; }
      }
      return { retezec, q: slova.join(' ') };
    }
    pole.addEventListener('focus', () => { nactiObce(); if (mobil.matches && panel.dataset.vyska === 'vysoko') vysun('stred'); });
    pole.addEventListener('input', async () => {
      smazat.hidden = !pole.value;
      await nactiObce();
      const { retezec, q } = rozeber(pole.value);
      if (q.length < 2 && retezec < 0) return zavriNaseptavac();
      const zacina: Obec[] = [], slovo: Obec[] = [];
      if (q.length >= 2) for (const o of obce!) {
        const h: string = (o as any).hledat;
        if (h.startsWith(q)) zacina.push(o);
        else if (h.includes(' ' + q) || h.includes('-' + q)) slovo.push(o);
      }
      const poradi = (a: Obec, b: Obec) => Number(bezDiakritiky(b[0]) === q) - Number(bezDiakritiky(a[0]) === q) || a[3] - b[3];
      const nalezene = [...zacina.sort(poradi), ...slovo.sort(poradi)].slice(0, retezec >= 0 && !q ? 0 : 7);
      navrhy = [
        ...(retezec >= 0 && !q ? [{ retezec }] : []),
        ...nalezene.map((obec) => ({ obec, retezec: retezec >= 0 ? retezec : undefined })),
      ];
      aktivni = navrhy.length ? 0 : -1;
      ukazNaseptavac();
    });
    function ukazNaseptavac() {
      if (!navrhy.length) {
        naseptavac.innerHTML = `<li class="sm__nic">Takovou obec ani řetězec neznám</li>`;
      } else {
        naseptavac.innerHTML = navrhy.map((n, k) => {
          const r = n.retezec !== undefined ? logoHtml(n.retezec) : '<span class="sm__navrh-ikona"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>';
          if (!n.obec) return `<li role="option" id="sm-navrh-${k}" aria-selected="${k === aktivni}" data-k="${k}">${r}<span class="sm__navrh-text"><strong>Všechny prodejny ${esc(N.retezce[n.retezec!].nazev)}</strong><span class="drobne">${poloha ? 'nejbližší k tobě' : 'na mapě'}</span></span></li>`;
          const o = n.obec;
          const popis = `${TYPY[o[3]]}${o[3] === 3 && o[5] ? ` ${esc(o[5])}` : ` · ${esc(nazvyKraju[o[4]] ?? '')}`}${o[3] === 2 && o[5] ? ` · u města ${esc(o[5])}` : ''}`;
          return `<li role="option" id="sm-navrh-${k}" aria-selected="${k === aktivni}" data-k="${k}">${r}<span class="sm__navrh-text"><strong>${n.retezec !== undefined ? `${esc(N.retezce[n.retezec].nazev)} · ` : ''}${esc(o[0])}</strong><span class="drobne">${popis}</span></span></li>`;
        }).join('');
      }
      naseptavac.hidden = false;
      pole.setAttribute('aria-expanded', 'true');
      if (aktivni >= 0) pole.setAttribute('aria-activedescendant', `sm-navrh-${aktivni}`);
    }
    function zavriNaseptavac() { naseptavac.hidden = true; pole.setAttribute('aria-expanded', 'false'); pole.removeAttribute('aria-activedescendant'); }
    pole.addEventListener('keydown', (e) => {
      if (naseptavac.hidden || !navrhy.length) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        aktivni = (aktivni + (e.key === 'ArrowDown' ? 1 : navrhy.length - 1)) % navrhy.length;
        ukazNaseptavac();
      } else if (e.key === 'Enter') { e.preventDefault(); pouzijNavrh(navrhy[Math.max(0, aktivni)]); }
      else if (e.key === 'Escape') zavriNaseptavac();
    });
    naseptavac.addEventListener('mousedown', (e) => e.preventDefault());
    naseptavac.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[data-k]');
      if (li) pouzijNavrh(navrhy[Number(li.dataset.k)]);
    });
    pole.addEventListener('blur', () => setTimeout(zavriNaseptavac, 120));
    smazat.addEventListener('click', () => {
      pole.value = ''; smazat.hidden = true; zavriNaseptavac();
      nastavRef(null); seznam = []; zrusVyber(); pole.focus();
    });
    function pouzijNavrh(n: Navrh) {
      if (n.retezec !== undefined) { vybrane = new Set([ids[n.retezec]]); jenOblibene = false; }
      if (n.obec) { vyberObec(n.obec); nastavFiltr(); return; }
      // jen řetězec: od polohy, když ji známe, jinak od středu mapy
      pole.value = N.retezce[n.retezec!].nazev; smazat.hidden = false; zavriNaseptavac(); pole.blur();
      if (poloha) nastavRef({ lon: poloha.lon, lat: poloha.lat, typ: 'poloha', nazev: 'Moje poloha', dosah: 0 });
      vybrana = -1; zrusTrasu();
      nastavFiltr();
      vysun('stred');
    }
    function vyberObec(o: Obec) {
      pole.value = o[0]; smazat.hidden = false; zavriNaseptavac(); pole.blur();
      nastavRef({ lon: o[1], lat: o[2], typ: 'obec', nazev: o[0], dosah: DOSAH[o[3]] });
      vybrana = -1; kolikUkazat = 12; zrusTrasu(); jenOblibene = false; tlOblibene.setAttribute('aria-pressed', 'false');
      (map.getSource('vybrana') as maplibregl.GeoJSONSource | undefined)?.setData(prazdne);
      prepocitej(); vykresli(); vysun('stred');
      requestAnimationFrame(() => { if (seznam.length) zobrazSeznamNaMape(); else map.flyTo({ center: [o[1], o[2]], zoom: 13, padding: odsazeni() }); });
    }

    // ---------- panel na mobilu (vysouvací zespodu) ----------
    type Vyska = 'nizko' | 'stred' | 'vysoko';
    function vysun(v: Vyska, posunMapu = true) {
      if (!mobil.matches) { if (posunMapu) map.easeTo({ padding: odsazeni(), duration: 300 }); return; }
      if (panel.dataset.vyska === 'vysoko' && v === 'stred') return;
      if (panel.dataset.vyska === v) return;
      panel.dataset.vyska = v;
      if (posunMapu) map.easeTo({ padding: odsazeni(v), duration: 320 });
    }
    const uchyt = $('[data-sm-uchyt]');
    let tah: { y: number; h: number; pohyb: boolean } | null = null;
    uchyt.addEventListener('pointerdown', (e) => {
      tah = { y: e.clientY, h: panel.getBoundingClientRect().height, pohyb: false };
      uchyt.setPointerCapture(e.pointerId);
      panel.classList.add('je-tazen');
    });
    uchyt.addEventListener('pointermove', (e) => {
      if (!tah) return;
      const dy = tah.y - e.clientY;
      if (Math.abs(dy) > 6) tah.pohyb = true;
      panel.style.height = `${Math.max(120, Math.min(el.clientHeight - horni.offsetHeight - 16, tah.h + dy))}px`;
    });
    uchyt.addEventListener('pointerup', () => {
      if (!tah) return;
      const h = panel.getBoundingClientRect().height, H = el.clientHeight;
      panel.classList.remove('je-tazen'); panel.style.height = '';
      if (!tah.pohyb) {
        const dalsi: Record<string, Vyska> = { nizko: 'stred', stred: 'vysoko', vysoko: 'nizko' };
        panel.dataset.vyska = dalsi[panel.dataset.vyska ?? 'nizko'];
      } else panel.dataset.vyska = h < H * 0.3 ? 'nizko' : h < H * 0.68 ? 'stred' : 'vysoko';
      map.easeTo({ padding: odsazeni(), duration: 320 });
      tah = null;
    });
    map.on('dragstart', () => { if (mobil.matches && panel.dataset.vyska !== 'nizko' && vybrana < 0) { panel.dataset.vyska = 'nizko'; map.setPadding(odsazeni()); } });

    // ---------- celá obrazovka (počítač) ----------
    const tlCela = $<HTMLButtonElement>('[data-sm-cela]');
    function nastavCelou(zapnout: boolean) {
      el.classList.toggle('je-cela', zapnout);
      document.documentElement.classList.toggle('sm-cela', zapnout);
      tlCela.setAttribute('aria-pressed', String(zapnout));
      tlCela.setAttribute('aria-label', zapnout ? 'Zmenšit mapu' : 'Mapa na celou obrazovku');
      requestAnimationFrame(() => map.resize());
    }
    tlCela.addEventListener('click', async () => {
      const zapnout = !el.classList.contains('je-cela');
      try {
        if (zapnout && el.requestFullscreen) await el.requestFullscreen();
        else if (!zapnout && document.fullscreenElement) await document.exitFullscreen();
      } catch {}
      nastavCelou(zapnout);
    });
    document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement && el.classList.contains('je-cela')) nastavCelou(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || document.activeElement === pole) return;
      if (el.classList.contains('je-cela') && !document.fullscreenElement) nastavCelou(false);
      else if (vybrana >= 0) zrusVyber();
    });

    // Výška mapy = okno bez hlavičky webu (na mobilu je hlavička nad mapou schovaná)
    const hlavicka = document.querySelector<HTMLElement>('.hlavicka');
    const vyskaHlavicky = () => el.style.setProperty('--sm-hlavicka', `${mobil.matches ? 0 : hlavicka?.offsetHeight ?? 64}px`);
    vyskaHlavicky();
    addEventListener('resize', () => { vyskaHlavicky(); map.setPadding(odsazeni()); });
    mobil.addEventListener('change', () => { panel.dataset.vyska = 'nizko'; vyskaHlavicky(); map.resize(); map.setPadding(odsazeni()); });

    // Na mobilu se hlavička a spodní lišta webu ukážou, až když člověk sjede pod mapu
    new IntersectionObserver(([z]) => document.documentElement.classList.toggle('sm-pod-mapou', z.intersectionRatio < 0.35), { threshold: [0, 0.35, 0.7, 1] }).observe(el);
  }
</script>

