---
import GrafCard from './GrafCard.astro';

interface Props {
  grafy: { id: string; data: any }[];
}

const { grafy } = Astro.props;
const temata = ['Vše', ...new Set(grafy.map((g) => g.data.tema))];
---

<div class="archiv" data-archiv>
  <div class="archiv__ovladani">
    <div class="rada" role="group" aria-label="Filtrovat podle tématu">
      {temata.map((t, i) => (
        <button class="chip" type="button" data-filtr={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>
      ))}
    </div>
    <div class="hledani archiv__hledani">
      <label class="sr-only" for="hledat-graf">Hledat graf</label>
      <div class="hledani__pole">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 4a6 6 0 1 0 0 12a6 6 0 1 0 0-12 M20 20l-5.6-5.6" /></svg>
        <input id="hledat-graf" type="search" enterkeyhint="search" placeholder="Hledat, třeba Penny" autocomplete="off" />
      </div>
    </div>
  </div>

  <div class="archiv__radek">
    <p class="drobne" data-pocet aria-live="polite"></p>
    <div class="archiv__sipky">
      <button type="button" class="archiv__sipka" data-posun="-1" aria-label="Předchozí grafy" disabled><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
      <button type="button" class="archiv__sipka" data-posun="1" aria-label="Další grafy"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
    </div>
  </div>
  <ul class="archiv__seznam" data-seznam data-postupne>
    {grafy.map((g, i) => <GrafCard id={g.id} data={g.data} velka={i === 0} />)}
  </ul>

  <div class="karta archiv__prazdno" data-prazdno hidden>
    <p style="font-weight: 800; font-size: 1.15rem;">Žádný graf neodpovídá hledání.</p>
    <p class="drobne">Zkus jiné slovo, nebo zruš filtr tématu.</p>
    <button class="tlacitko tlacitko--plny" type="button" data-zrusit>Zrušit filtr a hledání</button>
  </div>
</div>

<style>
  .archiv { display: flex; flex-direction: column; gap: 1.25rem; }
  .archiv__ovladani { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  .archiv__hledani { width: min(100%, 300px); }
  .archiv__prazdno { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; text-align: center; }
  /* grafy v jednom pásu, který jede do strany: celá sekce se vejde na obrazovku, na telefonu se posouvá prstem, na počítači šipkami */
  .archiv__radek { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: -0.5rem; }
  .archiv__sipky { display: none; gap: 0.4rem; }
  @media (hover: hover) and (pointer: fine) { .archiv__sipky { display: flex; } }
  .archiv__sipka { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--plocha); box-shadow: var(--stin-mekky); color: var(--navy); cursor: pointer; transition: background-color 0.2s ease, opacity 0.2s ease; }
  .archiv__sipka:hover:not(:disabled) { background: var(--navy); color: var(--cream); }
  .archiv__sipka:disabled { opacity: 0.35; cursor: default; }
  .archiv__seznam {
    display: flex; gap: clamp(1rem, 2vw, 1.5rem); list-style: none; margin: 0 -1.25rem; padding: 0.75rem 1.25rem 3.5rem;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 1.25rem; scrollbar-width: none; overscroll-behavior-x: contain;
    margin-bottom: -1.75rem;
    /* kraje pásu se ztrácejí do pozadí, ať karty nejsou useknuté natvrdo */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 1.25rem, #000 calc(100% - 3rem), transparent);
    mask-image: linear-gradient(90deg, transparent 0, #000 1.25rem, #000 calc(100% - 3rem), transparent);
  }
  .archiv__seznam::-webkit-scrollbar { display: none; }
  .archiv__seznam > :global(li) { flex: 0 0 clamp(270px, 26vw, 340px); scroll-snap-align: start; }
  .archiv__seznam > :global(li.kg--velka) { flex-basis: clamp(290px, 46vw, 640px); }
  @media (max-width: 899px) { .archiv__seznam > :global(li.kg--velka) { flex-basis: min(84vw, 360px); } .archiv__seznam > :global(li) { flex-basis: min(80vw, 320px); } }
</style>

<script>
  const bezDiakritiky = (t: string) =>
    t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const popisek = (n: number) =>
    n === 1 ? '1 graf' : n >= 2 && n <= 4 ? `${n} grafy` : `${n} grafů`;

  for (const archiv of document.querySelectorAll<HTMLElement>('[data-archiv]')) {
    const karty = Array.from(archiv.querySelectorAll<HTMLElement>('.kg'));
    const chipy = Array.from(archiv.querySelectorAll<HTMLButtonElement>('[data-filtr]'));
    const hledat = archiv.querySelector<HTMLInputElement>('input[type="search"]')!;
    const pocet = archiv.querySelector<HTMLElement>('[data-pocet]')!;
    const prazdno = archiv.querySelector<HTMLElement>('[data-prazdno]')!;
    const zrusit = archiv.querySelector<HTMLButtonElement>('[data-zrusit]')!;
    let filtr = 'Vše';

    const prekresli = () => {
      const dotaz = bezDiakritiky(hledat.value.trim());
      let videt = 0;
      for (const karta of karty) {
        const tema = filtr === 'Vše' || karta.dataset.tema === filtr;
        const text = !dotaz || bezDiakritiky(karta.dataset.hledani ?? '').includes(dotaz);
        karta.hidden = !(tema && text);
        if (tema && text) videt++;
      }
      pocet.textContent = popisek(videt);
      prazdno.hidden = videt > 0;
      for (const c of chipy) c.setAttribute('aria-pressed', String(c.dataset.filtr === filtr));
    };

    for (const chip of chipy) {
      chip.addEventListener('click', () => {
        filtr = chip.dataset.filtr ?? 'Vše';
        prekresli();
        seznam.scrollTo({ left: 0 });
        stavSipek();
      });
    }
    // šipky posouvají pás o kus doleva / doprava, na krajích zešednou
    const seznam = archiv.querySelector<HTMLElement>('[data-seznam]')!;
    const sipky = Array.from(archiv.querySelectorAll<HTMLButtonElement>('[data-posun]'));
    const stavSipek = () => {
      const max = seznam.scrollWidth - seznam.clientWidth - 2;
      sipky[0].disabled = seznam.scrollLeft <= 2;
      sipky[1].disabled = seznam.scrollLeft >= max;
    };
    for (const b of sipky) b.addEventListener('click', () => seznam.scrollBy({ left: Number(b.dataset.posun) * seznam.clientWidth * 0.8, behavior: 'smooth' }));
    seznam.addEventListener('scroll', stavSipek, { passive: true });
    addEventListener('resize', stavSipek);
    hledat.addEventListener('input', () => { prekresli(); seznam.scrollTo({ left: 0 }); stavSipek(); });
    zrusit.addEventListener('click', () => {
      filtr = 'Vše';
      hledat.value = '';
      prekresli();
    });
    prekresli();
    stavSipek();
  }
</script>
