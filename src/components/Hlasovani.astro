---
import { ZEME } from '../lib/svet';
import { epizody } from '../data/epizody';
import { hlasovani, hlasovaniZapnute } from '../data/hlasovani';

const hotove = new Set(epizody.map((e) => e.a3));
const moznosti = Object.entries(ZEME)
  .filter(([a3]) => a3 !== 'CZE' && a3 !== 'EUZ' && !hotove.has(a3))
  .map(([a3, [n, a2]]) => ({ a3, n, a2 }))
  .sort((a, b) => a.n.localeCompare(b.n, 'cs'));
const nastaveni = JSON.stringify({ ...hlasovani, zapnute: hlasovaniZapnute, moznosti });
---

<div class="hl" data-hlasovani data-nastaveni={nastaveni}>
  <div class="hl__volba">
    <div class="nadpis">
      <span class="nadpis__stitek">Česko vs. svět · díl {epizody.length + 1}</span>
      <h2>Který stát chceš příště?</h2>
      <p class="drobne">Napiš název země a vyber ji ze seznamu. Hlasovat jde jednou za 30 dní.</p>
    </div>
    <div class="hl__hledani">
      <label for="hl-vstup" class="hl__popisek">Země</label>
      <input id="hl-vstup" type="text" autocomplete="off" placeholder="Například Japonsko" data-vstup role="combobox" aria-expanded="false" aria-controls="hl-seznam" />
      <ul id="hl-seznam" class="hl__seznam" role="listbox" data-seznam hidden></ul>
    </div>
    <div class="hl__vybrano" data-vybrano hidden></div>
    <button type="button" class="tlacitko tlacitko--plny" data-odeslat disabled>Hlasovat</button>
    <p class="drobne" data-stav aria-live="polite"></p>
    {!hlasovaniZapnute && <p class="drobne hl__pozn">Náhled: hlasování se zapne, až doplníš odkazy v src/data/hlasovani.ts.</p>}
  </div>

  <div class="hl__vysledky">
    <div class="rada rada--mezi">
      <h3>Zatím vedou</h3>
      <span class="drobne" data-celkem></span>
    </div>
    <ol class="hl__poradi" data-poradi>
      <li class="drobne">Načítám hlasy…</li>
    </ol>
  </div>
</div>

<style>
  .hl { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (max-width: 860px) { .hl { grid-template-columns: 1fr; } }
  .hl__volba { display: flex; flex-direction: column; gap: 1.1rem; align-items: flex-start; }
  .hl__hledani { position: relative; width: min(100%, 380px); display: flex; flex-direction: column; gap: 0.35rem; }
  .hl__hledani input { width: 100%; }
  .hl__popisek { font-size: 0.85rem; }
  .hl__seznam {
    position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 10; list-style: none; margin: 0; padding: 0.35rem;
    background: var(--paper); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--stin);
  }
  :global(.hl__seznam button) {
    display: flex; align-items: center; gap: 0.7rem; width: 100%; padding: 0.6rem 0.7rem; border: 0; border-radius: 10px;
    background: transparent; color: var(--navy); font-family: inherit; font-size: 0.95rem; font-weight: 700; text-align: left; cursor: pointer;
  }
  :global(.hl__seznam button:hover), :global(.hl__seznam button[aria-selected='true']) { background: var(--plocha-2); }
  .hl__vybrano { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 1rem; border-radius: 14px; background: var(--plocha-2); border: 1px solid var(--line); font-weight: 800; }
  .hl__pozn { color: var(--orange-text); }
  .hl__vysledky { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--stin); padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column; gap: 1rem; }
  .hl__vysledky h3 { font-size: 1.15rem; }
  .hl__poradi { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; }
  :global(.hl__poradi .radek) { display: grid; grid-template-columns: 1.6rem 28px minmax(90px, 190px) minmax(0, 1fr) 3.2rem; gap: 0.6rem; align-items: center; font-weight: 700; font-size: 0.92rem; }
  :global(.hl__poradi .poz) { color: var(--muted); font-size: 0.85rem; text-align: right; }
  :global(.hl__poradi .jm) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.hl__poradi .draha) { height: 16px; border-radius: 999px; background: var(--draha); overflow: hidden; }
  :global(.hl__poradi .pruh) { display: block; height: 100%; border-radius: 999px; background: var(--navy); transform-origin: left; animation: hl-rust 1.2s cubic-bezier(0.22, 0.8, 0.24, 1) both; }
  :global(.hl__poradi .radek--muj .pruh) { background: var(--slate); }
  :global(.hl__poradi .tvuj) { margin-left: 0.4rem; padding: 0.1rem 0.45rem; border-radius: 999px; background: var(--plocha-2); border: 1px solid var(--line); font-size: 0.68rem; font-weight: 800; color: var(--muted); vertical-align: middle; }
  :global(.hl__poradi .hlasy) { text-align: right; font-variant-numeric: tabular-nums; font-weight: 800; }
  @keyframes hl-rust { from { transform: scaleX(0); } }
  @media (prefers-reduced-motion: reduce) { :global(.hl__poradi .pruh) { animation: none; } }
</style>

<script>
  type Moznost = { a3: string; n: string; a2: string };
  const koren = document.querySelector<HTMLElement>('[data-hlasovani]');
  if (koren) {
    const N = JSON.parse(koren.dataset.nastaveni!) as { formular: string; pole: string; vysledky: string; zapnute: boolean; moznosti: Moznost[] };
    const podleKodu = new Map(N.moznosti.map((m) => [m.a3, m]));
    const $ = <T extends Element>(s: string) => koren.querySelector<T>(s)!;
    const vstup = $<HTMLInputElement>('[data-vstup]');
    const seznam = $<HTMLElement>('[data-seznam]');
    const vybranoEl = $<HTMLElement>('[data-vybrano]');
    const odeslat = $<HTMLButtonElement>('[data-odeslat]');
    const stav = $<HTMLElement>('[data-stav]');
    const poradiEl = $<HTMLElement>('[data-poradi]');
    const celkemEl = $<HTMLElement>('[data-celkem]');
    const KLIC = 'dc-hlas';
    const MESIC = 30 * 24 * 3600 * 1000;
    let vybrana: Moznost | null = null;
    let aktivni = -1;
    let vysledky: [string, number][] = [];

    const bezDiakritiky = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const vlajka = (a2: string) => {
      const i = document.createElement('img');
      i.src = `/vlajky/${a2}.svg`; i.alt = ''; i.className = 'vlajka'; i.loading = 'lazy';
      return i;
    };
    const muj = (): { a3: string; cas: number } | null => {
      try { const x = JSON.parse(localStorage.getItem(KLIC) ?? 'null'); return x && Date.now() - x.cas < MESIC ? x : null; } catch { return null; }
    };

    function nabidni() {
      const q = bezDiakritiky(vstup.value.trim());
      const shody = q ? N.moznosti.filter((m) => bezDiakritiky(m.n).includes(q)).sort((a, b) => Number(!bezDiakritiky(a.n).startsWith(q)) - Number(!bezDiakritiky(b.n).startsWith(q))).slice(0, 7) : [];
      aktivni = shody.length ? 0 : -1;
      seznam.replaceChildren(...shody.map((m, i) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button'; b.setAttribute('role', 'option'); b.setAttribute('aria-selected', String(i === aktivni));
        b.append(vlajka(m.a2), m.n);
        b.addEventListener('mousedown', (e) => { e.preventDefault(); vyber(m); });
        li.append(b);
        return li;
      }));
      seznam.hidden = shody.length === 0;
      vstup.setAttribute('aria-expanded', String(!seznam.hidden));
    }
    function vyber(m: Moznost) {
      vybrana = m;
      vstup.value = m.n;
      seznam.hidden = true;
      vstup.setAttribute('aria-expanded', 'false');
      vybranoEl.hidden = false;
      vybranoEl.replaceChildren(vlajka(m.a2), m.n);
      odeslat.disabled = !N.zapnute || !!muj();
    }
    vstup.addEventListener('input', () => { vybrana = null; vybranoEl.hidden = true; odeslat.disabled = true; nabidni(); });
    vstup.addEventListener('keydown', (e) => {
      const tl = Array.from(seznam.querySelectorAll('button'));
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!tl.length) return;
        aktivni = (aktivni + (e.key === 'ArrowDown' ? 1 : -1) + tl.length) % tl.length;
        tl.forEach((b, i) => b.setAttribute('aria-selected', String(i === aktivni)));
      } else if (e.key === 'Enter' && aktivni >= 0 && tl[aktivni]) {
        e.preventDefault();
        tl[aktivni].dispatchEvent(new MouseEvent('mousedown'));
      } else if (e.key === 'Escape') seznam.hidden = true;
    });
    vstup.addEventListener('blur', () => setTimeout(() => (seznam.hidden = true), 120));

    function vykresli() {
      const m = muj();
      const data = vysledky.filter(([k]) => podleKodu.has(k));
      const celkem = data.reduce((s, [, n]) => s + n, 0);
      celkemEl.textContent = celkem ? `${celkem} ${celkem === 1 ? 'hlas' : celkem < 5 ? 'hlasy' : 'hlasů'}` : '';
      if (!data.length) {
        const li = document.createElement('li');
        li.className = 'drobne';
        li.textContent = 'Zatím nikdo nehlasoval. Buď první.';
        poradiEl.replaceChildren(li);
        return;
      }
      const top = data.slice(0, 8);
      const max = top[0][1];
      poradiEl.replaceChildren(...top.map(([k, n], i) => {
        const z = podleKodu.get(k)!;
        const li = document.createElement('li');
        li.className = 'radek' + (m?.a3 === k ? ' radek--muj' : '');
        const poz = document.createElement('span'); poz.className = 'poz'; poz.textContent = `${i + 1}.`;
        const jm = document.createElement('span'); jm.className = 'jm'; jm.textContent = z.n;
        if (m?.a3 === k) { const t = document.createElement('span'); t.className = 'tvuj'; t.textContent = 'tvůj hlas'; jm.append(t); }
        const draha = document.createElement('span'); draha.className = 'draha';
        const pruh = document.createElement('span'); pruh.className = 'pruh'; pruh.style.width = `${(n / max) * 100}%`; pruh.style.animationDelay = `${i * 90}ms`;
        draha.append(pruh);
        const h = document.createElement('span'); h.className = 'hlasy'; h.textContent = String(n);
        li.append(poz, vlajka(z.a2), jm, draha, h);
        return li;
      }));
    }

    async function nacti() {
      if (!N.zapnute) { vysledky = []; return vykresli(); }
      try {
        const odp = await fetch(`${N.vysledky}${N.vysledky.includes('?') ? '&' : '?'}t=${Math.floor(Date.now() / 60000)}`);
        const text = await odp.text();
        if (!odp.ok || text.trimStart().startsWith('<')) throw new Error('Tabulka nevrátila CSV');
        // V tabulce je kód země (JPN). Kdyby tam někdo ručně napsal název („Čína“), přiřadí se taky.
        const podleJmena = new Map(N.moznosti.map((x) => [bezDiakritiky(x.n), x.a3]));
        const pocty = new Map<string, number>();
        for (const radek of text.split(/\r?\n/).slice(1)) {
          const [hodnota, n] = radek.split(',').map((s) => s.replace(/"/g, '').trim());
          const c = Number(n);
          if (!hodnota || !Number.isFinite(c) || c <= 0) continue;
          const kod = podleKodu.has(hodnota.toUpperCase()) ? hodnota.toUpperCase() : podleJmena.get(bezDiakritiky(hodnota));
          if (kod) pocty.set(kod, (pocty.get(kod) ?? 0) + c);
        }
        // Vlastní hlas se v tabulce Google objeví se zpožděním, proto ho přičteme hned.
        const m = muj();
        if (m && sessionStorage.getItem('dc-hlas-cerstvy') === m.a3) pocty.set(m.a3, (pocty.get(m.a3) ?? 0) + 1);
        vysledky = [...pocty.entries()].sort((a, b) => b[1] - a[1] || podleKodu.get(a[0])!.n.localeCompare(podleKodu.get(b[0])!.n, 'cs'));
        vykresli();
      } catch {
        poradiEl.replaceChildren(Object.assign(document.createElement('li'), { className: 'drobne', textContent: 'Výsledky se teď nepodařilo načíst.' }));
      }
    }

    odeslat.addEventListener('click', async () => {
      if (!vybrana || !N.zapnute || muj()) return;
      odeslat.disabled = true;
      stav.textContent = 'Odesílám…';
      try {
        const data = new URLSearchParams({ [N.pole]: vybrana.a3 });
        await fetch(N.formular, { method: 'POST', mode: 'no-cors', body: data });
        try {
          localStorage.setItem(KLIC, JSON.stringify({ a3: vybrana.a3, cas: Date.now() }));
          sessionStorage.setItem('dc-hlas-cerstvy', vybrana.a3);
        } catch {}
        stav.textContent = `Díky! Tvůj hlas pro ${vybrana.n} je započítaný.`;
        const i = vysledky.findIndex(([k]) => k === vybrana!.a3);
        if (i >= 0) vysledky[i] = [vysledky[i][0], vysledky[i][1] + 1]; else vysledky.push([vybrana.a3, 1]);
        vysledky.sort((a, b) => b[1] - a[1]);
        vykresli();
      } catch {
        stav.textContent = 'Hlas se nepodařilo odeslat. Zkus to prosím za chvíli.';
        odeslat.disabled = false;
      }
    });

    const m = muj();
    if (m && podleKodu.has(m.a3)) stav.textContent = `Už jsi hlasoval(a) pro ${podleKodu.get(m.a3)!.n}. Další hlas půjde za ${Math.ceil((MESIC - (Date.now() - m.cas)) / 86400000)} dní.`;
    nacti();
  }
</script>
