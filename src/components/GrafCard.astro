---
import BarChart from './BarChart.astro';

interface Props {
  id: string;
  data: any;
}

const { id, data } = Astro.props;
const nahled = data.polozky.slice(0, 4);
const hledani = `${data.titul} ${data.perex} ${data.tema}`;
---

<li class="karta-grafu" data-tema={data.tema} data-hledani={hledani}>
  <a href={`/grafy/${id}/`}>
    <div class="karta-grafu__nahled">
      <BarChart polozky={nahled} jednotka={data.jednotka} kompaktni={true} />
    </div>
    <div class="karta-grafu__text">
      <span class="stitek">{data.tema}</span>
      <h3>{data.titul}</h3>
      <p class="drobne">{data.perex}</p>
    </div>
  </a>
</li>

<style>
  .karta-grafu {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .karta-grafu a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--navy);
  }
  .karta-grafu__nahled {
    padding: 1.25rem;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    min-height: 150px;
    display: flex;
    align-items: center;
  }
  .karta-grafu__nahled > * { width: 100%; }
  .karta-grafu__text { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem; }
  .karta-grafu h3 { font-size: 1.15rem; font-weight: 800; }
  .karta-grafu[hidden] { display: none; }
</style>
