---
import BarChart from './BarChart.astro';
import { datum } from '../lib/format';

interface Props {
  id: string;
  data: any;
  radku?: number;
}

const { id, data, radku = 7 } = Astro.props;
const hledani = `${data.titul} ${data.perex} ${data.tema} ${data.serie ?? ''}`;
// Česko v grafu necháme vždy vidět, i když je níž než první řádky.
const polozky = (() => {
  const prvni = data.polozky.slice(0, radku);
  const cesko = data.polozky.find((p: any) => p.kategorie === 'Česko');
  return cesko && !prvni.includes(cesko) ? [...prvni.slice(0, radku - 1), cesko] : prvni;
})();
---

<li class="kg" data-tema={data.tema} data-hledani={hledani}>
  <a href={`/grafy/${id}/`} class="kg__odkaz">
    <div class="kg__hlava">
      <span class="stitek">{data.tema}</span>
      <h3>{data.titul}</h3>
      {data.popisGrafu && <p class="drobne kg__popis">{data.popisGrafu}</p>}
      {(data.vyvoj || data.porovnej) && (
        <span class="kg__umi">
          {data.vyvoj && <span>Vývoj v čase</span>}
          {data.porovnej && <span>Porovnej se</span>}
        </span>
      )}
    </div>
    <div class="kg__graf">
      {data.obrazek ? (
        <img src={data.obrazek} alt="" loading="lazy" />
      ) : (
        <BarChart polozky={polozky} barvy={data.barvy} desetinna={data.desetinna} velikost="mala" />
      )}
    </div>
    <div class="kg__pata">
      <span>Zdroj: {data.zdroj}</span>
      <span>{datum(data.datum)}</span>
    </div>
  </a>
</li>

<style>
  .kg { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--stin-maly); overflow: hidden; transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out); }
  /* Zvednutí jen pod myší; na dotyku by karta po ťuknutí zůstala viset nahoře */
  @media (hover: hover) and (pointer: fine) { .kg:hover { transform: translateY(-3px); box-shadow: var(--stin); } }
  .kg:active { transform: scale(0.985); transition-duration: 80ms; }
  .kg__odkaz { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--navy); -webkit-touch-callout: none; }
  .kg__odkaz:hover { color: var(--navy); }
  .kg__hlava { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.3rem 1.3rem 0; }
  .kg__hlava h3 { font-size: 1.12rem; line-height: 1.4; }
  .kg__popis { font-size: 0.82rem; line-height: 1.5; }
  .kg__umi { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.2rem; }
  .kg__umi span { padding: 0.12rem 0.55rem; border-radius: 999px; background: #FDF0E3; color: var(--orange-text); font-size: 0.72rem; font-weight: 800; }
  .kg__graf { flex-grow: 1; display: flex; align-items: center; padding: 1.1rem 1.3rem 1.2rem; }
  .kg__graf img { width: 100%; border-radius: 10px; }
  .kg__pata { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 1.3rem; border-top: 1px solid var(--line); background: var(--plocha-2); font-size: 0.78rem; font-weight: 600; color: var(--muted); }
  .kg__pata span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .kg__pata span:last-child { flex-shrink: 0; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .kg { transition: none; } .kg:hover, .kg:active { transform: none; } }
</style>
