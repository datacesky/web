---
import BarChart from './BarChart.astro';

interface Props {
  id: string;
  data: any;
}

const { id, data } = Astro.props;
const hledani = `${data.titul} ${data.perex} ${data.tema} ${data.serie ?? ''}`;
---

<li class="kg" data-tema={data.tema} data-hledani={hledani}>
  <a href={`/grafy/${id}/`} class="kg__odkaz">
    <div class="kg__nahled">
      {data.obrazek ? (
        <img src={data.obrazek} alt="" loading="lazy" />
      ) : (
        <BarChart polozky={data.polozky.slice(0, 6)} barvy={data.barvy} desetinna={data.desetinna} velikost="mala" />
      )}
    </div>
    <div class="kg__text">
      <span class="stitek">{data.tema}</span>
      <h3>{data.titul}</h3>
      <p class="drobne">{data.perex}</p>
    </div>
  </a>
</li>

<style>
  .kg { background: var(--paper); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .kg:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(27, 42, 74, 0.08); }
  .kg__odkaz { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--navy); }
  .kg__odkaz:hover { color: var(--navy); }
  .kg__nahled { height: 190px; display: flex; align-items: center; padding: 1.1rem 1.1rem; background: var(--cream); border-bottom: 1px solid var(--line); }
  .kg__nahled img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
  .kg__text { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem 1.25rem 1.5rem; }
  .kg__text h3 { font-size: 1.12rem; line-height: 1.35; }
  @media (prefers-reduced-motion: reduce) { .kg { transition: none; } .kg:hover { transform: none; } }
</style>
