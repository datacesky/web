---
// Obálka dílu ve stylu příspěvků @data.cesky (9:16 jako reel): krémové pozadí s vrstevnicemi, název série,
// číslo dílu a vodoznak. Když v public/serie/ leží vlastní náhledovka (třeba cesko-vs-svet-9.jpg),
// použije se místo vygenerované obálky.
import fs from 'node:fs';
import path from 'node:path';
import { vlajka } from '../lib/svet';
import { ikona } from '../lib/ikony';

interface Props {
  slug: string;
  serie: string;
  typ: 'vs' | 'index' | 'sto';
  dil?: number;
  nazev: string;
  a3?: string;
  ikonaId?: string;
  velka?: boolean;
}
const { slug, serie, typ, dil, nazev, a3, ikonaId, velka = false } = Astro.props;
const vlastni = ['webp', 'jpg', 'jpeg', 'png'].map((p) => `${slug}.${p}`).find((f) => fs.existsSync(path.join(process.cwd(), 'public', 'serie', f)));
// Vlastní obálka pro 100 lidí: mřížka 10×10, jeden člověk zvýrazněný
const lide = Array.from({ length: 100 }, (_, i) => i);
---

<div class:list={['so', `so--${typ}`, { 'so--velka': velka, 'so--foto': vlastni }]}>
  {vlastni ? (
    <img src={`/serie/${vlastni}`} alt="" loading="lazy" decoding="async" />
  ) : (
    <div class="so__plocha" aria-hidden="true">
      <span class="so__serie">{serie}</span>
      {dil && <span class="so__dil">Díl {dil}</span>}
      <div class="so__stred">
        {typ === 'vs' && a3 && (
          <div class="so__vs">
            <img src={vlajka('CZE')} alt="" class="so__vlajka" />
            <span class="so__vs-znak">vs</span>
            <img src={vlajka(a3)} alt="" class="so__vlajka" />
          </div>
        )}
        {typ === 'index' && (
          <span class="so__ikona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ikona(ikonaId)} /></svg></span>
        )}
        {typ === 'sto' && (
          <span class="so__lide">{lide.map((i) => <i class:list={{ 'je-oranzovy': i === 44 }}></i>)}</span>
        )}
        <span class="so__nazev">{nazev}</span>
      </div>
      <span class="so__vodoznak"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8" /></svg><span>@data<b>.cesky</b></span></span>
    </div>
  )}
  <span class="so__prehrat" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
</div>

<style>
  .so { position: relative; aspect-ratio: 9 / 16; border-radius: 18px; overflow: hidden; background: var(--cream); box-shadow: 0 0 0 1px rgba(226, 217, 201, 0.9), 0 10px 26px -14px rgba(27, 42, 74, 0.4); container-type: inline-size; isolation: isolate; }
  .so > img { width: 100%; height: 100%; object-fit: cover; }
  .so__plocha { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; padding: 9cqi 7cqi 7cqi; text-align: center; color: var(--navy); }
  .so__plocha::before { content: ''; position: absolute; inset: 0; z-index: -1; background: url('/vrstevnice.svg') center / 260% auto no-repeat; opacity: 0.75; }
  .so__plocha::after { content: ''; position: absolute; left: 50%; top: 52%; z-index: -1; width: 90cqi; height: 90cqi; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(240, 136, 41, 0.22), rgba(240, 136, 41, 0) 65%); }
  .so__serie { font-size: 6.2cqi; font-weight: 900; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.25; }
  .so__dil { margin-top: 2.5cqi; padding: 1.2cqi 4cqi; border-radius: 999px; background: var(--navy); color: var(--orange); font-size: 5.6cqi; font-weight: 900; }
  .so__stred { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6cqi; width: 100%; }
  .so__vs { display: flex; align-items: center; gap: 3cqi; }
  .so__vlajka { width: 30cqi; height: 21cqi; object-fit: cover; border-radius: 3.5cqi; box-shadow: 0 0 0 0.6cqi #fff, 0 3cqi 6cqi -2cqi rgba(27, 42, 74, 0.45); }
  .so__vs-znak { display: grid; place-items: center; width: 13cqi; height: 13cqi; border-radius: 50%; background: var(--orange); color: var(--navy); font-size: 5.6cqi; font-weight: 900; box-shadow: 0 0 0 1.4cqi rgba(240, 136, 41, 0.25); }
  .so__nazev { display: flex; flex-direction: column; font-size: 10.5cqi; font-weight: 900; line-height: 1.15; text-transform: uppercase; letter-spacing: -0.01em; text-wrap: balance; overflow-wrap: anywhere; }
  .so--index .so__nazev, .so--sto .so__nazev { font-size: 9cqi; }
  .so__ikona { display: grid; place-items: center; width: 34cqi; height: 34cqi; border-radius: 10cqi; background: var(--navy); color: var(--orange); box-shadow: 0 4cqi 10cqi -3cqi rgba(27, 42, 74, 0.5); }
  .so__ikona svg { width: 58%; height: 58%; }
  .so__lide { display: grid; grid-template-columns: repeat(10, 1fr); gap: 1.6cqi; width: 58cqi; }
  .so__lide i { aspect-ratio: 1; border-radius: 50%; background: var(--navy); opacity: 0.85; }
  .so__lide i.je-oranzovy { background: var(--orange); opacity: 1; box-shadow: 0 0 0 1cqi rgba(240, 136, 41, 0.3); }
  .so__vodoznak { align-self: flex-end; display: inline-flex; align-items: center; gap: 1.4cqi; padding: 1.6cqi 3.6cqi; border-radius: 999px; background: rgba(255, 255, 255, 0.85); box-shadow: 0 0 0 0.4cqi rgba(226, 217, 201, 0.9); font-size: 4.6cqi; font-weight: 800; }
  .so__vodoznak svg { width: 5cqi; height: 5cqi; color: var(--orange); }
  .so__vodoznak b { color: var(--orange); font-weight: 800; }
  .so__prehrat { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 22cqi; height: 22cqi; border-radius: 50%; background: rgba(27, 42, 74, 0.82); color: var(--cream); transform: translate(-50%, -50%) scale(0.8); opacity: 0; transition: opacity 0.25s var(--ease-out), transform 0.3s var(--ease-out); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .so__prehrat svg { width: 46%; height: 46%; margin-left: 6%; }
  :global(a:hover) > .so .so__prehrat, :global(a:focus-visible) > .so .so__prehrat { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  @media (hover: none) { .so__prehrat { opacity: 0.9; transform: translate(-50%, -50%) scale(0.7); top: auto; bottom: 4cqi; left: 4cqi; transform: none; width: 15cqi; height: 15cqi; } }
</style>
