---
// Piktogramy: počet jako řada ikon (1 ikona = N kusů). Zbytek se zaokrouhlí na půl ikony,
// přesné číslo je vždy vedle řady. Na úzkém displeji ikona znamená dvojnásobek, aby se řada vešla na řádek.
import { barvaKategorie, cislo } from '../lib/format';

interface Props {
  polozky: { nazev: string; hodnota: number; kategorie?: string }[];
  barvy?: Record<string, string>;
  jednotka: string;
  // kolik kusů je jedna ikona na širokém displeji
  zaIkonu: number;
}
const { polozky, barvy = {}, jednotka, zaIkonu } = Astro.props;
const serazene = [...polozky].sort((a, b) => b.hodnota - a.hodnota);
const data = JSON.stringify(serazene.map((p) => ({ ...p, barva: barvaKategorie(p.kategorie, barvy) })));
const celkem = polozky.reduce((s, p) => s + p.hodnota, 0);
---

<div class="pk" data-pk data-polozky={data} data-za-ikonu={zaIkonu}>
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
    <symbol id="pk-kosik" viewBox="0 0 24 24">
      <path d="M2.5 3.5h2.6l2.2 11.2a1.6 1.6 0 0 0 1.6 1.3h8.7a1.6 1.6 0 0 0 1.6-1.2l1.7-6.8H6.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="9.6" cy="20" r="1.7" fill="currentColor" />
      <circle cx="17.2" cy="20" r="1.7" fill="currentColor" />
    </symbol>
  </svg>
  <p class="pk__legenda"><svg class="pk__ikona" aria-hidden="true"><use href="#pk-kosik" /></svg> = <span data-pk-jednotka>{zaIkonu}</span> {jednotka}</p>
  <ul class="pk__radky">
    {serazene.map((p) => (
      <li class="pk__radek" aria-label={`${p.nazev}: ${cislo(p.hodnota)} ${jednotka}`}>
        <span class="pk__nazev">{p.nazev}</span>
        <span class="pk__ikony" aria-hidden="true" data-pk-ikony style={`color: ${barvaKategorie(p.kategorie, barvy)};`}></span>
        <span class="pk__hodnota">{cislo(p.hodnota)}</span>
      </li>
    ))}
  </ul>
  <p class="drobne">Dohromady {cislo(celkem)} {jednotka}. Řady ikon jsou zaokrouhlené na půl ikony, přesné číslo je na konci řádku.</p>
</div>

<style>
  .pk { display: flex; flex-direction: column; gap: 1rem; --ikona: 18px; }
  .pk__legenda { display: inline-flex; align-items: center; gap: 0.35rem; align-self: flex-end; padding: 0.3rem 0.8rem; border-radius: 999px; background: var(--plocha-2); font-size: 0.85rem; font-weight: 800; color: var(--text-2); }
  .pk__legenda .pk__ikona { color: var(--navy); }
  .pk__ikona { width: 18px; height: 18px; flex-shrink: 0; }
  .pk__radky { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .pk__radek { display: grid; grid-template-columns: minmax(70px, 110px) minmax(0, 1fr) 3rem; gap: 0.8rem; align-items: center; }
  .pk__nazev { text-align: right; font-weight: 800; font-size: 0.95rem; }
  .pk__ikony { display: flex; flex-wrap: wrap; gap: 3px; min-height: 18px; }
  .pk__pozn { font-size: 0.8rem; }
  .pk__hodnota { font-weight: 900; font-variant-numeric: tabular-nums; }
  :global(.pk__cast) { display: inline-block; width: var(--ikona); height: var(--ikona); overflow: hidden; flex-shrink: 0; }
  :global(.pk__cast--pul) { width: calc(var(--ikona) / 2); }
  :global(.pk__cast svg) { width: var(--ikona); height: var(--ikona); display: block; }
  /* Ikony naskakují postupně, až graf vjede do obrazu */
  :global(.js) .pk__ikony :global(.pk__cast) { opacity: 0; transform: scale(0.6); }
  :global(.js) .pk:global(.odhal--videt) .pk__ikony :global(.pk__cast) { opacity: 1; transform: none; transition: opacity 0.3s ease, transform 0.35s var(--ease-out); transition-delay: calc(var(--i) * 14ms + var(--r) * 90ms); }
  @media (max-width: 560px) {
    .pk { --ikona: 15px; }
    .pk__ikony { gap: 2px; }
    .pk__radek { grid-template-columns: 70px minmax(0, 1fr) 2.4rem; gap: 0.55rem; }
    .pk__nazev { font-size: 0.85rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .pk__ikony :global(.pk__cast) { opacity: 1; transform: none; transition: none !important; }
  }
</style>

<script>
  for (const koren of document.querySelectorAll<HTMLElement>('[data-pk]')) {
    const polozky = JSON.parse(koren.dataset.polozky!) as { nazev: string; hodnota: number }[];
    const zaIkonu = Number(koren.dataset.zaIkonu);
    const radky = Array.from(koren.querySelectorAll<HTMLElement>('[data-pk-ikony]'));
    const uzky = matchMedia('(max-width: 560px)');
    // na mobilu znamená ikona dva a půl násobek (20 → 50), aby se nejdelší řada vešla na jeden řádek
    koren.classList.add('odhal-graf');
    function kresli() {
      const n = uzky.matches ? zaIkonu * 2.5 : zaIkonu;
      koren.querySelector<HTMLElement>('[data-pk-jednotka]')!.textContent = String(n);
      radky.forEach((el, r) => {
        // na půl ikony: zbytek pod čtvrtinu se vynechá, do tří čtvrtin je půlka, nad to celá ikona
        const pulky = Math.round((polozky[r].hodnota / n) * 2);
        const cele = Math.floor(pulky / 2);
        const pul = pulky % 2 === 1;
        const kusy: HTMLElement[] = [];
        for (let i = 0; i < cele + (pul ? 1 : 0); i++) {
          const span = document.createElement('span');
          span.className = i < cele ? 'pk__cast' : 'pk__cast pk__cast--pul';
          span.style.setProperty('--i', String(i));
          span.style.setProperty('--r', String(r));
          span.innerHTML = '<svg aria-hidden="true"><use href="#pk-kosik"/></svg>';
          kusy.push(span);
        }
        el.replaceChildren(...kusy);
      });
    }
    kresli();
    uzky.addEventListener('change', kresli);
    // spustí postupné naskakování, když je graf vidět (stejně jako u pruhů)
    if ('IntersectionObserver' in window) {
      const o = new IntersectionObserver(([z]) => { if (z.isIntersecting) { koren.classList.add('odhal--videt'); o.disconnect(); } }, { rootMargin: '0px 0px -10% 0px' });
      o.observe(koren);
    } else koren.classList.add('odhal--videt');
  }
</script>
