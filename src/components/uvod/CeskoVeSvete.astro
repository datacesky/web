---
// Kde je Česko ve světových žebříčcích: seznam žebříčků, rozbalí se vždy jen ten, na který klikneš.
// Uvnitř: kde leží Česko mezi všemi zeměmi, první místa, sousedé v pořadí a odkaz na glóbus.
import { vrstvaPodleId, zebricek, pocet, poradiZeme, jmeno, vlajka } from '../../lib/svet';

const IDS = ['stesti', 'tisk', 'korupce', 'akad', 'gini', 'hdp', 'doziti', 'bm'];
const radky = IDS.map((id) => {
  const v = vrstvaPodleId(id)!;
  const z = zebricek(id);
  const n = pocet(id);
  const r = poradiZeme(id, 'CZE')!;
  const x = (k: number) => (n <= 1 ? 0 : ((k - 1) / (n - 1)) * 100);
  const f = v.kratce ?? v.format;
  const iCz = z.findIndex((q) => q.a3 === 'CZE');
  const okoli = z.slice(Math.max(0, iCz - 2), iCz + 3);
  return {
    id,
    nazev: v.nazev,
    popis: v.popis,
    ikona: v.ikona,
    obdobi: v.obdobi,
    zdroj: v.zdroj,
    zdrojUrl: v.zdrojUrl,
    zdrojKratce: v.zdroj.split(',')[0].split('(')[0].trim(),
    r,
    n,
    slovo: v.poradiSlovo,
    poloha: x(r),
    carky: z.map((q) => x(q.r)),
    prvni: z.slice(0, 5).map((q) => ({ ...q, t: f(q.v) })),
    okoli: okoli.map((q) => ({ ...q, t: f(q.v) })),
    hodnotaCz: f(z[iCz].v),
    posledni: z.at(-1)!,
  };
});
---

<div class="zb-seznam">
  {radky.map((r, i) => (
    <details class="zb" name="zebricky" open={i === 0} style={`--x: ${r.poloha}%;`}>
      <summary class="zb__hlava">
        <span class="zb__ikona" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={r.ikona} /></svg>
        </span>
        <span class="zb__nazev">
          <strong>{r.nazev}</strong>
          <small>{r.zdrojKratce}{r.obdobi && r.id !== 'gini' ? `, ${r.obdobi}` : ''}</small>
        </span>
        <span class="zb__misto"><strong>{r.r}.</strong><small>{r.slovo} z {r.n}</small></span>
        <span class="zb__sipka" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
        </span>
      </summary>

      <div class="zb__telo">
        <p class="zb__popis">{r.popis}</p>

        <div class="zb__osa" aria-hidden="true">
          <svg viewBox="0 0 1000 30" preserveAspectRatio="none">
            <line x1="0" y1="15" x2="1000" y2="15" stroke="#E2D9C9" stroke-width="2" vector-effect="non-scaling-stroke" />
            {r.carky.map((x) => <line x1={x * 10} y1="7" x2={x * 10} y2="23" stroke="#1B2A4A" stroke-opacity="0.22" stroke-width="1.4" vector-effect="non-scaling-stroke" />)}
          </svg>
          <span class="zb__bod"><span>Česko {r.r}.</span></span>
          <span class="zb__kraj zb__kraj--l"><img src={vlajka(r.prvni[0].a3)} alt="" class="vlajka" width="18" height="13" loading="lazy" />1. {jmeno(r.prvni[0].a3)}</span>
          <span class="zb__kraj zb__kraj--p">{r.n}. {jmeno(r.posledni.a3)}</span>
        </div>

        <div class="zb__dve">
          <div class="zb__blok">
            <span class="zb__blok-titul">Nejvýš v žebříčku</span>
            <ol class="zb__list">
              {r.prvni.map((q) => (
                <li class:list={{ 'je-cz': q.a3 === 'CZE' }}>
                  <span class="p">{q.r}.</span>
                  <img src={vlajka(q.a3)} alt="" class="vlajka" width="22" height="16" loading="lazy" />
                  <span class="j">{jmeno(q.a3)}</span>
                  <span class="h">{q.t}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="zb__blok">
            <span class="zb__blok-titul">Česko a jeho sousedé v pořadí</span>
            <ol class="zb__list">
              {r.okoli.map((q) => (
                <li class:list={{ 'je-cz': q.a3 === 'CZE' }}>
                  <span class="p">{q.r}.</span>
                  <img src={vlajka(q.a3)} alt="" class="vlajka" width="22" height="16" loading="lazy" />
                  <span class="j">{jmeno(q.a3)}</span>
                  <span class="h">{q.t}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="zb__pata">
          <span class="drobne">Zdroj: <a href={r.zdrojUrl}>{r.zdroj}</a></span>
          <a class="tlacitko tlacitko--male tlacitko--plny" href={`/svet/#v=${r.id}`}>Celý žebříček na glóbusu</a>
        </div>
      </div>
    </details>
  ))}
</div>

<style>
  .zb-seznam { display: flex; flex-direction: column; gap: 0.5rem; }
  .zb { border: 1px solid var(--line); border-radius: 18px; background: var(--paper); transition: box-shadow 0.25s ease, border-color 0.25s ease; }
  .zb[open] { border-color: var(--line-2); box-shadow: var(--stin); }
  .zb__hlava { list-style: none; display: grid; grid-template-columns: 44px minmax(0, 1fr) auto 28px; gap: 0.9rem; align-items: center; padding: 0.75rem 1rem; cursor: pointer; border-radius: 18px; }
  .zb__hlava::-webkit-details-marker { display: none; }
  .zb__hlava:hover { background: var(--plocha-2); }
  .zb__hlava:focus-visible { outline: 3px solid rgba(240, 136, 41, 0.5); outline-offset: 2px; }
  .zb__ikona { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--plocha-2); color: var(--slate); }
  .zb[open] .zb__ikona { background: var(--navy); color: var(--orange); }
  .zb__nazev { display: flex; flex-direction: column; min-width: 0; }
  .zb__nazev strong { font-size: 1.02rem; font-weight: 800; line-height: 1.35; }
  .zb__nazev small { font-size: 0.76rem; font-weight: 600; color: var(--muted); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .zb__misto { display: flex; align-items: baseline; gap: 0.4rem; white-space: nowrap; }
  .zb__misto strong { font-size: 1.5rem; font-weight: 900; color: var(--orange-text); line-height: 1; }
  .zb__misto small { font-size: 0.8rem; font-weight: 700; color: var(--muted); }
  @media (max-width: 560px) { .zb__misto small { display: none; } .zb__hlava { grid-template-columns: 38px minmax(0, 1fr) auto 22px; gap: 0.7rem; } .zb__ikona { width: 38px; height: 38px; } }
  .zb__sipka { color: var(--slate); display: grid; place-items: center; transition: transform 0.25s ease; }
  .zb[open] .zb__sipka { transform: rotate(180deg); }

  .zb__telo { padding: 0.25rem clamp(1rem, 3vw, 1.6rem) 1.3rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .zb__popis { margin: 0; font-size: 0.95rem; color: var(--text-2); max-width: 70ch; }
  .zb__osa { position: relative; height: 62px; display: block; margin-top: 0.5rem; }
  .zb__osa svg { position: absolute; left: 0; right: 0; top: 16px; width: 100%; height: 30px; }
  .zb__bod { position: absolute; top: 31px; left: var(--x); width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 5px rgba(240, 136, 41, 0.22), 0 2px 6px rgba(27, 42, 74, 0.25); }
  .zb[open] .zb__bod { animation: zb-jed 1.5s cubic-bezier(0.22, 0.8, 0.24, 1) both; }
  .zb__bod span { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); font-size: 0.8rem; font-weight: 900; color: var(--orange-text); white-space: nowrap; }
  .zb__kraj { position: absolute; bottom: -2px; display: flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; font-weight: 700; color: var(--muted); white-space: nowrap; }
  .zb__kraj .vlajka { width: 18px; height: 13px; border-radius: 2px; }
  .zb__kraj--l { left: 0; }
  .zb__kraj--p { right: 0; }
  @keyframes zb-jed { from { left: 0; opacity: 0; } 15% { opacity: 1; } }

  .zb__dve { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
  @media (max-width: 640px) { .zb__dve { grid-template-columns: 1fr; } }
  .zb__blok { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.9rem 1rem; border-radius: 14px; background: var(--plocha-2); }
  .zb__blok-titul { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .zb__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .zb__list li { display: grid; grid-template-columns: 2.2rem 22px minmax(0, 1fr) auto; gap: 0.55rem; align-items: center; padding: 0.28rem 0.45rem; border-radius: 9px; font-size: 0.88rem; font-weight: 700; }
  .zb__list .p { color: var(--muted); font-size: 0.8rem; text-align: right; }
  .zb__list .vlajka { width: 22px; height: 16px; border-radius: 3px; }
  .zb__list .j { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .zb__list .h { font-variant-numeric: tabular-nums; font-weight: 800; }
  .zb__list li.je-cz { background: var(--navy); color: var(--cream); }
  .zb__list li.je-cz .p { color: #F6C08C; }
  .zb__list li.je-cz .h { color: var(--orange); }
  .zb__pata { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between; padding-top: 1rem; border-top: 1px solid var(--line); }

  /* Plynulé rozbalení v prohlížečích, které to umí */
  @supports (interpolate-size: allow-keywords) {
    .zb { interpolate-size: allow-keywords; }
    .zb::details-content { block-size: 0; overflow: hidden; transition: block-size 0.35s ease, content-visibility 0.35s allow-discrete; }
    .zb[open]::details-content { block-size: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .zb[open] .zb__bod { animation: none; } .zb::details-content { transition: none; } }
</style>
