---
// Hra Vlajky světa: desková hra s kostkou, bleskovka, studovna a atlas karet se všemi 197 státy.
// Data (státy + mapa) jsou v public/data/hra-vlajky.json a stahují se až na této stránce.
// Vlajky se berou z public/vlajky/ (stejné jako na Světě), barvy z CSS proměnných webu,
// takže hra sama funguje ve světlém i tmavém vzhledu.
import Base from '../layouts/Base.astro';
---

<Base
  titul="Hra: Vlajky světa — data.cesky"
  popis="Desková hra s kostkou, bleskovka a kartičky se všemi 197 státy světa. Hlavní města, měny, jazyky, sousedé a poloha na mapě."
  obrazek="/og/hra.png"
>
  <section class="obal sekce--mala hra" data-hra>
    <div class="hra__hlava sloupec">
      <span class="nadhlavi">Hra</span>
      <h1>Vlajky světa</h1>
      <p class="perex">
        Všech 197 států na kartičkách. Hoď kostkou, hádej hlavní město, měnu, jazyk nebo sousedy a otoč kartu.
        Hraj s kamarády u jednoho telefonu, nebo si dej minutovou bleskovku.
      </p>
    </div>
    <div class="hra__app" data-hra-app aria-live="polite">
      <p class="drobne">Míchám karty…</p>
    </div>
  </section>
  <svg class="hra__defs" width="0" height="0" aria-hidden="true"><defs data-hra-defs></defs></svg>
  <div class="hra-modal" data-hra-modal hidden></div>
  <div class="hra-toast" data-hra-toast role="status"></div>
</Base>

<style is:global>
  .hra__hlava { gap: 0.6rem; max-width: 62ch; margin-bottom: 1.75rem; }
  .hra__hlava h1 { font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.12; }
  .hra.hraje .hra__hlava { display: none; }
  .hra.hraje { padding-top: clamp(0.75rem, 2vw, 1.75rem); }
  .hra__app { scroll-margin-top: calc(var(--hlavicka-vyska, 64px) + 12px); }
  .hra__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .hra svg { flex-shrink: 0; }

  /* Rozcestník */
  .hra-menu { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .hra-dl {
    position: relative; overflow: hidden; display: flex; align-items: center; gap: 1rem; padding: 1.1rem 1.2rem; border-radius: var(--radius);
    background: var(--paper); border: 1px solid var(--line); box-shadow: var(--stin-maly); color: var(--navy); text-align: left;
    font-family: inherit; cursor: pointer; transition: transform var(--stisk) var(--ease-out), box-shadow 0.25s ease;
  }
  @media (hover: hover) and (pointer: fine) { .hra-dl:hover { transform: translateY(-2px); box-shadow: var(--stin); } }
  .hra-dl:active { transform: scale(0.98); }
  .hra-dl__ikona { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; flex: none; color: #fff; background: var(--ic); }
  .hra-dl b { display: block; font-size: 1.12rem; font-weight: 900; letter-spacing: -0.01em; line-height: 1.25; }
  .hra-dl small { display: block; font-size: 0.86rem; font-weight: 600; color: var(--muted); line-height: 1.45; margin-top: 2px; }
  .hra-dl--hlavni { grid-column: 1 / -1; min-height: 168px; padding: 1.4rem 1.5rem; background: var(--panel); border-color: var(--panel); color: var(--na-panelu); }
  .hra-dl--hlavni b { font-size: 1.45rem; }
  .hra-dl--hlavni small { color: var(--na-panelu-2); font-size: 0.92rem; max-width: 34ch; }
  .hra-dl--hlavni .hra-dl__ikona { background: var(--orange); color: var(--na-oranzove); }
  .hra-dl__text { position: relative; z-index: 1; display: block; }
  .hra-dl__cta { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.8rem; min-height: 40px; padding: 0 1rem; border-radius: 999px; background: var(--orange); color: var(--na-oranzove); font-weight: 800; font-size: 0.92rem; }
  .hra-vejir { position: absolute; right: 2rem; top: 50%; width: 190px; height: 150px; transform: translateY(-50%); pointer-events: none; }
  .hra-vejir span { position: absolute; left: 50%; top: 50%; width: 96px; height: 112px; margin: -56px 0 0 -48px; border-radius: 12px; background: var(--paper); box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5); display: grid; place-items: center; transform-origin: 50% 130%; }
  .hra-vejir span::before { content: ''; position: absolute; inset: 5px; border: 1.5px solid var(--line); border-radius: 8px; }
  .hra-vejir img { width: 74px; height: auto; border-radius: 3px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--navy) 12%, transparent); }
  .hra-vejir span:nth-child(1) { transform: rotate(-15deg) translateX(-14px); }
  .hra-vejir span:nth-child(2) { transform: translateY(-6px); z-index: 2; }
  .hra-vejir span:nth-child(3) { transform: rotate(15deg) translateX(14px); }
  @media (max-width: 620px) {
    .hra-dl--hlavni { flex-direction: column; align-items: flex-start; padding-top: 9.2rem; }
    .hra-vejir { right: 50%; top: 1rem; transform: translateX(50%) scale(0.85); transform-origin: 50% 0; }
  }
  .hra-pata { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; justify-content: space-between; align-items: center; }

  /* Horní lišta hry */
  .hra-lista { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.1rem; }
  .hra-kulate { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line); background: var(--paper); color: var(--navy); display: grid; place-items: center; cursor: pointer; padding: 0; box-shadow: var(--stin-maly); transition: transform var(--stisk) var(--ease-out); }
  .hra-kulate:active { transform: scale(0.94); }
  .hra-lista__titul { flex: 1; min-width: 0; font-weight: 900; font-size: 1.15rem; line-height: 1.2; letter-spacing: -0.01em; }
  .hra-lista__titul small { display: block; font-size: 0.78rem; font-weight: 700; color: var(--muted); letter-spacing: 0; }

  /* Panely nastavení */
  .hra-uzke { max-width: 640px; margin-inline: auto; }
  .hra-panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--stin-maly); padding: 1.1rem 1.2rem; margin-bottom: 0.9rem; }
  .hra-panel h3 { display: flex; align-items: center; gap: 0.5rem; font-size: 1.02rem; margin-bottom: 0.8rem; }
  .hra-panel h3 svg { color: var(--orange); }
  .hra-hraci { display: flex; flex-direction: column; gap: 0.55rem; margin-bottom: 0.8rem; }
  .hra-hrac-radek { display: flex; align-items: center; gap: 0.55rem; }
  .hra-hrac-radek i { width: 14px; height: 14px; border-radius: 50%; flex: none; background: var(--pc); }
  .hra .hra-hrac-radek input[type='text'] { width: 100%; min-height: 46px; font-weight: 700; }
  .hra-volba { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--line-jemna); }
  .hra-volba:first-of-type { border-top: 0; padding-top: 0.2rem; }
  .hra-volba b { display: block; font-size: 0.95rem; font-weight: 800; }
  .hra-volba small { display: block; font-size: 0.84rem; color: var(--muted); font-weight: 600; line-height: 1.45; }
  .hra-volba .segment { margin-top: 0.55rem; flex-wrap: wrap; }
  .hra .segment button { min-height: 36px; padding: 0 0.85rem; }
  .hra-pocet { font-size: 0.85rem; font-weight: 700; color: var(--muted); margin-top: 0.6rem; }

  /* Herní stůl */
  .hra-stul { display: grid; gap: 0.9rem; grid-template-areas: 'skore' 'karta' 'ovladani'; max-width: 1000px; margin-inline: auto; }
  .hra-stul__skore { grid-area: skore; min-width: 0; }
  .hra-stul__karta { grid-area: karta; min-width: 0; }
  .hra-stul__ovladani { grid-area: ovladani; min-width: 0; }
  @media (min-width: 900px) {
    .hra-stul { grid-template-columns: minmax(0, 400px) minmax(0, 1fr); grid-template-areas: 'karta skore' 'karta ovladani'; grid-template-rows: auto 1fr; column-gap: 2.5rem; align-items: start; }
    .hra-stul__karta { position: sticky; top: calc(var(--hlavicka-vyska, 64px) + 16px); }
  }
  .hra-skore { display: flex; gap: 0.5rem; overflow-x: auto; padding: 12px 2px 6px; margin-top: -10px; scrollbar-width: none; }
  .hra-skore::-webkit-scrollbar { display: none; }
  .hra-hrac { position: relative; flex: 1 0 auto; min-width: 84px; padding: 0.5rem 0.8rem; border-radius: 16px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--stin-maly); transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s var(--ease-out); }
  .hra-hrac.na-tahu { border-color: var(--navy); box-shadow: 0 0 0 1px var(--navy), var(--stin-maly); }
  .hra-hrac__jmeno { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; font-weight: 800; white-space: nowrap; max-width: 130px; overflow: hidden; text-overflow: ellipsis; }
  .hra-hrac__jmeno i { width: 9px; height: 9px; border-radius: 50%; background: var(--pc); flex: none; }
  .hra-hrac__body { display: flex; align-items: baseline; gap: 0.45rem; }
  .hra-hrac__body b { font-size: 1.55rem; font-weight: 900; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .hra-hrac__meta { display: inline-flex; align-items: center; gap: 2px; font-size: 0.72rem; font-weight: 800; color: var(--muted); }
  .hra-hrac__meta svg { width: 13px; height: 13px; }
  .hra-hrac__meta--serie { color: var(--orange-text); }
  .hra-bump { position: absolute; right: 8px; top: -10px; font-weight: 900; font-size: 1rem; color: var(--teal-text); animation: hra-bump 1.2s var(--ease-out) forwards; pointer-events: none; }
  .hra-bump.minus { color: var(--valka-text); }
  @keyframes hra-bump { 0% { opacity: 0; transform: translateY(8px) scale(0.6); } 20% { opacity: 1; transform: translateY(0) scale(1.15); } 100% { opacity: 0; transform: translateY(-18px); } }
  .hra-tah { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap; margin: 0.35rem 2px 0; }
  .hra-tah__kdo { font-weight: 900; }
  .hra-tah__kdo b { color: var(--pc); }

  /* Karta */
  .hra-karta-obal { perspective: 1500px; width: 100%; max-width: 400px; margin-inline: auto; }
  .hra-karta { position: relative; width: 100%; aspect-ratio: 5 / 6; transform-style: preserve-3d; transition: transform 0.75s cubic-bezier(0.35, 1.35, 0.5, 1); cursor: pointer; }
  .hra-karta.otocena { transform: rotateY(180deg); }
  .hra-karta.rozdat { animation: hra-rozdat 0.5s var(--ease-out); }
  @keyframes hra-rozdat { from { transform: translateX(60%) rotate(12deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .hra-karta { transition-duration: 0.01s; } .hra-karta.rozdat { animation: none; } }
  .hra-strana { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 22px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--stin-velky); overflow: hidden; color: var(--navy); }
  .hra-lic { display: flex; align-items: center; justify-content: center; padding: 1.5rem; isolation: isolate; }
  .hra-lic::before { content: ''; position: absolute; inset: 0; z-index: -1; background: url('/vrstevnice.svg') center / cover no-repeat; opacity: calc(0.55 * var(--vrstevnice-sila)); }
  .hra-lic::after { content: ''; position: absolute; inset: 10px; border: 1.5px solid var(--line); border-radius: 15px; pointer-events: none; }
  .hra-lic img { width: 84%; height: auto; border-radius: 6px; box-shadow: 0 14px 26px -12px rgba(var(--stin-barva), 0.55), 0 0 0 1px color-mix(in srgb, var(--navy) 12%, transparent); }
  .hra-lic__cislo { position: absolute; top: 22px; left: 24px; font-size: 0.76rem; font-weight: 800; color: var(--muted); letter-spacing: 0.06em; }
  .hra-lic__znacka { position: absolute; bottom: 19px; left: 0; right: 0; text-align: center; font-weight: 900; letter-spacing: -0.03em; font-size: 1rem; }
  .hra-lic__znacka span { color: var(--orange); }
  .hra-lic__tip { position: absolute; bottom: 44px; left: 0; right: 0; text-align: center; font-size: 0.74rem; font-weight: 700; color: var(--muted); }
  .hra-rub { transform: rotateY(180deg); display: flex; flex-direction: column; }
  .hra-rub__hlava { display: flex; align-items: center; gap: 0.7rem; padding: 0.75rem 1rem; background: var(--panel); color: var(--na-panelu); transition: background-color 0.3s ease, color 0.3s ease; }
  .hra-rub__hlava img { height: 26px; width: auto; border-radius: 4px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .hra-rub__nazev { flex: 1; font-weight: 900; font-size: 1.18rem; line-height: 1.15; letter-spacing: -0.01em; }
  .hra-rub__cislo { font-size: 0.7rem; font-weight: 800; opacity: 0.6; }
  .hra-rub__hlava.zvyr { background: var(--orange); color: var(--na-oranzove); }
  .hra-rub__mapa { position: relative; height: 31%; flex: none; background: var(--more-svetle); border-bottom: 1px solid var(--line); }
  .hra-rub__mapa > svg:first-child, .hra-otazka__mapa > svg:first-child { width: 100%; height: 100%; display: block; }
  .hra-vlozka { position: absolute; left: 8px; bottom: 8px; width: 30%; max-width: 116px; filter: drop-shadow(0 2px 4px rgba(var(--stin-barva), 0.3)); }
  .hra-radky { position: relative; flex: 1; overflow-y: auto; padding: 0.35rem 0.7rem 0.6rem; }
  .hra-radek { display: flex; gap: 0.65rem; align-items: flex-start; padding: 0.36rem 0.5rem; border-radius: 12px; border-left: 4px solid transparent; transition: background-color 0.3s ease; }
  .hra-radek__ikona { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; flex: none; background: var(--rc); color: #fff; margin-top: 1px; }
  .hra-radek__ikona svg { width: 16px; height: 16px; }
  .hra-radek__stitek { font-size: 0.64rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); line-height: 1.35; }
  .hra-radek__hodnota { font-weight: 800; font-size: 0.9rem; line-height: 1.3; }
  .hra-radek__hodnota small { display: block; font-weight: 600; font-size: 0.75rem; color: var(--muted); line-height: 1.35; margin-top: 1px; }
  .hra-radek.zvyr { background: color-mix(in srgb, var(--rc) 15%, var(--paper)); border-left-color: var(--rc); }
  .hra-radek.zvyr .hra-radek__hodnota { font-size: 1rem; }
  @media (max-width: 899px) {
    .hra-stul { gap: 0.7rem; }
    .hra-stul__karta .hra-karta { aspect-ratio: 1 / 1; }
    .hra-stul__karta .hra-rub__mapa { height: 28%; }
    .hra-radek { padding-block: 0.28rem; }
    .hra-hrac { padding: 0.4rem 0.7rem; min-width: 76px; }
    .hra-hrac__body b { font-size: 1.3rem; }
    .hra-scena { width: 60px; height: 60px; } .hra-scena--mala { width: 48px; height: 48px; }
    .hra-kostky { min-height: 74px; margin: 0.4rem 0 0; }
  }
  @media (max-width: 899px) and (max-height: 720px) { .hra-stul__karta .hra-karta-obal { max-width: 300px; } .hra-stul__karta .hra-rub__mapa { height: 26%; } }

  /* Kostky */
  .hra-kostky { display: flex; align-items: center; justify-content: center; gap: 1.1rem; min-height: 86px; margin: 0.6rem 0 0.2rem; }
  .hra-scena { perspective: 520px; width: 68px; height: 68px; flex: none; }
  .hra-scena--mala { width: 54px; height: 54px; }
  .hra-kostka { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transition: transform 1.15s cubic-bezier(0.2, 0.85, 0.25, 1); }
  .hra-stena { position: absolute; inset: 0; border-radius: 15px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; color: #fff; background: var(--sc); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.22), inset 0 -5px 0 rgba(0, 0, 0, 0.14); }
  .hra-stena small { font-size: 0.5rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1; }
  .hra-scena--mala .hra-stena { --sc: var(--panel); color: var(--na-panelu); border-radius: 12px; }
  .hra-scena--mala .hra-stena svg { color: var(--na-panelu-akcent); }
  .hra-scena--mala .hra-stena small { font-size: 0.45rem; }
  @media (max-height: 720px) and (max-width: 899px) { .hra-scena { width: 54px; height: 54px; } .hra-scena--mala { width: 44px; height: 44px; } .hra-kostky { min-height: 64px; } }

  .hra-vyzva-obal { text-align: center; min-height: 52px; margin: 0.5rem 0 0.9rem; }
  .hra-vyzva-obal:empty { min-height: 0; margin: 0.2rem 0; }
  .hra-vyzva { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1.15rem; border-radius: 999px; background: var(--rc); color: #fff; font-weight: 900; font-size: 1.1rem; letter-spacing: -0.005em; box-shadow: 0 8px 18px -10px var(--rc); animation: hra-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .hra-udalost { display: flex; align-items: center; justify-content: center; gap: 0.4rem; margin-top: 0.55rem; font-weight: 600; font-size: 0.88rem; color: var(--orange-text); }
  .hra-udalost b { font-weight: 800; }
  .hra-napoveda { color: var(--muted); font-weight: 600; font-size: 0.92rem; padding-top: 0.9rem; }
  @keyframes hra-pop { from { transform: scale(0.6); opacity: 0; } to { transform: none; opacity: 1; } }
  .hra-cas { height: 8px; border-radius: 99px; background: var(--line-jemna); overflow: hidden; margin: 0 0 0.9rem; }
  .hra-cas i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--teal), var(--orange), var(--valka)); transition: width 1s linear; }
  .hra-cas.vyprsel { animation: hra-tres 0.4s; }
  @keyframes hra-tres { 0%, 100% { transform: none; } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }

  .hra-ovl { display: grid; gap: 0.7rem; scroll-margin-bottom: 1rem; }
  @media (max-width: 760px) { .hra-ovl { scroll-margin-bottom: calc(104px + env(safe-area-inset-bottom)); } }
  .hra-dva { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .hra .tlacitko { width: 100%; padding: 0 1rem; white-space: nowrap; }
  .hra-tl-ano { background: var(--teal); border-color: var(--teal); color: #fff; }
  .hra-tl-ne { background: var(--valka); border-color: var(--valka); color: #fff; }
  @media (hover: hover) and (pointer: fine) { .hra-tl-ano:hover { background: var(--teal); color: #fff; filter: brightness(1.08); } .hra-tl-ne:hover { background: var(--valka); color: #fff; filter: brightness(1.08); } }
  .hra-popisek { text-align: center; font-weight: 800; font-size: 0.95rem; }
  .hra-tip { text-align: center; font-size: 0.84rem; font-weight: 600; color: var(--muted); line-height: 1.45; }
  .hra-moznosti { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .hra-moznost {
    min-height: 56px; padding: 0.7rem 0.8rem; border-radius: 16px; border: 1.5px solid var(--line-2); background: var(--paper); color: var(--navy);
    font-family: inherit; font-size: 0.9rem; font-weight: 800; line-height: 1.25; cursor: pointer; box-shadow: var(--stin-maly);
    transition: transform var(--stisk) var(--ease-out), background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) { .hra-moznost:hover { border-color: var(--navy); } }
  .hra-moznost:active { transform: scale(0.97); }
  .hra-moznost.spravne { background: var(--teal); border-color: var(--teal); color: #fff; }
  .hra-moznost.spatne { background: var(--valka); border-color: var(--valka); color: #fff; animation: hra-tres 0.35s; }
  .hra-moznost.tlumene { opacity: 0.42; }
  .hra-moznost--vlajka { padding: 0.5rem; }
  .hra-moznost--vlajka img { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--navy) 12%, transparent); }
  .hra-vysledek { text-align: center; padding: 0.85rem 1rem; border-radius: 18px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--stin-maly); font-weight: 700; font-size: 0.95rem; line-height: 1.5; animation: hra-pop 0.3s; }
  .hra-vysledek strong { display: flex; align-items: center; justify-content: center; gap: 0.4rem; font-size: 1.25rem; font-weight: 900; letter-spacing: -0.01em; }
  .hra-vysledek.ano strong { color: var(--teal-text); }
  .hra-vysledek.ne strong { color: var(--valka-text); }
  .hra-oznaceni { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .hra-oznaceni .chip { justify-content: center; gap: 0.45rem; }
  .hra-oznaceni .chip i { width: 10px; height: 10px; border-radius: 50%; background: var(--pc); }
