    const id = window.setInterval(() => {
      if (!B) return; B.zbyva--; $('[data-bt]', app).textContent = String(B.zbyva); $('[data-bcas]', app).style.width = (B.zbyva / 60) * 100 + '%';
      if (B.zbyva <= 5 && B.zbyva > 0) zvuk('tik');
      if (B.zbyva <= 0) { clearInterval(id); konecBleskovky(); }
    }, 1000);
    stopky.push(() => clearInterval(id)); otazka();
  };
  function rusive(z: Zeme, n: number, fn: (o: Zeme) => string) {
    const stejny = zamichej(ZEME.filter((o) => o !== z && o.cont[0] === z.cont[0] && DVOJCATA[z.c] !== o.c));
    const zbytek = zamichej(ZEME.filter((o) => o !== z && DVOJCATA[z.c] !== o.c));
    const out: Zeme[] = []; const videno = new Set([fn(z)]);
    for (const o of [...stejny, ...zbytek]) { const v = fn(o); if (videno.has(v) || out.some((x) => DVOJCATA[x.c] === o.c)) continue; videno.add(v); out.push(o); if (out.length === n) break; }
    return out;
  }
  function otazka() {
    if (!B) return;
    if (B.pos >= B.balicek.length) { B.balicek = zamichej(B.balicek); B.pos = 0; }
    const z = ZEME[B.balicek[B.pos++]]; const r = Math.random();
    let typ = r < 0.35 ? 'vlajka' : r < 0.55 ? 'najdi' : r < 0.75 ? 'mesto' : 'mapa';
    if (typ === 'mesto' && normalizuj(z.capShort).startsWith(normalizuj(z.n).slice(0, 5))) typ = 'vlajka';
    let q: Otazka;
    if (typ === 'vlajka') q = { z, titul: 'Čí je to vlajka?', vizual: vlajka(z, 'vlajka-velka'), moz: zamichej([z, ...rusive(z, 3, (o) => o.n)]), popisek: (o) => esc(o.n) };
    else if (typ === 'najdi') q = { z, titul: 'Najdi vlajku', vizual: `<div class="hra-otazka__velke">${esc(z.n)}</div>`, moz: zamichej([z, ...rusive(z, 3, (o) => o.a2)]), vlajky: true };
    else if (typ === 'mesto') q = { z, titul: 'Hlavní město státu', vizual: `${vlajka(z, 'vlajka-mala')}<div class="hra-otazka__velke">${esc(z.n)}</div>`, moz: zamichej([z, ...rusive(z, 3, (o) => o.capShort)]), popisek: (o) => esc(o.capShort) };
    else q = { z, titul: 'Který stát je na mapě?', vizual: `<div class="hra-otazka__mapa">${mapaSVG(z, { mesto: false, sousede: false })}</div>`, moz: zamichej([z, ...rusive(z, 3, (o) => o.n)]), popisek: (o) => esc(o.n) };
    B.q = q; B.zamek = false;
    ukazDole('[data-botazka] .hra-moznosti');
    $('[data-botazka]', app).innerHTML = `<div class="hra-otazka"><span class="nadhlavi">${q.titul}</span>${q.vizual}</div><div class="hra-moznosti">${q.moz.map((o, i) => `<button class="hra-moznost${q.vlajky ? ' hra-moznost--vlajka' : ''}" data-a="bodpoved" data-i="${i}" ${q.vlajky ? `aria-label="Možnost ${i + 1}"` : ''}>${q.vlajky ? vlajka(o) : q.popisek!(o)}</button>`).join('')}</div>`;
  }
  AKCE.bodpoved = (b) => {
    if (!B || B.zamek || B.zbyva <= 0 || !B.q) return; B.zamek = true;
    const q = B.q; const ok = q.moz[+b.dataset.i!] === q.z;
    app.querySelectorAll<HTMLElement>('[data-botazka] .hra-moznost').forEach((x, i) => { if (q.moz[i] === q.z) x.classList.add('spravne'); else if (x === b) x.classList.add('spatne'); else x.classList.add('tlumene'); });
    if (ok) { B.serie++; B.body++; if (B.serie % 5 === 0) { B.body++; toast('5 v řadě! +1 bonus'); } zvuk('ano'); } else { B.serie = 0; B.chyby.push(q.z); zvuk('ne'); }
    $('[data-bb]', app).textContent = String(B.body);
    $('[data-bs]', app).textContent = B.serie > 1 ? `${B.serie} v řadě` : 'bodů';
    setTimeout(() => { if (B && B.zbyva > 0) otazka(); }, ok ? 450 : 1300);
  };
  function konecBleskovky() {
    if (!B) return;
    const rekord = ulozeni.get('rekord', 0); const novy = B.body > rekord && B.body > 0; if (novy) ulozeni.set('rekord', B.body);
    zvuk('vyhra'); if (novy) konfety();
    const chyby = [...new Map(B.chyby.map((z) => [z.c, z])).values()];
    const body = B.body; B = null;
    obrazovka(`<div class="hra-uzke">${lista('Bleskovka', 'Konec')}
      <div class="hra-panel" style="text-align:center"><span class="nadhlavi">${novy ? 'Nový rekord' : 'Výsledek'}</span><div class="hra-velke-cislo" style="margin-top:.4rem">${body}</div><p class="drobne">${novy ? 'Lepší než kdy dřív.' : 'Rekord: ' + Math.max(rekord, body)}</p></div>
      ${chyby.length ? `<div class="hra-panel"><h3>${ik('map', 18)} Na tyhle se podívej</h3>${chyby.map((z) => `<div class="hra-chyba">${vlajka(z)}<div>${esc(z.n)}<small>${esc(z.capShort)} · ${esc(z.contTxt)}</small></div></div>`).join('')}</div>` : ''}
      <div class="hra-dva"><button class="tlacitko" data-a="menu">Menu</button><button class="tlacitko tlacitko--oranzovy" data-a="bleskovka">Znovu</button></div></div>`);
  }

  /* ============ STUDOVNA ============ */
  let S: { fronta: number[]; celkem: number; umim: number; znovu: number } | null = null;
  const SK: string[] = ulozeni.get('studovnaKont', Object.keys(KONT));
  AKCE.studovnaUvod = () => {
    obrazovka(`<div class="hra-uzke">${lista('Studovna', 'Kartičky na procvičení')}
      <div class="hra-panel"><h3>${ik('books', 18)} Jak to funguje</h3><p class="perex" style="font-size:.98rem">Podívej se na vlajku, zkus si vybavit vše o státu a otoč kartu. Co ještě neumíš, se ti za chvíli vrátí.</p></div>
      <div class="hra-panel"><h3>${ik('kont', 18)} Které kontinenty</h3>${kontinentyChips(SK, 'skont')}<p class="hra-pocet">${zKontinentu(SK).length} karet</p></div>
      <button class="tlacitko tlacitko--oranzovy tlacitko--plna-sirka" data-a="studovna" ${zKontinentu(SK).length ? '' : 'disabled'}>${ik('books', 20)} Začít</button></div>`);
  };
  AKCE.skont = (b) => { prepniVSeznamu(SK, b.dataset.k!); ulozeni.set('studovnaKont', SK); AKCE.studovnaUvod(b, new Event('x')); };
  AKCE.studovna = () => { const f = zamichej(zKontinentu(SK)); S = { fronta: f, celkem: f.length, umim: 0, znovu: 0 }; studovnaKarta(); };
  function studovnaKarta() {
    if (!S) return;
    if (!S.fronta.length) {
      zvuk('vyhra'); konfety();
      obrazovka(`<div class="hra-uzke">${lista('Studovna', 'Hotovo', 'studovnaUvod')}<div class="hra-panel" style="text-align:center"><div class="hra-pohar">${ik('trophy', 32)}</div><h2 style="font-size:1.5rem">Hotovo!</h2><p class="drobne">Prošel/prošla jsi všech ${S.celkem} karet. Opakování navíc: ${S.znovu}×.</p></div><div class="hra-dva"><button class="tlacitko" data-a="menu">Menu</button><button class="tlacitko tlacitko--oranzovy" data-a="studovna">Znovu</button></div></div>`);
      return;
    }
    const z = ZEME[S.fronta[0]];
    obrazovka(`<div class="hra-uzke" style="max-width:440px">${lista('Studovna', `umím ${S.umim} z ${S.celkem} · zbývá ${S.fronta.length}`, 'studovnaUvod')}
      <div class="hra-postup"><i style="width:${(S.umim / S.celkem) * 100}%"></i></div>
      <div class="hra-karta-obal" data-skarta>${kartaHTML(z, { tip: true })}</div>
      <div class="hra-dva" style="margin-top:1.1rem" data-studovna-tl><button class="tlacitko hra-tl-ne" data-a="sne">${ik('x', 18)} Ještě ne</button><button class="tlacitko hra-tl-ano" data-a="sano">${ik('check', 18)} Umím</button></div></div>`);
    $('[data-skarta] .hra-karta', app).addEventListener('click', (e) => { (e.currentTarget as HTMLElement).classList.toggle('otocena'); zvuk('otoc'); });
    ukazDole('[data-studovna-tl]');
  }
  AKCE.sano = () => { if (!S) return; S.fronta.shift(); S.umim++; zvuk('ano'); studovnaKarta(); };
  AKCE.sne = () => { if (!S) return; const x = S.fronta.shift()!; S.fronta.splice(Math.min(S.fronta.length, 3 + rnd(3)), 0, x); S.znovu++; zvuk('tik'); studovnaKarta(); };

  /* ============ ATLAS ============ */
  const AK: string[] = Object.keys(KONT); let AQ = '';
  AKCE.atlas = () => {
    obrazovka(`${lista('Atlas karet', `${ZEME.length} států`)}
      <div class="hledani hra-atlas-hledat" style="width:min(100%,420px)"><div class="hledani__pole">${ik('search', 18, 2.2)}<input type="search" data-aq placeholder="Hledat stát, město, měnu…" value="${esc(AQ)}" autocomplete="off" aria-label="Hledat v atlasu"></div></div>
      ${kontinentyChips(AK, 'akont')}<p class="hra-pocet" data-acnt></p><div class="hra-mrizka" data-agrid></div>`);
    $<HTMLInputElement>('[data-aq]', app).addEventListener('input', (e) => { AQ = (e.target as HTMLInputElement).value; atlasMrizka(); });
    atlasMrizka();
  };
  const atlasSeznam = () => { const q = normalizuj(AQ.trim()); return ZEME.filter((z) => z.cont.some((k) => AK.includes(k)) && (!q || normalizuj([z.n, z.cap, z.cur, z.lang].join(' ')).includes(q))); };
  function atlasMrizka() {
    const L = atlasSeznam();
    $('[data-acnt]', app).textContent = L.length === 1 ? '1 karta' : L.length >= 2 && L.length <= 4 ? `${L.length} karty` : `${L.length} karet`;
    $('[data-agrid]', app).innerHTML = L.map((z) => `<button class="hra-vlajka-dl" data-a="aotevri" data-c="${z.c}">${vlajka(z)}<span>${esc(z.n)}</span></button>`).join('');
  }
  AKCE.akont = (b) => { const on = prepniVSeznamu(AK, b.dataset.k!); b.setAttribute('aria-pressed', String(on)); atlasMrizka(); };
  AKCE.aotevri = (b) => {
    const L = atlasSeznam(); let idx = L.findIndex((z) => z.c === b.dataset.c);
    const ukaz = () => {
      otevri(`<div class="hra-okno hra-okno--karta" role="dialog" aria-modal="true" aria-label="${esc(L[idx].n)}"><div class="hra-karta-obal">${kartaHTML(L[idx], { tip: true })}</div>
        <div class="hra-atlas-nav"><button class="tlacitko" data-a="apredchozi" aria-label="Předchozí">${ik('prev', 20)}</button><button class="tlacitko" data-a="zavri">Zavřít</button><button class="tlacitko" data-a="adalsi" aria-label="Další">${ik('dalsi', 20)}</button></div></div>`);
      $('.hra-karta', modal).addEventListener('click', (e) => { (e.currentTarget as HTMLElement).classList.toggle('otocena'); zvuk('otoc'); });
    };
    AKCE.apredchozi = () => { idx = (idx - 1 + L.length) % L.length; ukaz(); };
    AKCE.adalsi = () => { idx = (idx + 1) % L.length; ukaz(); };
    ukaz();
  };

  /* ============ START ============ */
  fetch('/data/hra-vlajky.json')
    .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
    .then((d: { zeme: Zeme[]; mapa: Mapa }) => {
      ZEME = d.zeme; MAPA = d.mapa;
      ZEME.forEach((z, i) => {
        z.i = i; PODLE[z.c] = z;
        z.capShort = z.cap.replace(/\s*\([^)]*\)/g, '').trim();
        z.contTxt = z.cont.map((k) => KONT[k]).join(' / ');
        z.num = String(i + 1).padStart(3, '0');
      });
      VSE = ZEME.map((z) => z.i);
      let defs = '<g id="hraW"><path d="' + MAPA.other + '"/>';
      for (const k in MAPA.paths) defs += '<path id="hm' + k + '" d="' + MAPA.paths[k] + '"/>';
      document.querySelector('[data-hra-defs]')!.innerHTML = defs + '</g>';
      menu();
    })
    .catch(() => { app.innerHTML = '<p class="drobne">Hru se nepodařilo načíst. Zkus stránku obnovit.</p>'; });
</script>
