    let x0: number, y0: number, x1: number, y1: number;
    if (z.box) [x0, y0, x1, y1] = z.box; else { x0 = x1 = z.pt[0]; y0 = y1 = z.pt[1]; }
    const bw = x1 - x0, bh = y1 - y0, cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
    let w = Math.max(bw * 1.5, bh * 1.5 * A, 520); w = Math.min(w, MAPA.W); const h = w / A;
    const vx = cx - w / 2; let vy = cy - h / 2; vy = Math.max(-h * 0.05, Math.min(vy, MAPA.H - h * 0.95));
    const sw = (w / 650).toFixed(1);
    const male = !z.map || z.ar < (w * 0.05) ** 2;
    let s = `<svg viewBox="${vx | 0} ${vy | 0} ${w | 0} ${h | 0}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Poloha státu ${esc(z.n)} na mapě"><rect x="${(vx - 50) | 0}" y="${(vy - 50) | 0}" width="${(w + 100) | 0}" height="${(h + 100) | 0}" style="fill:var(--more-svetle)"/><use href="#hraW" style="fill:var(--pevnina);stroke:var(--line)" stroke-width="${sw}"/>`;
    if (sousede) for (const n of z.nb) if (PODLE[n]?.map) s += `<use href="#hm${n}" style="fill:var(--cesko-plocha);stroke:var(--obrys)" stroke-width="${sw}"/>`;
    if (z.map) s += `<use href="#hm${z.c}" style="fill:var(--orange);stroke:var(--obrys)" stroke-width="${sw}"/>`;
    if (male) {
      const r1 = (w * 0.022).toFixed(1), r2 = (w * 0.055).toFixed(1);
      s += `<circle cx="${z.pt[0]}" cy="${z.pt[1]}" r="${r1}" fill="none" style="stroke:var(--orange)" stroke-width="${(w * 0.007).toFixed(1)}"><animate attributeName="r" values="${r1};${r2};${r1}" dur="1.8s" repeatCount="indefinite"/><animate attributeName="opacity" values="1;.35;1" dur="1.8s" repeatCount="indefinite"/></circle>`;
    }
    if (mesto && z.cp) s += `<circle cx="${z.cp[0]}" cy="${z.cp[1]}" r="${(w * 0.011).toFixed(1)}" style="fill:var(--navy);stroke:var(--obrys)" stroke-width="${(w * 0.004).toFixed(1)}"/>`;
    s += '</svg>';
    if (vlozka) s += `<svg class="hra-vlozka" viewBox="-40 -40 ${MAPA.W + 80} ${MAPA.H + 80}" aria-hidden="true"><path d="${MAPA.sphere}" style="fill:var(--more-svetle);stroke:var(--obrys)" stroke-width="90"/><use href="#hraW" style="fill:var(--line-2)"/><circle cx="${z.pt[0]}" cy="${z.pt[1]}" r="380" style="fill:var(--orange);stroke:var(--obrys)" stroke-width="110"/></svg>`;
    return s;
  }

  /* ============ KARTA ============ */
  const hodnota = (z: Zeme, k: string) => {
    switch (k) {
      case 'n': return z.n; case 'cont': return z.contTxt; case 'cur': return z.cur;
      case 'nb': return String(z.nb.length); case 'lang': return z.lang; case 'cap': return z.cap;
    }
    return '';
  };
  function sousedeHTML(z: Zeme) {
    const n = z.nb.length;
    let s = String(n);
    s += n ? `<small>${z.nb.map((x) => esc(PODLE[x].n)).join(', ')}</small>` : '<small>žádný pozemní soused</small>';
    if (z.nbn) s += `<small>${esc(z.nbn)}</small>`;
    return s;
  }
  function kartaHTML(z: Zeme, { zvyr = '', tip = false } = {}) {
    const radek = (k: string) => {
      const kat = KAT.find((x) => x.k === k)!;
      const v = k === 'nb' ? sousedeHTML(z) : esc(hodnota(z, k));
      return `<div class="hra-radek${zvyr === k ? ' zvyr' : ''}" style="--rc:${kat.barva}"><span class="hra-radek__ikona">${ik(kat.ik, 16)}</span><div><div class="hra-radek__stitek">${kat.nazev}</div><div class="hra-radek__hodnota">${v}</div></div></div>`;
    };
    return `<div class="hra-karta rozdat">
      <div class="hra-strana hra-lic">${vlajka(z)}<span class="hra-lic__cislo">№ ${z.num}</span>${tip ? '<span class="hra-lic__tip">klepnutím kartu otočíš</span>' : ''}<span class="hra-lic__znacka">data<span>.cesky</span></span></div>
      <div class="hra-strana hra-rub">
        <div class="hra-rub__hlava${zvyr === 'n' ? ' zvyr' : ''}">${vlajka(z)}<div class="hra-rub__nazev">${esc(z.n)}</div><div class="hra-rub__cislo">№ ${z.num}</div></div>
        <div class="hra-rub__mapa">${mapaSVG(z)}</div>
        <div class="hra-radky">${RADKY_RUBU.map(radek).join('')}</div>
      </div></div>`;
  }

  /* ============ ZVUKY, TOAST, KONFETY ============ */
  let AC: AudioContext | null = null;
  let ztlumeno = ulozeni.get('ticho', false);
  function ton(f: number, t0: number, d: number, typ: OscillatorType = 'sine', v = 0.16) {
    const ac = AC!; const o = ac.createOscillator(), g = ac.createGain();
    o.type = typ; o.frequency.setValueAtTime(f, ac.currentTime + t0);
    g.gain.setValueAtTime(0, ac.currentTime + t0); g.gain.linearRampToValueAtTime(v, ac.currentTime + t0 + 0.01);
    g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + t0 + d);
    o.connect(g).connect(ac.destination); o.start(ac.currentTime + t0); o.stop(ac.currentTime + t0 + d + 0.05);
  }
  function zvuk(t: string) {
    if (ztlumeno) return;
    try {
      AC = AC || new (window.AudioContext || (window as any).webkitAudioContext)();
      if (AC.state === 'suspended') AC.resume();
      if (t === 'hod') for (let i = 0; i < 9; i++) ton(180 + Math.random() * 260, i * 0.09, 0.05, 'square', 0.05);
      else if (t === 'otoc') { ton(500, 0, 0.12, 'triangle', 0.09); ton(800, 0.05, 0.1, 'triangle', 0.07); }
      else if (t === 'ano') { ton(660, 0, 0.14); ton(990, 0.11, 0.22); }
      else if (t === 'ne') { ton(200, 0, 0.25, 'sawtooth', 0.08); ton(150, 0.12, 0.3, 'sawtooth', 0.07); }
      else if (t === 'tik') ton(1200, 0, 0.04, 'square', 0.04);
      else if (t === 'vyhra') [523, 659, 784, 1047].forEach((f, i) => ton(f, i * 0.12, 0.3, 'triangle', 0.13));
      else if (t === 'mince') { ton(988, 0, 0.08, 'square', 0.07); ton(1319, 0.08, 0.25, 'square', 0.07); }
    } catch {}
  }
  let toastCas = 0;
  function toast(text: string) {
    const t = $('[data-hra-toast]'); t.textContent = text; t.classList.add('videt');
    clearTimeout(toastCas); toastCas = window.setTimeout(() => t.classList.remove('videt'), 2200);
  }
  function konfety() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const box = document.createElement('div'); box.className = 'hra-konfety';
    const barvy = ['#F08829', '#1E9E91', '#1B2A4A', '#F6C08C', '#3F7FBF', '#D8473B'];
    for (let i = 0; i < 90; i++) {
      const p = document.createElement('i');
      p.style.left = Math.random() * 100 + '%'; p.style.background = vyber(barvy);
      p.style.animationDuration = 1.8 + Math.random() * 1.8 + 's'; p.style.animationDelay = Math.random() * 0.6 + 's';
      p.style.transform = `rotate(${rnd(360)}deg)`; box.appendChild(p);
    }
    document.body.appendChild(box); setTimeout(() => box.remove(), 4500);
  }

  /* ============ OVLÁDÁNÍ ============ */
  const AKCE: Record<string, (b: HTMLElement, e: Event) => void> = {};
  koren.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-a]'); if (b && AKCE[b.dataset.a!]) AKCE[b.dataset.a!](b, e); });
  modal.addEventListener('click', (e) => {
    if (e.target === modal) { zavri(); return; }
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-a]'); if (b && AKCE[b.dataset.a!]) AKCE[b.dataset.a!](b, e);
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) zavri(); });
  function otevri(html: string) { modal.innerHTML = html; modal.hidden = false; }
  function zavri() { modal.hidden = true; modal.innerHTML = ''; }
  AKCE.zavri = zavri;
  AKCE.zvuk = (b) => { ztlumeno = !ztlumeno; ulozeni.set('ticho', ztlumeno); b.innerHTML = ik(ztlumeno ? 'voloff' : 'vol', 19); b.setAttribute('aria-label', ztlumeno ? 'Zapnout zvuk' : 'Vypnout zvuk'); if (!ztlumeno) zvuk('tik'); };
  const tlZvuk = () => `<button class="hra-kulate" data-a="zvuk" aria-label="${ztlumeno ? 'Zapnout zvuk' : 'Vypnout zvuk'}">${ik(ztlumeno ? 'voloff' : 'vol', 19)}</button>`;
  const lista = (titul: string, podtitul = '', zpet = 'menu') => `<div class="hra-lista"><button class="hra-kulate" data-a="${zpet}" aria-label="Zpět">${ik('back', 19)}</button><div class="hra-lista__titul" data-titul>${titul}${podtitul ? `<small>${podtitul}</small>` : ''}</div>${tlZvuk()}</div>`;
  let stopky: (() => void)[] = [];
  function obrazovka(html: string, hraje = true) {
    stopky.forEach((f) => f()); stopky = [];
    koren.classList.toggle('hraje', hraje);
    app.innerHTML = html;
    const r = app.getBoundingClientRect();
    const odsazeni = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hlavicka-vyska')) || 64) + 12;
    if (r.top < odsazeni - 2 || (hraje && r.top > innerHeight * 0.4)) scrollTo({ top: Math.max(0, r.top + scrollY - odsazeni), behavior: 'instant' as ScrollBehavior });
  }
  const segment = (skupina: string, hodnoty: number[], aktivni: number, popis: (v: number) => string) =>
    `<div class="segment" role="group" data-skupina="${skupina}">${hodnoty.map((v) => `<button type="button" data-a="seg" data-v="${v}" aria-pressed="${v === aktivni}">${popis(v)}</button>`).join('')}</div>`;
  const kontinentyChips = (vybrane: string[], akce: string) =>
    `<div class="rada" style="gap:.5rem">${Object.keys(KONT).map((k) => `<button type="button" class="chip" data-a="${akce}" data-k="${k}" aria-pressed="${vybrane.includes(k)}">${KONT_KRATKE[k]}</button>`).join('')}</div>`;
  const zKontinentu = (k: string[]) => VSE.filter((i) => ZEME[i].cont.some((x) => k.includes(x)));
  const prepniVSeznamu = (a: string[], k: string) => { const i = a.indexOf(k); if (i >= 0) a.splice(i, 1); else a.push(k); return i < 0; };

  /* ============ ROZCESTNÍK ============ */
  function menu() {
    zavri();
    const vejir = zamichej(VSE).slice(0, 3).map((i) => ZEME[i]);
    const rekord = ulozeni.get('rekord', 0);
    obrazovka(`<div class="hra-menu">
      <button class="hra-dl hra-dl--hlavni" data-a="nastaveni">
        <span class="hra-dl__text"><span class="hra-dl__ikona" style="margin-bottom:.9rem">${ik('dice', 28)}</span><b>Desková hra s kostkou</b><small>Kostka určí, co o státu musíš říct. Pro 1 až 6 hráčů u jednoho telefonu.</small><span class="hra-dl__cta">Rozdat karty ${ik('next', 18)}</span></span>
        <span class="hra-vejir" aria-hidden="true">${vejir.map((z) => `<span>${vlajka(z)}</span>`).join('')}</span>
      </button>
      <button class="hra-dl" data-a="bleskovkaUvod" style="--ic:#3F7FBF"><span class="hra-dl__ikona">${ik('bolt', 26)}</span><span><b>Bleskovka</b><small>60 sekund, co nejvíc správně${rekord ? ` · tvůj rekord ${rekord}` : ''}</small></span></button>
      <button class="hra-dl" data-a="studovnaUvod" style="--ic:var(--teal)"><span class="hra-dl__ikona">${ik('books', 26)}</span><span><b>Studovna</b><small>Kartičky na procvičení. Co neumíš, vrátí se.</small></span></button>
      <button class="hra-dl" data-a="atlas" style="--ic:#8E6CC9"><span class="hra-dl__ikona">${ik('map', 26)}</span><span><b>Atlas karet</b><small>Prohlédni si a hledej všech ${ZEME.length} karet.</small></span></button>
      <button class="hra-dl" data-a="pravidla" style="--ic:var(--slate)"><span class="hra-dl__ikona">${ik('book', 26)}</span><span><b>Pravidla</b><small>Jak se hraje a co dělají bonusy.</small></span></button>
    </div>
    <div class="hra-pata"><p class="drobne">${ZEME.length} států: 193 členů OSN, Vatikán, Palestina, Kosovo a Tchaj-wan. Údaje k listopadu 2026, zdroje v <a href="/metodika/#hra">metodice</a>.</p></div>`, false);
  }
  AKCE.menu = menu;
  AKCE.pravidla = () => otevri(`<div class="hra-okno" role="dialog" aria-modal="true" aria-label="Pravidla">
    <h2>Pravidla</h2>
    <h3>${ik('dice', 18)} Desková hra</h3><ul>
      <li>Hráč na tahu vidí kartu s vlajkou a hodí kostkou.</li>
      <li>Kostka určí, co má o státu říct: <b>název, kontinent, měnu, počet sousedů, jazyk</b> nebo <b>hlavní město</b>.</li>
      <li>Odpoví nahlas, otočí kartu a ostatní rozhodnou, jestli to platí.</li>
      <li>Kdo první dosáhne cílového počtu bodů, vyhrává.</li></ul>
    <h3>${ik('norm', 18)} Akční kostka</h3><ul>
      <li><b>Běžný tah:</b> +1 bod</li><li><b>Dvojnásobek:</b> +2 body</li>
      <li><b>Hádají všichni:</b> každý řekne nebo napíše odpověď, bod dostane každý, kdo trefí</li>
      <li><b>Zloděj:</b> když uhádneš, vezmeš si bod od soupeře podle výběru</li>
      <li><b>Vabank:</b> +3 body, ale při chybě −1</li></ul>
    <h3>${ik('joker', 18)} Žolík 50/50</h3><p>Místo odpovídání z hlavy si necháš ukázat 4 možnosti. Žolíků je jen pár na celou hru.</p>
    <h3>${ik('flame', 18)} Série</h3><p>Tři správné odpovědi za sebou = bonusový bod.</p>
    <h3>${ik('check', 18)} Spory</h3><ul>
      <li>Jazyk: stačí jeden z úředních jazyků.</li>
