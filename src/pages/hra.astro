      <li>Sousedé: počítají se pozemní hranice se státy z balíčku. Na mapě jsou vybarvení.</li>
      <li>Hlavní město: když jich stát má víc, stačí jedno.</li></ul>
    <div style="margin-top:1.2rem"><button class="tlacitko tlacitko--plny tlacitko--plna-sirka" data-a="zavri">Rozumím</button></div></div>`);

  /* ============ NASTAVENÍ DESKOVÉ HRY ============ */
  type Nastaveni = { hraci: string[]; cil: number; kont: string[]; akce: boolean; zolici: number; cas: number; serie: boolean };
  let N: Nastaveni = ulozeni.get('nastaveni', { hraci: ['Hráč 1', 'Hráč 2'], cil: 10, kont: Object.keys(KONT), akce: true, zolici: 2, cas: 0, serie: true });
  const ulozN = () => ulozeni.set('nastaveni', N);
  function nastaveni() {
    obrazovka(`<div class="hra-uzke">${lista('Nová hra', 'Desková hra s kostkou')}
      <div class="hra-panel"><h3>${ik('all', 18)} Hráči</h3><div class="hra-hraci" data-hraci></div>
        <button type="button" class="tlacitko tlacitko--male" data-a="pridej" ${N.hraci.length >= 6 ? 'disabled' : ''} style="width:auto">${ik('plus', 16)} Přidat hráče</button></div>
      <div class="hra-panel"><h3>${ik('trophy', 18)} Cíl hry</h3>${segment('cil', [5, 10, 15, 20], N.cil, (v) => v + ' bodů')}</div>
      <div class="hra-panel"><h3>${ik('kont', 18)} Balíček karet</h3>${kontinentyChips(N.kont, 'kont')}<p class="hra-pocet" data-pocet></p></div>
      <div class="hra-panel"><h3>${ik('norm', 18)} Zpestření</h3>
        <div class="hra-volba"><div><b>Akční kostka</b><small>Druhá kostka: dvojnásobek, hádají všichni, zloděj, vabank.</small></div><button type="button" class="prepinac-pilulka" data-a="prepni" data-k="akce" aria-pressed="${N.akce}">${N.akce ? 'Zapnuto' : 'Vypnuto'}</button></div>
        <div class="hra-volba"><div><b>Série</b><small>3 správně za sebou = bonusový bod.</small></div><button type="button" class="prepinac-pilulka" data-a="prepni" data-k="serie" aria-pressed="${N.serie}">${N.serie ? 'Zapnuto' : 'Vypnuto'}</button></div>
        <div class="hra-volba"><div><b>Žolíci 50/50</b><small>Kolik žolíků má každý hráč.</small>${segment('zolici', [0, 1, 2, 3], N.zolici, String)}</div></div>
        <div class="hra-volba"><div><b>Časovač</b><small>Kolik času je na odpověď.</small>${segment('cas', [0, 15, 30, 45], N.cas, (v) => (v ? v + ' s' : 'bez času'))}</div></div>
      </div>
      <button class="tlacitko tlacitko--oranzovy tlacitko--plna-sirka" data-a="start">${ik('dice', 20)} Rozdat karty</button></div>`);
    hraciPole(); pocet();
  }
  function hraciPole() {
    const el = $('[data-hraci]');
    el.innerHTML = N.hraci.map((p, i) => `<div class="hra-hrac-radek" style="--pc:${BARVY_HRACU[i]}"><i></i><input type="text" value="${esc(p)}" maxlength="14" data-i="${i}" aria-label="Jméno hráče ${i + 1}" autocomplete="off">${N.hraci.length > 1 ? `<button type="button" class="hra-kulate" data-a="odeber" data-i="${i}" aria-label="Odebrat hráče">${ik('x', 17)}</button>` : ''}</div>`).join('');
    el.querySelectorAll<HTMLInputElement>('input').forEach((inp) => inp.addEventListener('input', () => { N.hraci[+inp.dataset.i!] = inp.value; ulozN(); }));
  }
  function pocet() {
    const n = zKontinentu(N.kont).length;
    $('[data-pocet]').textContent = n ? `V balíčku: ${n} karet` : 'Vyber aspoň jeden kontinent';
    $<HTMLButtonElement>('[data-a="start"]').disabled = !n;
  }
  AKCE.nastaveni = nastaveni;
  AKCE.pridej = () => { if (N.hraci.length < 6) { N.hraci.push('Hráč ' + (N.hraci.length + 1)); ulozN(); nastaveni(); } };
  AKCE.odeber = (b) => { N.hraci.splice(+b.dataset.i!, 1); ulozN(); nastaveni(); };
  AKCE.seg = (b) => {
    const sk = b.parentElement!.dataset.skupina as 'cil' | 'zolici' | 'cas';
    (N as any)[sk] = +b.dataset.v!; b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); ulozN();
  };
  AKCE.prepni = (b) => { const k = b.dataset.k as 'akce' | 'serie'; N[k] = !N[k]; b.setAttribute('aria-pressed', String(N[k])); b.textContent = N[k] ? 'Zapnuto' : 'Vypnuto'; ulozN(); };
  AKCE.kont = (b) => { const on = prepniVSeznamu(N.kont, b.dataset.k!); b.setAttribute('aria-pressed', String(on)); ulozN(); pocet(); };

  /* ============ DESKOVÁ HRA ============ */
  type Hrac = { jmeno: string; barva: string; body: number; serie: number; zolici: number; ok: number; tahu: number; bonus?: boolean };
  type Hra = {
    hraci: Hrac[]; na: number; balicek: number[]; pos: number; cil: number; o: Nastaveni; faze: string; kat: string | null;
    ud: (typeof UDALOSTI)[number] | null; rot: { x: number; y: number }; arot: { x: number; y: number }; zolik: boolean;
    oznaceni: Set<number>; zprava: string; jmoz: string[] | null; jspr: string; casovac: number | null; konec?: boolean; vysledek: 'ano' | 'ne' | '';
  };
  let H: Hra;
  AKCE.start = () => {
    zavri();
    const hraci = N.hraci.map((n, i) => ({ jmeno: (n || '').trim() || 'Hráč ' + (i + 1), barva: BARVY_HRACU[i], body: 0, serie: 0, zolici: N.zolici, ok: 0, tahu: 0 }));
    H = { hraci, na: 0, balicek: zamichej(zKontinentu(N.kont)), pos: 0, cil: N.cil, o: { ...N }, faze: 'pripraven', kat: null, ud: null, rot: { x: 0, y: 0 }, arot: { x: 0, y: 0 }, zolik: false, oznaceni: new Set(), zprava: '', jmoz: null, jspr: '', casovac: null, vysledek: '' };
    zvuk('otoc'); stul(); novaKarta();
  };
  const STENY = (h: number) => [`translateZ(${h}px)`, `rotateX(90deg) translateZ(${h}px)`, `rotateY(90deg) translateZ(${h}px)`, `rotateY(-90deg) translateZ(${h}px)`, `rotateX(-90deg) translateZ(${h}px)`, `rotateY(180deg) translateZ(${h}px)`];
  const OTOCENI_STEN = [[0, 0], [-90, 0], [0, -90], [0, 90], [90, 0], [0, 180]];
  function stul() {
    obrazovka(`${lista('Desková hra', '', 'konec')}
      <div class="hra-stul">
        <div class="hra-stul__skore"><div class="hra-skore" data-skore></div></div>
        <div class="hra-stul__karta"><div class="hra-karta-obal" data-karta></div></div>
        <div class="hra-stul__ovladani">
