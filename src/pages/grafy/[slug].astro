---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BarChart from '../../components/BarChart.astro';
import GrafCard from '../../components/GrafCard.astro';

export async function getStaticPaths() {
  const grafy = await getCollection('grafy');
  return grafy.map((graf) => ({ params: { slug: graf.id }, props: { graf } }));
}

const { graf } = Astro.props;
const { data } = graf;
const { Content } = await render(graf);

const vsechny = await getCollection('grafy');
const souvisejici = vsechny
  .filter((g) => g.id !== graf.id && g.data.tema === data.tema)
  .slice(0, 3);

const datum = (d: Date) => d.toLocaleDateString('cs-CZ');
---

<Base titul={`${data.titul} — data.cesky`} popis={data.perex} obrazek={data.obrazek}>
  <article class="obal sekce sloupec">
    <nav aria-label="Drobečková navigace" class="drobne">
      <a href="/grafy/">Grafy</a> / <span aria-current="page">{data.titul}</span>
    </nav>

    <h1>{data.titul}</h1>
    <p class="perex" style="max-width: 62ch;">{data.perex}</p>

    <div class="rada">
      <span class="chip" style="cursor: default;">Zdroj: {data.zdroj}</span>
      <span class="chip" style="cursor: default;">Publikováno {datum(data.datum)}</span>
      <span class="chip" style="cursor: default;">Téma: {data.tema}</span>
    </div>

    <div class="detail" style="margin-top: 1.5rem;">
      <div class="sloupec" style="gap: 2.5rem;">
        <div class="karta sloupec">
          <div style="text-align: center;">
            <h2 style="text-transform: uppercase;">{data.titul}</h2>
            {data.popisGrafu && (
              <p class="stitek" style="margin-top: 0.4rem;">{data.popisGrafu}</p>
            )}
          </div>
          <BarChart polozky={data.polozky} jednotka={data.jednotka} />
          <div class="rada" style="justify-content: space-between;">
            <span class="drobne">Zdroj: {data.zdroj}</span>
            <span class="znacka">@data<span>.cesky</span></span>
          </div>
        </div>

        <div class="sloupec" style="gap: 1.25rem;">
          <h2>Co z toho plyne</h2>
          <Content />
        </div>

        {data.metodika && (
          <div class="karta sloupec">
            <h2 style="font-size: 1.3rem;">Metodika</h2>
            <p>{data.metodika}</p>
            <p class="drobne">
              Našel jsi chybu? Napiš na
              <a href="mailto:data.cesky@gmail.com">data.cesky@gmail.com</a>.
            </p>
          </div>
        )}
      </div>

      <aside class="sloupec" style="gap: 1.25rem;">
        <div class="karta sloupec">
          <h2 style="font-size: 1.1rem;">Zdroj</h2>
          <p style="font-weight: 600;">{data.zdroj}</p>
          {data.dataStazena && <p class="drobne">Data převzata {datum(data.dataStazena)}</p>}
          <a href={data.zdrojUrl} style="font-weight: 800;">Otevřít zdroj</a>
        </div>

        <div class="karta sloupec">
          <h2 style="font-size: 1.1rem;">Stáhnout</h2>
          {data.obrazek && (
            <a class="tlacitko tlacitko--plny" href={data.obrazek} download>Obrázek grafu</a>
          )}
          {data.dataOtevrena && data.dataSoubor ? (
            <a class="tlacitko" href={data.dataSoubor} download>Data v CSV</a>
          ) : (
            <>
              <button class="tlacitko" type="button" disabled aria-describedby="csv-pozn">
                Data nejsou ke stažení
              </button>
              <p class="drobne" id="csv-pozn">
                Data nejsou otevřená, proto je tu nesdílíme. U dat z ČSÚ nebo Eurostatu tu CSV najdeš.
              </p>
            </>
          )}
        </div>

        {(data.instagram || data.tiktok) && (
          <div class="karta sloupec">
            <h2 style="font-size: 1.1rem;">Animovaná verze</h2>
            {data.instagram && <a class="tlacitko" href={data.instagram}>Instagram</a>}
            {data.tiktok && <a class="tlacitko" href={data.tiktok}>TikTok</a>}
          </div>
        )}

        <div class="karta sloupec">
          <h2 style="font-size: 1.1rem;">Sdílet a převzít</h2>
          <p class="drobne">
            Graf můžeš převzít i upravit. Uveď autora @data.cesky, odkaz na tuto stránku a licenci
            <a href="https://creativecommons.org/licenses/by/4.0/deed.cs">CC BY 4.0</a>.
          </p>
        </div>
      </aside>
    </div>

    {souvisejici.length > 0 && (
      <section class="sloupec" style="margin-top: 3rem;">
        <h2>Související grafy</h2>
        <ul class="mrizka">
          {souvisejici.map((g) => <GrafCard id={g.id} data={g.data} />)}
        </ul>
      </section>
    )}
  </article>
</Base>
