  const BARVY_HRACU = ['#F08829', '#1E9E91', '#3F7FBF', '#D8473B', '#8E6CC9', '#D39B17'];
  // Vlajky, které jsou k nerozeznání, nikdy nedáváme do jedné otázky
  const DVOJCATA: Record<string, string> = { MCO: 'IDN', IDN: 'MCO', TCD: 'ROU', ROU: 'TCD' };
  const RADKY_RUBU = ['cap', 'cont', 'cur', 'lang', 'nb'];
  const NAPOVEDY: Record<string, string> = {
    cont: 'U států na pomezí kontinentů platí obě odpovědi.',
    nb: 'Počítají se pozemní hranice se státy. Na mapě jsou sousedé vybarvení.',
    lang: 'Stačí trefit jeden z úředních jazyků.',
    cap: 'Když má stát hlavních měst víc, stačí jedno.',
  };

  let ZEME: Zeme[] = [];
  let MAPA: Mapa;
  const PODLE: Record<string, Zeme> = {};
  let VSE: number[] = [];

  const vlajka = (z: Zeme, cls = '') => `<img class="${cls}" src="/vlajky/${z.a2.toLowerCase()}.svg" alt="" width="640" height="480" draggable="false" decoding="async">`;

  /* ============ MAPA ============ */
  function mapaSVG(z: Zeme, { mesto = true, sousede = true, vlozka = true } = {}) {
    const A = 1.75;
    let x0: number, y0: number, x1: number, y1: number;
    if (z.box) [x0, y0, x1, y1] = z.box; else { x0 = x1 = z.pt[0]; y0 = y1 = z.pt[1]; }
    const bw = x1 - x0, bh = y1 - y0, cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
    let w = Math.max(bw * 1.5, bh * 1.5 * A, 520); w = Math.min(w, MAPA.W); const h = w / A;
    const vx = cx - w / 2; let vy = cy - h / 2; vy = Math.max(-h * 0.05, Math.min(vy, MAPA.H - h * 0.95));
    const sw = (w / 650).toFixed(1);
    const male = !z.map || z.ar < (w * 0.05) ** 2;
    let s = `<svg viewBox="${vx | 0} ${vy | 0} ${w | 0} ${h | 0}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Poloha státu ${esc(z.n)} na mapě"><rect x="${(vx - 50) | 0}" y="${(vy - 50) | 0}" width="${(w + 100) | 0}" height="${(h + 100) | 0}" style="fill:var(--more-svetle)"/><use href="#hraW" style="fill:var(--pevnina);stroke:var(--line)" stroke-width="${sw}"/>`;
    if (sousede) for (const n of z.nb) if (PODLE[n]?.map) s += `<use href="#hm${n}" style="fill:var(--cesko-plocha);stroke:var(--obrys)" stroke-width="${sw}"/>`;
    if (z.map) s += `<use href="#hm${z.c}" style="fill:var(--orange);stroke:var(--obrys)" stroke-width="${sw}"/>`;
    if (male) {
      const r1 = (w * 0.022).toFixed(1), r2 = (w * 0.055).toFixed(1);
      s += `<circle cx="${z.pt[0]}" cy="${z.pt[1]}" r="${r1}" fill="none" style="stroke:var(--orange)" stroke-width="${(w * 0.007).toFixed(1)}"><animate attributeName="r" values="${r1};${r2};${r1}" dur="1.8s" repeatCount="indefinite"/><animate attributeName="opacity" values="1;.35;1" dur="1.8s" repeatCount="indefinite"/></circle>`;
    }
    if (mesto && z.cp) s += `<circle cx="${z.cp[0]}" cy="${z.cp[1]}" r="${(w * 0.011).toFixed(1)}" style="fill:var(--navy);stroke:var(--obrys)" stroke-width="${(w * 0.004).toFixed(1)}"/>`;
    s += '</svg>';
    if (vlozka) s += `<svg class="hra-vlozka" viewBox="-40 -40 ${MAPA.W + 80} ${MAPA.H + 80}" aria-hidden="true"><path d="${MAPA.sphere}" style="fill:var(--more-svetle);stroke:var(--obrys)" stroke-width="90"/><use href="#hraW" style="fill:var(--line-2)"/><circle cx="${z.pt[0]}" cy="${z.pt[1]}" r="380" style="fill:var(--orange);stroke:var(--obrys)" stroke-width="110"/></svg>`;
    return s;
  }

  /* ============ KARTA ============ */
  const hodnota = (z: Zeme, k: string) => {
    switch (k) {
      case 'n': return z.n; case 'cont': return z.contTxt; case 'cur': return z.cur;
      case 'nb': return String(z.nb.length); case 'lang': return z.lang; case 'cap': return z.cap;
    }
    return '';
  };
  function sousedeHTML(z: Zeme) {
    const n = z.nb.length;
    let s = String(n);
    s += n ? `<small>${z.nb.map((x) => esc(PODLE[x].n)).join(', ')}</small>` : '<small>žádný pozemní soused</small>';
    if (z.nbn) s += `<small>${esc(z.nbn)}</small>`;
    return s;
  }
  function kartaHTML(z: Zeme, { zvyr = '', tip = false } = {}) {
    const radek = (k: string) => {
      const kat = KAT.find((x) => x.k === k)!;
      const v = k === 'nb' ? sousedeHTML(z) : esc(hodnota(z, k));
      return `<div class="hra-radek${zvyr === k ? ' zvyr' : ''}" style="--rc:${kat.barva}"><span class="hra-radek__ikona">${ik(kat.ik, 16)}</span><div><div class="hra-radek__stitek">${kat.nazev}</div><div class="hra-radek__hodnota">${v}</div></div></div>`;
    };
    return `<div class="hra-karta rozdat">
      <div class="hra-strana hra-lic">${vlajka(z)}<span class="hra-lic__cislo">№ ${z.num}</span>${tip ? '<span class="hra-lic__tip">klepnutím kartu otočíš</span>' : ''}<span class="hra-lic__znacka">data<span>.cesky</span></span></div>
      <div class="hra-strana hra-rub">
        <div class="hra-rub__hlava${zvyr === 'n' ? ' zvyr' : ''}">${vlajka(z)}<div class="hra-rub__nazev">${esc(z.n)}</div><div class="hra-rub__cislo">№ ${z.num}</div></div>
        <div class="hra-rub__mapa">${mapaSVG(z)}</div>
        <div class="hra-radky">${RADKY_RUBU.map(radek).join('')}</div>
      </div></div>`;
  }

  /* ============ ZVUKY, TOAST, KONFETY ============ */
  let AC: AudioContext | null = null;
  let ztlumeno = ulozeni.get('ticho', false);
  function ton(f: number, t0: number, d: number, typ: OscillatorType = 'sine', v = 0.16) {
    const ac = AC!; const o = ac.createOscillator(), g = ac.createGain();
    o.type = typ; o.frequency.setValueAtTime(f, ac.currentTime + t0);
    g.gain.setValueAtTime(0, ac.currentTime + t0); g.gain.linearRampToValueAtTime(v, ac.currentTime + t0 + 0.01);
    g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + t0 + d);
    o.connect(g).connect(ac.destination); o.start(ac.currentTime + t0); o.stop(ac.currentTime + t0 + d + 0.05);
  }
  function zvuk(t: string) {
    if (ztlumeno) return;
    try {
      AC = AC || new (window.AudioContext || (window as any).webkitAudioContext)();
      if (AC.state === 'suspended') AC.resume();
      if (t === 'hod') for (let i = 0; i < 9; i++) ton(180 + Math.random() * 260, i * 0.09, 0.05, 'square', 0.05);
      else if (t === 'otoc') { ton(500, 0, 0.12, 'triangle', 0.09); ton(800, 0.05, 0.1, 'triangle', 0.07); }
      else if (t === 'ano') { ton(660, 0, 0.14); ton(990, 0.11, 0.22); }
      else if (t === 'ne') { ton(200, 0, 0.25, 'sawtooth', 0.08); ton(150, 0.12, 0.3, 'sawtooth', 0.07); }
      else if (t === 'tik') ton(1200, 0, 0.04, 'square', 0.04);
      else if (t === 'vyhra') [523, 659, 784, 1047].forEach((f, i) => ton(f, i * 0.12, 0.3, 'triangle', 0.13));
      else if (t === 'mince') { ton(988, 0, 0.08, 'square', 0.07); ton(1319, 0.08, 0.25, 'square', 0.07); }
    } catch {}
  }
  let toastCas = 0;
  function toast(text: string) {
    const t = $('[data-hra-toast]'); t.textContent = text; t.classList.add('videt');
    clearTimeout(toastCas); toastCas = window.setTimeout(() => t.classList.remove('videt'), 2200);
  }
  function konfety() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const box = document.createElement('div'); box.className = 'hra-konfety';
    const barvy = ['#F08829', '#1E9E91', '#1B2A4A', '#F6C08C', '#3F7FBF', '#D8473B'];
    for (let i = 0; i < 90; i++) {
      const p = document.createElement('i');
      p.style.left = Math.random() * 100 + '%'; p.style.background = vyber(barvy);
      p.style.animationDuration = 1.8 + Math.random() * 1.8 + 's'; p.style.animationDelay = Math.random() * 0.6 + 's';
      p.style.transform = `rotate(${rnd(360)}deg)`; box.appendChild(p);
    }
    document.body.appendChild(box); setTimeout(() => box.remove(), 4500);
  }

  /* ============ OVLÁDÁNÍ ============ */
  const AKCE: Record<string, (b: HTMLElement, e: Event) => void> = {};
  koren.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-a]'); if (b && AKCE[b.dataset.a!]) AKCE[b.dataset.a!](b, e); });
  modal.addEventListener('click', (e) => {
    if (e.target === modal) { zavri(); return; }
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-a]'); if (b && AKCE[b.dataset.a!]) AKCE[b.dataset.a!](b, e);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) { zavri(); return; }
    // Ctrl+Z / ⌘Z = krok zpět (když se zrovna nepíše do pole)
    if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z' && !(e.target as HTMLElement).matches('input, textarea') && ZPET?.mozno()) { e.preventDefault(); AKCE.krokZpet(koren, e); }
    // Slepá mapa: + / − přibližují, 0 ukáže celou oblast
    if (mapa && modal.hidden && !e.ctrlKey && !e.metaKey && !e.altKey && !(e.target as HTMLElement).matches('input, textarea')) {
      if (e.key === '+' || e.key === '=') mapa.plus();
      else if (e.key === '-') mapa.minus();
      else if (e.key === '0') mapa.domu();
    }
  });
  function otevri(html: string) { modal.innerHTML = html; modal.hidden = false; }
  function zavri() { modal.hidden = true; modal.innerHTML = ''; }
  AKCE.zavri = zavri;
  AKCE.zvuk = (b) => { ztlumeno = !ztlumeno; ulozeni.set('ticho', ztlumeno); b.innerHTML = ik(ztlumeno ? 'voloff' : 'vol', 19); b.setAttribute('aria-label', ztlumeno ? 'Zapnout zvuk' : 'Vypnout zvuk'); if (!ztlumeno) zvuk('tik'); };
  const tlZvuk = () => `<button class="hra-kulate" data-a="zvuk" aria-label="${ztlumeno ? 'Zapnout zvuk' : 'Vypnout zvuk'}">${ik(ztlumeno ? 'voloff' : 'vol', 19)}</button>`;

  /* ============ CELÁ OBRAZOVKA ============
     Překryv přes celý web (hlavička i spodní lišta zmizí) a k tomu Fullscreen API, kde ho prohlížeč umí.
     Na telefonu je zapnutá rovnou při startu hry, na počítači po kliknutí. Volba se pamatuje. */
  let cela = false, apiCela = false;
  // Výchozí zapnuto na telefonu, i když je otočený na šířku
  let celaPref: boolean = ulozeni.get('cela', matchMedia('(max-width: 760px), (pointer: coarse) and (max-height: 560px)').matches);
  const tlCela = () => `<button class="hra-kulate" data-a="cela" aria-pressed="${cela}" aria-label="${cela ? 'Ukončit celou obrazovku' : 'Hra na celou obrazovku'}" title="${cela ? 'Ukončit celou obrazovku' : 'Celá obrazovka'}">${ik(cela ? 'zmensit' : 'cela', 19)}</button>`;
  function nastavCelou(on: boolean, api = true) {
    cela = on;
    koren.classList.toggle('cela', on);
    document.documentElement.classList.toggle('hry-cela', on);
    if (on && api) zapniFullscreen();
    if (!on) { vypniFullscreen(); requestAnimationFrame(() => app.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior })); }
    document.querySelectorAll<HTMLElement>('[data-a="cela"]').forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', on ? 'Ukončit celou obrazovku' : 'Hra na celou obrazovku');
      b.title = on ? 'Ukončit celou obrazovku' : 'Celá obrazovka';
      if (b.classList.contains('hra-kulate')) b.innerHTML = ik(on ? 'zmensit' : 'cela', 19);
    });
    if (on) app.scrollTop = 0;
  }
  AKCE.cela = () => { celaPref = !cela; ulozeni.set('cela', celaPref); nastavCelou(!cela); };
  // Volá se z kliknutí na start hry, takže prohlížeč celou obrazovku dovolí
  const vstupDoHry = () => { if (celaPref && !cela) nastavCelou(true); };
  const zmenaFs = () => {
    if (jeFullscreen()) apiCela = true;
    else if (apiCela) { apiCela = false; if (cela) nastavCelou(false, false); }
  };
  document.addEventListener('fullscreenchange', zmenaFs);
  document.addEventListener('webkitfullscreenchange', zmenaFs);

  /* ============ KROK ZPĚT ============
     Každý režim, který krok zpět umí, si nastaví ZPET. Tlačítko v liště se podle toho zapne nebo vypne. */
  let ZPET: { mozno: () => boolean; proved: () => void } | null = null;
  const aktualizujZpet = () => document.querySelectorAll<HTMLButtonElement>('[data-krok-zpet]').forEach((b) => (b.disabled = !ZPET?.mozno()));
  AKCE.krokZpet = () => { if (ZPET?.mozno()) { ZPET.proved(); zvuk('otoc'); aktualizujZpet(); } };
  const tlZpet = () => `<button class="hra-kulate" data-a="krokZpet" data-krok-zpet aria-label="Krok zpět" title="Krok zpět (Ctrl+Z)" disabled>${ik('zpet', 19)}</button>`;

  const lista = (titul: string, podtitul = '', zpet = 'menu', krokZpet = false) => `<div class="hra-lista"><button class="hra-kulate" data-a="${zpet}" aria-label="Zpět">${ik('back', 19)}</button><div class="hra-lista__titul" data-titul>${titul}${podtitul ? `<small>${podtitul}</small>` : ''}</div>${krokZpet ? tlZpet() : ''}${tlCela()}${tlZvuk()}</div>`;
  let stopky: (() => void)[] = [];
  function obrazovka(html: string, hraje = true, vejit = false) {
    stopky.forEach((f) => f()); stopky = [];
    ZPET = null;
    koren.classList.toggle('hraje', hraje);
    app.classList.toggle('vejit', vejit);
    app.innerHTML = html;
    if (cela) { app.scrollTop = 0; return; }
    const r = app.getBoundingClientRect();
    const odsazeni = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hlavicka-vyska')) || 64) + 12;
    if (r.top < odsazeni - 2 || (hraje && r.top > innerHeight * 0.4)) scrollTo({ top: Math.max(0, r.top + scrollY - odsazeni), behavior: 'instant' as ScrollBehavior });
  }
  const segment = (skupina: string, hodnoty: number[], aktivni: number, popis: (v: number) => string, akce = 'seg') =>
    `<div class="segment" role="group" data-skupina="${skupina}">${hodnoty.map((v) => `<button type="button" data-a="${akce}" data-v="${v}" aria-pressed="${v === aktivni}">${popis(v)}</button>`).join('')}</div>`;
  const kontinentyChips = (vybrane: string[], akce: string) =>
    `<div class="rada" style="gap:.5rem">${Object.keys(KONT).map((k) => `<button type="button" class="chip" data-a="${akce}" data-k="${k}" aria-pressed="${vybrane.includes(k)}">${KONT_KRATKE[k]}</button>`).join('')}</div>`;
  const zKontinentu = (k: string[]) => VSE.filter((i) => ZEME[i].cont.some((x) => k.includes(x)));
  const prepniVSeznamu = (a: string[], k: string) => { const i = a.indexOf(k); if (i >= 0) a.splice(i, 1); else a.push(k); return i < 0; };

  /* ============ ROZCESTNÍK ============ */
  /* ============ DLOUHODOBÉ SKÓRE ============ */
  const objeveno = (p: Profil) => new Set(p.objev.vlajky ?? []);
  function profilHTML(p: Profil, tlacitko = true) {
    const u = uroven(p.skore), n = objeveno(p).size, tag = tlacitko ? 'button' : 'div';
    return `<${tag} class="hry-profil"${tlacitko ? ' data-a="statistiky" aria-label="Tvoje skóre a statistiky"' : ''}>
      <span class="hry-uroven" style="--p:${u.podil.toFixed(3)}"><b>${u.cislo}</b></span>
      <span class="hry-profil__text"><b>${esc(u.nazev)}</b><small>${cislo(p.skore)} ${sklonuj(p.skore, 'bod', 'body', 'bodů')} · další úroveň za ${cislo(u.chybi)}</small><span class="hry-pruh"><i style="width:${(u.podil * 100).toFixed(1)}%"></i></span></span>
      <span class="hry-profil__cislo"><b>${n}</b><small>z ${ZEME.length} států</small></span></${tag}>`;
  }
  // Výsledek do celkového skóre + případná nová úroveň (pro okna s výsledkem)
  function ziskHTML(pred: number, body: number) {
    const a = uroven(pred), b = uroven(nactiProfil().skore);
    let s = body > 0 ? `<p class="hry-zisk">${ik('plus', 16, 2.6)}${cislo(body)} ${sklonuj(body, 'bod', 'body', 'bodů')} do celkového skóre</p>` : '';
    if (b.cislo > a.cislo) s += `<div class="hry-levelup">${ik('level', 18)} Nová úroveň ${b.cislo}: ${esc(b.nazev)}</div>`;
    return s;
  }
  function mapaObjevu(p: Profil) {
    const o = objeveno(p);
    let s = `<svg viewBox="-40 -40 ${MAPA.W + 80} ${MAPA.H + 80}" role="img" aria-label="Mapa objevených států"><path d="${MAPA.sphere}" style="fill:var(--more-svetle);stroke:var(--obrys)" stroke-width="16"/><use href="#hraW" style="fill:var(--pevnina);stroke:var(--line)" stroke-width="7"/>`;
    for (const z of ZEME) {
      if (!o.has(z.c)) continue;
      if (z.map && z.ar > 12000) s += `<use href="#hm${z.c}" style="fill:var(--orange);stroke:var(--obrys)" stroke-width="7"/>`;
      else s += `<circle cx="${z.pt[0]}" cy="${z.pt[1]}" r="46" style="fill:var(--orange);stroke:var(--obrys)" stroke-width="12"/>`;
    }
    return s + '</svg>';
  }
  AKCE.statistiky = () => {
    const p = nactiProfil(), h = p.hry.vlajky ?? {}, o = objeveno(p);
    const her = (h.deskovky ?? 0) + (h.bleskovky ?? 0) + (h.mapy ?? 0);
    const usp = p.odpovedi ? Math.round((p.spravne / p.odpovedi) * 100) + ' %' : '–';
    const kont = Object.keys(KONT).map((k) => {
      const vse = ZEME.filter((z) => z.cont[0] === k), ma = vse.filter((z) => o.has(z.c)).length;
      return `<div><span>${KONT_KRATKE[k]}</span><div class="hra-postup"><i style="width:${(ma / vse.length) * 100}%"></i></div><span>${ma}/${vse.length}</span></div>`;
    }).join('');
    const sin = sinSlavy(p);
    otevri(`<div class="hra-okno hra-okno--stat" role="dialog" aria-modal="true" aria-label="Tvoje skóre">
      <h2>Tvoje skóre</h2>${profilHTML(p, false)}
      <div class="hry-cisla" style="margin-top:.8rem">
        <div><b>${her}</b><small>${sklonuj(her, 'odehraná hra', 'odehrané hry', 'odehraných her')}</small></div>
        <div><b>${h.rekord ?? 0}</b><small>rekord bleskovky</small></div>
        <div><b>${usp}</b><small>správných odpovědí</small></div>
        <div><b>${p.den.serie}</b><small>${sklonuj(p.den.serie, 'den', 'dny', 'dní')} v řadě</small></div>
      </div>
      <h3>${ik('map', 18)} Objevené státy: ${o.size} z ${ZEME.length}</h3>
      <p>Stát objevíš, když o něm správně odpovíš v kterékoli hře.</p>
      <div class="hra-objev-mapa">${mapaObjevu(p)}</div>
      <div class="hra-kont-objev">${kont}</div>
      ${sin.length ? `<h3>${ik('trophy', 18)} Síň slávy deskové hry</h3><div class="hry-sin">${sin.slice(0, 8).map((s, i) => `<div class="hry-sin__radek"><span class="hry-sin__misto">${i + 1}.</span><span class="hry-sin__jmeno">${esc(s.jmeno)}<small>${s.hry} ${sklonuj(s.hry, 'hra', 'hry', 'her')} · ${cislo(s.body)} ${sklonuj(s.body, 'bod', 'body', 'bodů')}</small></span><span class="hry-sin__cislo"><b>${s.vyhry}</b><small>${sklonuj(s.vyhry, 'výhra', 'výhry', 'výher')}</small></span></div>`).join('')}</div>` : ''}
      <p class="drobne" style="margin-top:1rem">Skóre se ukládá jen v tomhle prohlížeči. Body ze všech her na webu se sčítají dohromady, celkový přehled je na stránce <a href="/hry/">Hry</a>.</p>
      <div class="hra-dva" style="margin-top:1rem"><button class="tlacitko" data-a="smazatSkore">Smazat skóre</button><button class="tlacitko tlacitko--plny" data-a="zavri">Zavřít</button></div></div>`);
  };
  AKCE.smazatSkore = () => otevri(`<div class="hra-okno" role="dialog" aria-modal="true" aria-label="Smazat skóre" style="text-align:center"><h2>Smazat skóre?</h2><p>Smaže se celkové skóre, úroveň, objevené státy, rekordy i síň slávy ve všech hrách. Vrátit to nejde.</p><div class="hra-dva" style="margin-top:1rem"><button class="tlacitko" data-a="statistiky">Nechat</button><button class="tlacitko hra-tl-ne" data-a="smazatAno">Smazat</button></div></div>`);
  AKCE.smazatAno = () => { smazProfil(); zavri(); menu(); toast('Skóre je smazané'); };

  function menu() {
    zavri();
    const vejir = zamichej(VSE).slice(0, 3).map((i) => ZEME[i]);
    const p = nactiProfil();
    const rekord = p.hry.vlajky?.rekord ?? 0;
    obrazovka(`<div class="hra-menu-lista">${profilHTML(p)}<div class="hra-menu-lista__tl">${tlCela()}${tlZvuk()}</div></div>
    <div class="hra-menu">
      <button class="hra-dl hra-dl--hlavni" data-a="nastaveni">
