    const rekord = rekordBleskovky(); const novy = B.body > rekord && B.body > 0;
    const pred = nactiProfil().skore;
    zapis({ hra: 'vlajky', skore: B.body, her: 1, spravne: B.ok, odpovedi: B.odp, cisla: { bleskovky: 1 }, rekordy: { rekord: B.body }, objev: [...new Set(B.objev)] });
    zvuk('vyhra'); if (novy) konfety();
    const chyby = [...new Map(B.chyby.map((z) => [z.c, z])).values()];
    const body = B.body; B = null;
    obrazovka(`<div class="hra-uzke">${lista('Bleskovka', 'Konec')}
      <div class="hra-panel" style="text-align:center"><span class="nadhlavi">${novy ? 'Nový rekord' : 'Výsledek'}</span><div class="hra-velke-cislo" style="margin-top:.4rem">${body}</div><p class="drobne">${novy ? 'Lepší než kdy dřív.' : 'Rekord: ' + Math.max(rekord, body)}</p>${ziskHTML(pred, body)}</div>
      ${chyby.length ? `<div class="hra-panel"><h3>${ik('map', 18)} Na tyhle se podívej</h3>${chyby.map((z) => `<div class="hra-chyba">${vlajka(z)}<div>${esc(z.n)}<small>${esc(z.capShort)} · ${esc(z.contTxt)}</small></div></div>`).join('')}</div>` : ''}
      <div class="hra-dva"><button class="tlacitko" data-a="menu">Menu</button><button class="tlacitko tlacitko--oranzovy" data-a="bleskovka">Znovu</button></div></div>`);
  }

  /* ============ STUDOVNA ============ */
  // Každé „Umím“ přidá bod do celkového skóre hned (studovna se často nedojede), krok zpět ho zase vezme
  let S: { fronta: number[]; celkem: number; umim: number; znovu: number } | null = null;
  let SH: { s: string; z: Zaznam | null }[] = [];
  const SK: string[] = ulozeni.get('studovnaKont', Object.keys(KONT));
  AKCE.studovnaUvod = () => {
    obrazovka(`<div class="hra-uzke">${lista('Studovna', 'Kartičky na procvičení')}
      <div class="hra-panel"><h3>${ik('books', 18)} Jak to funguje</h3><p class="perex" style="font-size:.98rem">Podívej se na vlajku, zkus si vybavit vše o státu a otoč kartu. Co ještě neumíš, se ti za chvíli vrátí. Každá karta, kterou umíš, je bod do celkového skóre.</p></div>
      <div class="hra-panel"><h3>${ik('kont', 18)} Které kontinenty</h3>${kontinentyChips(SK, 'skont')}<p class="hra-pocet">${zKontinentu(SK).length} karet</p></div>
      <button class="tlacitko tlacitko--oranzovy tlacitko--plna-sirka" data-a="studovna" ${zKontinentu(SK).length ? '' : 'disabled'}>${ik('books', 20)} Začít</button></div>`);
  };
  AKCE.skont = (b) => { prepniVSeznamu(SK, b.dataset.k!); ulozeni.set('studovnaKont', SK); AKCE.studovnaUvod(b, new Event('x')); };
  AKCE.studovna = () => { vstupDoHry(); const f = zamichej(zKontinentu(SK)); S = { fronta: f, celkem: f.length, umim: 0, znovu: 0 }; SH = []; studovnaKarta(); };
  function studovnaKarta() {
    if (!S) return;
    if (!S.fronta.length) {
      const pred = nactiProfil().skore;
      zapis({ hra: 'vlajky', her: 1, cisla: { studovnyHotovo: 1 } });
      zvuk('vyhra'); konfety(); SH = [];
      obrazovka(`<div class="hra-uzke">${lista('Studovna', 'Hotovo', 'studovnaUvod')}<div class="hra-panel" style="text-align:center"><div class="hra-pohar">${ik('trophy', 32)}</div><h2 style="font-size:1.5rem">Hotovo!</h2><p class="drobne">Prošel/prošla jsi všech ${S.celkem} karet. Opakování navíc: ${S.znovu}×.</p>${ziskHTML(pred - S.celkem, S.celkem)}</div><div class="hra-dva"><button class="tlacitko" data-a="menu">Menu</button><button class="tlacitko tlacitko--oranzovy" data-a="studovna">Znovu</button></div></div>`);
      return;
    }
    const z = ZEME[S.fronta[0]];
    obrazovka(`<div class="hra-uzke hra-fit hra-stud" style="max-width:440px">${lista('Studovna', `umím ${S.umim} z ${S.celkem} · zbývá ${S.fronta.length}`, 'studovnaUvod', true)}
      <div class="hra-postup"><i style="width:${(S.umim / S.celkem) * 100}%"></i></div>
      <div class="hra-misto"><div class="hra-karta-obal" data-skarta>${kartaHTML(z, { tip: true })}</div></div>
      <div class="hra-dva" style="margin-top:1.1rem" data-studovna-tl><button class="tlacitko hra-tl-ne" data-a="sne">${ik('x', 18)} Ještě ne</button><button class="tlacitko hra-tl-ano" data-a="sano">${ik('check', 18)} Umím</button></div></div>`, true, true);
    ZPET = { mozno: () => SH.length > 0, proved: zpetStudovna };
    aktualizujZpet();
    $('[data-skarta] .hra-karta', app).addEventListener('click', (e) => { (e.currentTarget as HTMLElement).classList.toggle('otocena'); zvuk('otoc'); });
    ukazDole('[data-studovna-tl]');
  }
  const krokStudovny = (z: Zaznam | null) => { SH.push({ s: JSON.stringify(S), z }); if (SH.length > 60) SH.shift(); };
  function zpetStudovna() {
    const k = SH.pop(); if (!k) return;
    if (k.z) vrat(k.z);
    S = JSON.parse(k.s); studovnaKarta();
  }
  AKCE.sano = () => {
    if (!S) return;
    const c = ZEME[S.fronta[0]].c, pred = JSON.stringify(S);
    const z = zapis({ hra: 'vlajky', skore: 1, cisla: { studovna: 1 }, objev: [c] });
    SH.push({ s: pred, z }); if (SH.length > 60) SH.shift();
    S.fronta.shift(); S.umim++; zvuk('ano'); studovnaKarta();
  };
  AKCE.sne = () => { if (!S) return; krokStudovny(null); const x = S.fronta.shift()!; S.fronta.splice(Math.min(S.fronta.length, 3 + rnd(3)), 0, x); S.znovu++; zvuk('tik'); studovnaKarta(); };

  /* ============ ATLAS ============ */
  const AK: string[] = Object.keys(KONT); let AQ = '';
  AKCE.atlas = () => {
    obrazovka(`${lista('Atlas karet', `${ZEME.length} států`)}
      <div class="hledani hra-atlas-hledat" style="width:min(100%,420px)"><div class="hledani__pole">${ik('search', 18, 2.2)}<input type="search" data-aq placeholder="Hledat stát, město, měnu…" value="${esc(AQ)}" autocomplete="off" aria-label="Hledat v atlasu"></div></div>
      ${kontinentyChips(AK, 'akont')}<p class="hra-pocet" data-acnt></p><div class="hra-mrizka" data-agrid></div>`);
    $<HTMLInputElement>('[data-aq]', app).addEventListener('input', (e) => { AQ = (e.target as HTMLInputElement).value; atlasMrizka(); });
    atlasMrizka();
  };
  const atlasSeznam = () => { const q = normalizuj(AQ.trim()); return ZEME.filter((z) => z.cont.some((k) => AK.includes(k)) && (!q || normalizuj([z.n, z.cap, z.cur, z.lang].join(' ')).includes(q))); };
  function atlasMrizka() {
    const L = atlasSeznam();
    $('[data-acnt]', app).textContent = L.length === 1 ? '1 karta' : L.length >= 2 && L.length <= 4 ? `${L.length} karty` : `${L.length} karet`;
    $('[data-agrid]', app).innerHTML = L.map((z) => `<button class="hra-vlajka-dl" data-a="aotevri" data-c="${z.c}">${vlajka(z)}<span>${esc(z.n)}</span></button>`).join('');
  }
  AKCE.akont = (b) => { const on = prepniVSeznamu(AK, b.dataset.k!); b.setAttribute('aria-pressed', String(on)); atlasMrizka(); };
  AKCE.aotevri = (b) => {
    const L = atlasSeznam(); let idx = L.findIndex((z) => z.c === b.dataset.c);
    const ukaz = () => {
      otevri(`<div class="hra-okno hra-okno--karta" role="dialog" aria-modal="true" aria-label="${esc(L[idx].n)}"><div class="hra-karta-obal">${kartaHTML(L[idx], { tip: true })}</div>
        <div class="hra-atlas-nav"><button class="tlacitko" data-a="apredchozi" aria-label="Předchozí">${ik('prev', 20)}</button><button class="tlacitko" data-a="zavri">Zavřít</button><button class="tlacitko" data-a="adalsi" aria-label="Další">${ik('dalsi', 20)}</button></div></div>`);
      $('.hra-karta', modal).addEventListener('click', (e) => { (e.currentTarget as HTMLElement).classList.toggle('otocena'); zvuk('otoc'); });
    };
    AKCE.apredchozi = () => { idx = (idx - 1 + L.length) % L.length; ukaz(); };
    AKCE.adalsi = () => { idx = (idx + 1) % L.length; ukaz(); };
    ukaz();
  };

  /* ============ SLEPÁ MAPA ============
     Mapa bez popisků, hráč ťuká na státy. Engine (kreslení, zoom, chytré ťuknutí) je v src/lib/slepa-mapa.ts. */
  // Výřezy kontinentů v souřadnicích mapy (Natural Earth 10 000 × 5 200). Samoa a Tonga jsou přesunuté za Fidži.
  const OBLASTI: Record<string, Box> = {
    EU: [4440, 430, 6320, 1500], AS: [5620, 560, 8920, 2980], AF: [4290, 1380, 6600, 3740],
    NA: [1000, 360, 3950, 2380], SA: [2730, 2190, 4050, 4400], OC: [8000, 2220, 10080, 4370],
  };
  const SVET: Box = [150, 250, 9950, 4450];
  const PREKLOPIT = ['WSM', 'TON'];
  const TYPY_MAPY = [
    { k: 'n', nazev: 'Název', otazka: 'Najdi stát', ik: 'cil' },
    { k: 'vlajka', nazev: 'Vlajka', otazka: 'Najdi stát s vlajkou', ik: 'stat' },
    { k: 'cap', nazev: 'Hlavní město', otazka: 'Kde je hlavní město', ik: 'mesto' },
  ];
  type NastaveniMapy = { kont: string[]; typy: string[]; pocet: number; hranice: boolean };
  type KoloMapy = {
    fronta: string[]; typy: string[]; pos: number; pokus: number; stav: Record<string, StavStatu>; zamek: boolean;
    start: number; cas: number; konec: boolean; chyby: boolean; zaznam: Zaznam | null; predSkore: number;
    rekord: { klic: string; pred: { p: number; t: number } | null } | null;
  };
  const SM: NastaveniMapy = { kont: ['EU'], typy: ['n'], pocet: 0, hranice: true, ...ulozeni.get<Partial<NastaveniMapy>>('mapa', {}) };
  if (!SM.kont?.length) SM.kont = ['EU'];
  if (!SM.typy?.length) SM.typy = ['n'];
  const ulozSM = () => ulozeni.set('mapa', SM);
  let mapa: SlepaMapa | null = null;
  let M: KoloMapy | null = null;
  let MH: string[] = []; // krok zpět: snímky kola před každým ťuknutím
  let casMapy = 0;
  let priblizeniTipu = 0;
  const nazevOblasti = (k: string[]) => (k.length === 6 ? 'Celý svět' : k.map((x) => KONT_KRATKE[x]).join(', '));
  const klicRekordu = (o: NastaveniMapy) => [...o.kont].sort().join('+') + (o.hranice ? '' : '-bez');
  const rekordyMapy = () => ulozeni.get<Record<string, { p: number; t: number }>>('mapaRekordy', {});
  const minuty = (ms: number) => { const s = Math.round(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
  function oblastMapy(kont: string[]): Box {
    if (kont.length === 6 || !kont.length) return SVET;
    const b = kont.map((k) => OBLASTI[k]);
    return [Math.min(...b.map((x) => x[0])), Math.min(...b.map((x) => x[1])), Math.max(...b.map((x) => x[2])), Math.max(...b.map((x) => x[3]))];
  }

  AKCE.slepaUvod = () => {
    zavri();
    const n = zKontinentu(SM.kont).length;
    const r = rekordyMapy()[klicRekordu(SM)];
    const vse = SM.kont.length === 6;
    obrazovka(`<div class="hra-uzke">${lista('Slepá mapa', 'Kde leží který stát')}
      <div class="hra-panel"><h3>${ik('cil', 18)} Jak to funguje</h3><p class="perex" style="font-size:.98rem">Mapa bez popisků. Hra řekne stát a ty na něj ťukneš. Na každý máš 3 pokusy a mapa se postupně vybarví podle toho, jak ti to šlo. Na konci si můžeš procvičit jen ty, které nevyšly.</p></div>
      <div class="hra-panel"><h3>${ik('kont', 18)} Oblast</h3>
        <div class="rada" style="gap:.5rem">${Object.keys(KONT).map((k) => `<button type="button" class="chip" data-a="smkont" data-k="${k}" aria-pressed="${!vse && SM.kont.includes(k)}">${KONT_KRATKE[k]}</button>`).join('')}<button type="button" class="chip" data-a="smsvet" aria-pressed="${vse}">Celý svět</button></div>
        <p class="hra-pocet">${n} ${sklonuj(n, 'stát', 'státy', 'států')}${r ? ` · tvůj rekord ${r.p} % napoprvé za ${minuty(r.t)}` : ''}</p></div>
      <div class="hra-panel"><h3>${ik('stat', 18)} Co hledáš</h3>
        <div class="rada" style="gap:.5rem">${TYPY_MAPY.map((t) => `<button type="button" class="chip" data-a="smtyp" data-k="${t.k}" aria-pressed="${SM.typy.includes(t.k)}">${t.nazev}</button>`).join('')}</div>
        <p class="hra-pocet">${SM.typy.length > 1 ? 'Otázky se střídají.' : SM.typy[0] === 'vlajka' ? 'Uvidíš jen vlajku, název ne.' : SM.typy[0] === 'cap' ? 'Uvidíš hlavní město a hledáš jeho stát.' : 'Uvidíš název státu.'}</p></div>
      <div class="hra-panel"><h3>${ik('graf', 18)} Kolik států</h3>${segment('pocet', [10, 20, 0], SM.pocet, (v) => (v ? String(v) : 'Všechny'), 'smpocet')}
        <div class="hra-volba" style="margin-top:.9rem;border-top:1px solid var(--line-jemna);padding-top:.75rem"><div><b>Hranice států</b><small>Bez hranic vidíš jen obrys pevniny. To je opravdová slepá mapa.</small></div><button type="button" class="prepinac-pilulka" data-a="smhranice" aria-pressed="${SM.hranice}">${SM.hranice ? 'Zapnuto' : 'Vypnuto'}</button></div>
        <div class="hra-volba"><div><b>Celá obrazovka</b><small>Mapa překryje web a vejde se na displej.</small></div><button type="button" class="prepinac-pilulka" data-a="celaPref" aria-pressed="${celaPref}">${celaPref ? 'Zapnuto' : 'Vypnuto'}</button></div></div>
      <button class="tlacitko tlacitko--oranzovy tlacitko--plna-sirka" data-a="slepa" ${n && SM.typy.length ? '' : 'disabled'}>${ik('cil', 20)} Začít</button></div>`);
  };
  AKCE.smkont = (b) => {
    if (SM.kont.length === 6) SM.kont = [b.dataset.k!];
    else { prepniVSeznamu(SM.kont, b.dataset.k!); if (!SM.kont.length) SM.kont = [b.dataset.k!]; }
    ulozSM(); AKCE.slepaUvod(b, new Event('x'));
  };
  AKCE.smsvet = (b) => { SM.kont = SM.kont.length === 6 ? ['EU'] : Object.keys(KONT); ulozSM(); AKCE.slepaUvod(b, new Event('x')); };
  AKCE.smtyp = (b) => { prepniVSeznamu(SM.typy, b.dataset.k!); if (!SM.typy.length) SM.typy = [b.dataset.k!]; ulozSM(); AKCE.slepaUvod(b, new Event('x')); };
  AKCE.smpocet = (b) => { SM.pocet = +b.dataset.v!; b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); ulozSM(); };
  AKCE.smhranice = (b) => { SM.hranice = !SM.hranice; ulozSM(); AKCE.slepaUvod(b, new Event('x')); };

  // Typ otázky pro stát: vlajka ne u dvojčat (Čad/Rumunsko, Monako/Indonésie), město ne, když zní jako stát
  function typOtazky(c: string) {
    const z = PODLE[c];
    const moz = SM.typy.filter((t) => !(t === 'vlajka' && DVOJCATA[c]) && !(t === 'cap' && normalizuj(z.capShort).startsWith(normalizuj(z.n).slice(0, 5))));
    return moz.length ? vyber(moz) : 'n';
  }
  // Místo zakryté kartou s otázkou a ovládáním, aby se oblast vešla do volné části mapy
  function okrajeMapy(): Okraje {
    const obal = app.querySelector<HTMLElement>('[data-sm]'); if (!obal) return {};
    const k = obal.querySelector<HTMLElement>('[data-smo]'), z = obal.querySelector<HTMLElement>('.sm-zoom'), konec = obal.querySelector<HTMLElement>('.sm-konec');
    const r = obal.getBoundingClientRect();
    const nahore = k && !konec ? k.getBoundingClientRect().bottom - r.top + 8 : 10;
    const dole = konec ? r.bottom - konec.getBoundingClientRect().top + 8 : z && innerWidth <= 700 ? r.bottom - z.getBoundingClientRect().top + 6 : 10;
    return { nahore, dole, vlevo: 10, vpravo: z && innerWidth > 700 ? 64 : 10 };
  }

  AKCE.slepa = () => startMapy(null);
  AKCE.smchyby = () => { if (!M) return; startMapy(M.fronta.filter((c) => M!.stav[c] > 1)); };
  function startMapy(chyby: string[] | null) {
    zavri(); vstupDoHry(); clearTimeout(casMapy);
    const aktivni = zKontinentu(SM.kont).map((i) => ZEME[i].c);
    let fronta = zamichej(chyby ?? aktivni);
    if (!chyby && SM.pocet) fronta = fronta.slice(0, SM.pocet);
    M = { fronta, typy: fronta.map(typOtazky), pos: 0, pokus: 0, stav: {}, zamek: false, start: Date.now(), cas: 0, konec: false, chyby: !!chyby, zaznam: null, predSkore: 0, rekord: null };
    MH = [];
    obrazovka(`<div class="hra-fit sm-hra">${lista('Slepá mapa', '', 'smkonec', true)}
      <div class="sm-mapa" data-sm>
        <div class="sm-otazka" data-smo></div>
        <div class="zoom-ovladani sm-zoom" role="group" aria-label="Přiblížení mapy">
          <button type="button" data-a="smplus" aria-label="Přiblížit">+</button>
          <button type="button" data-a="smminus" aria-label="Oddálit">−</button>
          <button type="button" data-a="smdomu" aria-label="Celá oblast" title="Celá oblast (0)">${ik('ramecek', 18)}</button>
        </div>
        <div class="zoom-napoveda" data-smnap hidden>Přiblížíš podržením Ctrl a kolečkem</div>
      </div></div>`, true, true);
    const obal = $('[data-sm]', app);
    let napCas = 0;
    const m = slepaMapa(obal, {
      W: MAPA.W, H: MAPA.H, other: MAPA.other, preklopit: PREKLOPIT,
      staty: ZEME.map((z) => ({ c: z.c, d: z.map ? MAPA.paths[z.c] : null, pt: z.pt, ar: z.ar })),
      naTuk: tukMapy,
      naPriblizeni: () => { if (priblizeniTipu++ < 2) zpravaMapy('info', `${ik('search', 16, 2.4)} Bylo tam víc států, tak jsem mapu přiblížil. Ťukni znovu.`); },
      kolecko: () => cela,
      napovedaKolecka: () => { const n = $('[data-smnap]', app); if (!n) return; n.hidden = false; clearTimeout(napCas); napCas = window.setTimeout(() => (n.hidden = true), 1400); },
    });
    mapa = m;
    // jen pro automatické testy při vývoji (v sestaveném webu se vynechá)
    if (import.meta.env.DEV) (window as any).__slepa = { mapa: m, kolo: () => M, zeme: PODLE };
    stopky.push(() => { m.znic(); if (mapa === m) mapa = null; clearTimeout(casMapy); });
    m.aktivni(aktivni); m.hranice(SM.hranice);
    const hodiny = window.setInterval(() => { if (M && !M.konec) titulMapy(); }, 1000);
    stopky.push(() => clearInterval(hodiny));
    ZPET = { mozno: () => MH.length > 0, proved: zpetMapy };
    otazkaMapy();
    // Oblast až po vykreslení karty, ať je známé, kolik místa zabírá
    requestAnimationFrame(() => m.naOblast(oblastMapy(SM.kont), okrajeMapy(), false));
    if (!ulozeni.get('mapaTip', false)) {
      ulozeni.set('mapaTip', true);
      zpravaMapy('info', matchMedia('(pointer: coarse)').matches ? 'Mapu posuneš tažením a přiblížíš dvěma prsty.' : 'Mapu posuneš tažením, přiblížíš kolečkem nebo tlačítky vpravo.');
    }
  }
  function titulMapy() {
    const t = app.querySelector<HTMLElement>('[data-titul]'); if (!t || !M) return;
    const cas = M.konec ? M.cas : Date.now() - M.start;
    t.innerHTML = `Slepá mapa<small>${esc(M.chyby ? 'Procvičení chyb' : nazevOblasti(SM.kont))} · ${Math.min(M.pos + 1, M.fronta.length)} z ${M.fronta.length} · ${minuty(cas)}</small>`;
  }
  function otazkaMapy() {
    if (!M) return;
    titulMapy(); aktualizujZpet();
    const k = $('[data-smo]', app); if (!k) return;
    const c = M.fronta[M.pos], z = PODLE[c], t = TYPY_MAPY.find((x) => x.k === M!.typy[M!.pos])!;
    const vizual = t.k === 'vlajka' ? vlajka(z, 'sm-otazka__vlajka') : `<span class="sm-otazka__ikona">${ik(t.ik, 24)}</span>`;
    const hlavni = t.k === 'vlajka' ? 'Kde leží?' : t.k === 'cap' ? esc(z.capShort) : esc(z.n);
    k.innerHTML = `<div class="sm-otazka__radek">${vizual}
        <div class="sm-otazka__text"><span class="sm-otazka__stitek">${t.otazka}</span><b>${hlavni}</b></div>
        <div class="sm-otazka__vpravo"><span class="sm-pokusy" aria-label="Pokusy">${[0, 1, 2].map((i) => `<i class="${i < M!.pokus ? 'pryc' : ''}"></i>`).join('')}</span>
          <button type="button" class="sm-nevim" data-a="smnevim">${ik('oko', 16)} Nevím</button></div></div>
      <div class="sm-otazka__zprava" data-smz></div>
      <div class="sm-otazka__pruh"><i style="width:${(M.pos / M.fronta.length) * 100}%"></i></div>`;
  }
  function zpravaMapy(typ: 'ok' | 'chyba' | 'info', html: string) {
    const z = app.querySelector<HTMLElement>('[data-smz]'); if (!z) return;
    z.className = 'sm-otazka__zprava sm-otazka__zprava--' + typ;
    z.innerHTML = html;
  }
  function obnovPokusy() {
    app.querySelectorAll('.sm-pokusy i').forEach((x, i) => x.classList.toggle('pryc', !!M && i < M.pokus));
  }
  const snimekMapy = () => JSON.stringify({ ...M, zaznam: null });
  function ulozKrokMapy() { MH.push(snimekMapy()); if (MH.length > 80) MH.shift(); }
  function zpetMapy() {
    const s = MH.pop(); if (!s || !M || !mapa) return;
    clearTimeout(casMapy);
    // Krok zpět z konce kola vrátí i zápis do skóre a rekord
    if (M.zaznam) { vrat(M.zaznam); M.zaznam = null; }
    if (M.rekord) { const r = rekordyMapy(); if (M.rekord.pred) r[M.rekord.klic] = M.rekord.pred; else delete r[M.rekord.klic]; ulozeni.set('mapaRekordy', r); }
    M = JSON.parse(s) as KoloMapy;
    app.querySelector('.sm-konec')?.remove();
    app.querySelector('[data-sm]')?.classList.remove('je-konec');
    mapa.stavy(M.stav);
    M.zamek = false;
    otazkaMapy();
    zpravaMapy('info', `${ik('zpet', 16, 2.4)} Krok zpět`);
  }

  function tukMapy(c: string, mx: number, my: number) {
    if (!M || M.zamek || M.konec || !mapa) return;
    const cil = M.fronta[M.pos], z = PODLE[cil];
    ulozKrokMapy();
    if (c === cil) {
      const st = (M.pokus + 1) as StavStatu;
      M.stav[c] = st; M.zamek = true;
      // Štítek a kroužek tam, kam hráč ťukl (u Ruska by střed státu byl až na Sibiři)
      mapa.smazStitky(); mapa.stav(c, st); mapa.blikni(c, 'ok', mx, my); mapa.stitekBodu(z.n, mx, my, 'ok', 1100);
      zvuk('ano');
      zpravaMapy('ok', `${ik('check', 17, 2.8)} Správně, ${['', 'napoprvé', 'napodruhé', 'napotřetí'][st]}${M.typy[M.pos] !== 'n' ? `: <b>${esc(z.n)}</b>` : ''}`);
      casMapy = window.setTimeout(dalsiMapy, 750);
    } else {
      M.pokus++;
      mapa.blikni(c, 'chyba'); mapa.stitekBodu(PODLE[c].n, mx, my, 'chyba', 1500);
      zvuk('ne');
      try { navigator.vibrate?.(30); } catch {}
      obnovPokusy();
      if (M.pokus >= 3) { odhalMapy(false); return; }
      const v = mapa.vzdalenost(mx, my, cil);
      const kde = !v ? '' : v.km < 40 ? ' Je hned vedle.' : ` Hledaný stát leží asi ${cislo(Math.round(v.km / (v.km < 1000 ? 10 : 50)) * (v.km < 1000 ? 10 : 50))} km ${v.smer}.`;
      zpravaMapy('chyba', `${ik('x', 17, 2.8)} To je ${esc(PODLE[c].n)}.${kde}`);
    }
    aktualizujZpet();
  }
  function odhalMapy(nevim: boolean) {
    if (!M || !mapa) return;
    const cil = M.fronta[M.pos], z = PODLE[cil];
    M.stav[cil] = 4; M.zamek = true;
    const pohled = mapa.pohled();
    mapa.stav(cil, 4);
    mapa.smazStitky();
    mapa.ukaz(cil, okrajeMapy());
    mapa.stitekStatu(cil, z.n, 'info', 2300);
    if (nevim) zvuk('tik');
    zpravaMapy('info', `${ik('cil', 17, 2.4)} Tady je <b>${esc(z.n)}</b>${M.typy[M.pos] === 'cap' ? ` (${esc(z.capShort)})` : ''}`);
    aktualizujZpet();
    casMapy = window.setTimeout(() => { mapa?.nastavPohled(pohled); dalsiMapy(); }, 2500);
  }
  AKCE.smnevim = () => { if (!M || M.zamek || M.konec) return; ulozKrokMapy(); M.pokus = 3; obnovPokusy(); odhalMapy(true); };
  function dalsiMapy() {
    if (!M) return;
    M.pos++; M.pokus = 0; M.zamek = false;
    if (M.pos >= M.fronta.length) { konecMapy(); return; }
    otazkaMapy();
  }
  function konecMapy() {
    if (!M || !mapa) return;
    M.konec = true; M.cas = Date.now() - M.start; M.zamek = false;
    const pocty = [1, 2, 3, 4].map((k) => M!.fronta.filter((c) => M!.stav[c] === k).length);
    const n = M.fronta.length, napoprve = pocty[0], proc = Math.round((napoprve / n) * 100);
    // Zápis do celkového skóre: bod za každý stát napoprvé
    M.predSkore = nactiProfil().skore;
    M.zaznam = zapis({ hra: 'vlajky', skore: napoprve, her: 1, spravne: napoprve, odpovedi: n, cisla: { mapy: 1 }, objev: M.fronta.filter((c) => M!.stav[c] === 1) });
    // Rekord jen za celou oblast (ne za 10/20 států ani procvičení chyb)
    let novy = false;
    if (!M.chyby && !SM.pocet) {
      const klic = klicRekordu(SM), r = rekordyMapy(), pred = r[klic] ?? null;
      M.rekord = { klic, pred };
      if (!pred || proc > pred.p || (proc === pred.p && M.cas < pred.t)) { r[klic] = { p: proc, t: M.cas }; ulozeni.set('mapaRekordy', r); novy = !!pred; }
    }
    titulMapy();
    zvuk('vyhra'); if (proc >= 80 || novy) konfety();
    const chyb = n - napoprve;
    const nazev = M.chyby ? 'Chyby procvičené' : SM.pocet || (SM.kont.length > 1 && SM.kont.length < 6) ? 'Kolo hotové' : SM.kont.length === 6 ? 'Celý svět hotový!' : `${SM.kont[0] === 'OC' ? 'Oceánie' : KONT[SM.kont[0]]} hotová!`;
    const LEG = ['napoprvé', 'napodruhé', 'napotřetí', 'nenalezeno'];
    const obal = $('[data-sm]', app);
    obal.classList.add('je-konec');
    const sheet = document.createElement('div');
    sheet.className = 'sm-konec';
    sheet.setAttribute('role', 'dialog'); sheet.setAttribute('aria-label', 'Výsledek kola');
    sheet.innerHTML = `<div class="sm-konec__hlava"><div><span class="nadhlavi">${novy ? 'Nový rekord' : 'Výsledek'}</span><h2>${esc(nazev)}</h2></div>
        <div class="sm-konec__cislo"><b>${proc} %</b><small>napoprvé · ${minuty(M.cas)}</small></div></div>
      <div class="sm-legenda">${pocty.map((p, i) => `<span><b><i style="background:var(--sm-${i + 1})"></i>${p}</b><small>${LEG[i]}</small></span>`).join('')}</div>
      ${ziskHTML(M.predSkore, napoprve)}
      <div class="sm-konec__tl">
        <button class="tlacitko tlacitko--male" data-a="krokZpet" style="width:auto">${ik('zpet', 17)} Krok zpět</button>
        ${chyb ? `<button class="tlacitko tlacitko--oranzovy" data-a="smchyby">${ik('books', 18)} Procvičit ${chyb} ${sklonuj(chyb, 'chybu', 'chyby', 'chyb')}</button>` : ''}
        <button class="tlacitko${chyb ? '' : ' tlacitko--oranzovy'}" data-a="slepa">${ik('flip', 18)} Znovu</button>
        <button class="tlacitko" data-a="slepaUvod">Nastavení</button>
      </div>`;
    obal.appendChild(sheet);
    aktualizujZpet();
    // Celá oblast nad výsledkem, ať je vidět vybarvená mapa
    requestAnimationFrame(() => mapa?.naOblast(oblastMapy(SM.kont), okrajeMapy(), true));
  }
  AKCE.smplus = () => mapa?.plus();
  AKCE.smminus = () => mapa?.minus();
  AKCE.smdomu = () => mapa?.domu();
  AKCE.smkonec = () => {
    if (!M || M.konec || M.pos === 0) { AKCE.slepaUvod(koren, new Event('x')); return; }
    otevri(`<div class="hra-okno" role="dialog" aria-modal="true" aria-label="Ukončit kolo" style="text-align:center"><h2>Ukončit kolo?</h2><p>Rozehrané kolo se do skóre nezapočítá.</p><div class="hra-dva" style="margin-top:1rem"><button class="tlacitko" data-a="zavri">Hrát dál</button><button class="tlacitko hra-tl-ne" data-a="slepaUvod">Ukončit</button></div></div>`);
  };

  /* ============ START ============ */
  fetch('/data/hra-vlajky.json')
    .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
    .then((d: { zeme: Zeme[]; mapa: Mapa }) => {
      ZEME = d.zeme; MAPA = d.mapa;
      ZEME.forEach((z, i) => {
        z.i = i; PODLE[z.c] = z;
        z.capShort = z.cap.replace(/\s*\([^)]*\)/g, '').trim();
        z.contTxt = z.cont.map((k) => KONT[k]).join(' / ');
        z.num = String(i + 1).padStart(3, '0');
      });
      VSE = ZEME.map((z) => z.i);
      let defs = '<g id="hraW"><path d="' + MAPA.other + '"/>';
      for (const k in MAPA.paths) defs += '<path id="hm' + k + '" d="' + MAPA.paths[k] + '"/>';
      document.querySelector('[data-hra-defs]')!.innerHTML = defs + '</g>';
      menu();
      // Odkaz rovnou na slepou mapu: /hry/vlajky-sveta/#slepa-mapa
      if (location.hash === '#slepa-mapa') AKCE.slepaUvod(koren, new Event('x'));
      addEventListener('hashchange', () => { if (location.hash === '#slepa-mapa') AKCE.slepaUvod(koren, new Event('x')); });
    })
    .catch(() => { app.innerHTML = '<p class="drobne">Hru se nepodařilo načíst. Zkus stránku obnovit.</p>'; });
</script>
