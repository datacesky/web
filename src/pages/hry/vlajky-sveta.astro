    .hra-staty b { font-size: 1.6rem; }
    .hra-moznost { min-height: 50px; }
  }
  .hra-velke-cislo { font-size: 4rem; font-weight: 900; line-height: 1; letter-spacing: -0.03em; }

  /* Studovna */
  .hra-postup { height: 10px; border-radius: 99px; background: var(--line-jemna); overflow: hidden; margin: 0.2rem 0 1rem; }
  .hra-postup i { display: block; height: 100%; border-radius: 99px; background: var(--teal); transition: width 0.4s var(--ease-out); }

  /* Atlas */
  .hra-atlas-hledat { width: 100%; margin-bottom: 0.8rem; }
  .hra-mrizka { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 0.6rem; margin-top: 1rem; }
  .hra-vlajka-dl { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.5rem; border-radius: 14px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--stin-maly); color: var(--navy); font-family: inherit; cursor: pointer; transition: transform var(--stisk) var(--ease-out), box-shadow 0.2s ease; }
  @media (hover: hover) and (pointer: fine) { .hra-vlajka-dl:hover { transform: translateY(-2px); box-shadow: var(--stin); } }
  .hra-vlajka-dl:active { transform: scale(0.96); }
  .hra-vlajka-dl img { width: 100%; height: auto; border-radius: 5px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--navy) 10%, transparent); }
  .hra-vlajka-dl span { font-size: 0.76rem; font-weight: 800; line-height: 1.2; min-height: 2.4em; display: flex; align-items: center; justify-content: center; text-align: center; }
  .hra-atlas-nav { display: grid; grid-template-columns: auto 1fr auto; gap: 0.5rem; margin-top: 1rem; }
  .hra-atlas-nav .tlacitko { background: var(--paper); }

  /* Odkaz zpět na všechny hry */
  .hra__zpet { text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .hra__zpet:hover { color: var(--navy); } }

  /* Horní řádek rozcestníku: úroveň a ovládání */
  .hra-menu-lista { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .hra-menu-lista .hry-profil { flex: 1; min-width: 0; }
  .hra-menu-lista__tl { display: flex; flex-direction: column; gap: 0.45rem; }
  @media (min-width: 621px) { .hra-menu-lista__tl { flex-direction: row; } }
  .hra-kulate[disabled] { opacity: 0.35; cursor: default; box-shadow: none; }
  .hra-kulate[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: var(--cream); }
  .hra-tl-cela { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; }

  /* Statistiky: mapa objevených států */
  .hra-okno--stat { max-width: 560px; }
  .hra-objev-mapa { position: relative; margin: 0.9rem 0 0.4rem; border-radius: 16px; overflow: hidden; background: var(--more-svetle); border: 1px solid var(--line); }
  .hra-objev-mapa svg { display: block; width: 100%; height: auto; }
  .hra-objev-legenda { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.8rem; font-weight: 700; color: var(--muted); }
  .hra-objev-legenda i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 0.35rem; vertical-align: -1px; }
  .hra-okno .hry-cisla div { background: var(--plocha-2); }
  .hra-okno .hry-cisla small { color: var(--muted); }
  .hra-okno .hry-profil { margin-top: 0.4rem; }
  .hra-kont-objev { display: grid; gap: 0.35rem; margin-top: 0.6rem; }
  .hra-kont-objev div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) 3.4rem; align-items: center; gap: 0.6rem; font-size: 0.82rem; font-weight: 700; }
  .hra-kont-objev span:last-child { text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
  .hra-kont-objev .hra-postup { margin: 0; height: 8px; }

  /* ============ CELÁ OBRAZOVKA ============
     Hra překryje hlavičku i spodní lištu webu a vejde se na výšku displeje, nic se neposouvá.
     Karta se zvětší nebo zmenší podle místa (container query), ovládání zůstává celé vidět. */
  html.hry-cela, html.hry-cela body { overflow: hidden; }
  .hra.cela {
    position: fixed; inset: 0; z-index: 70; width: auto; max-width: none; margin: 0; overflow: hidden;
    display: flex; flex-direction: column; background: var(--cream);
    padding: max(0.6rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) max(0.6rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
  }
  .hra.cela::before { content: ''; position: absolute; inset: 0; z-index: -1; background: url('/vrstevnice.svg') center / cover no-repeat; opacity: calc(0.35 * var(--vrstevnice-sila)); pointer-events: none; }
  .hra.cela .hra__hlava { display: none; }
  .hra.cela .hra__app { flex: 1; min-height: 0; width: 100%; max-width: 1240px; margin-inline: auto; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .hra.cela .hra__app.vejit { display: flex; flex-direction: column; overflow: hidden; }
  .hra.cela .hra-lista { margin-bottom: 0.6rem; flex: none; }
  html.hry-cela .hra-toast { bottom: calc(18px + env(safe-area-inset-bottom)); }
  .hra.cela .hra-fit { flex: 1; min-height: 0; display: flex; flex-direction: column; width: 100%; margin-inline: auto; }
  /* Místo pro kartu: velikost karty se počítá z místa, které zbude */
  .hra.cela .hra-misto { flex: 1; min-height: 110px; container-type: size; display: grid; place-items: center; }
  .hra.cela .hra-misto .hra-karta-obal { width: min(100cqw, 100cqh, 600px); max-width: none; }
  .hra.cela .hra-misto .hra-karta { aspect-ratio: auto; width: 100%; height: min(100cqh, calc(min(100cqw, 100cqh, 600px) * 1.2)); }
  .hra.cela .hra-misto .hra-rub__mapa { height: 30%; }
  /* Lišta: jeden řádek, ať nezabírá výšku */
  .hra.cela .hra-lista__titul, .hra.cela .hra-lista__titul small { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 420px) {
    .hra-lista { gap: 0.4rem; }
    .hra-lista .hra-kulate { width: 38px; height: 38px; }
    .hra-lista__titul { font-size: 1.02rem; }
  }
  /* Desková hra: kostky vedle výzvy a ovládání s pevnou výškou, takže karta mezi tahy nemění velikost */
  .hra.cela .hra-stul { flex: 1; min-height: 0; width: 100%; max-width: none; grid-template-rows: auto minmax(0, 1fr) auto; gap: 0.5rem; }
  .hra.cela .hra-stul__karta { position: static; }
  .hra.cela .hra-skore { padding-top: 10px; }
  .hra.cela .hra-hrac { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.3rem 0.7rem; min-width: 0; }
  .hra.cela .hra-hrac__body b { font-size: 1.2rem; }
  .hra.cela .hra-stul__ovladani {
    display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'kostky vyzva' 'cas cas' 'ovl ovl';
    align-content: end; align-items: center; column-gap: 0.9rem; row-gap: 0.45rem;
    height: clamp(196px, 31dvh, 232px); overflow-y: auto; scrollbar-width: none;
  }
  .hra.cela .hra-kostky { grid-area: kostky; justify-content: flex-start; gap: 0.7rem; min-height: 0; margin: 0; }
  .hra.cela .hra-scena { width: 54px; height: 54px; }
  .hra.cela .hra-scena--mala { width: 44px; height: 44px; }
  .hra.cela .hra-vyzva-obal { grid-area: vyzva; text-align: left; min-height: 0; margin: 0; }
  .hra.cela .hra-vyzva-obal:empty::before { content: 'Hoď kostkou. Určí, co o státu řekneš.'; font-size: 0.86rem; font-weight: 700; line-height: 1.4; color: var(--muted); }
  .hra.cela .hra-vyzva { font-size: 1rem; padding: 0.45rem 0.95rem; }
  .hra.cela .hra-udalost { justify-content: flex-start; margin-top: 0.3rem; font-size: 0.8rem; line-height: 1.35; }
  .hra.cela .hra-stul__ovladani > [data-cas] { grid-area: cas; }
  .hra.cela .hra-stul__ovladani .hra-cas { margin: 0; }
  .hra.cela .hra-ovl { grid-area: ovl; gap: 0.5rem; }
  .hra.cela .hra-tip { font-size: 0.78rem; line-height: 1.35; }
  .hra.cela .hra-popisek { font-size: 0.9rem; }
  .hra.cela .hra-moznost { min-height: 46px; padding: 0.5rem 0.7rem; font-size: 0.86rem; }
  .hra.cela .hra-oznaceni .chip { min-height: 40px; }
  .hra.cela .hra-vysledek { padding: 0.5rem 0.8rem; font-size: 0.86rem; line-height: 1.4; }
  .hra.cela .hra-vysledek strong { font-size: 1.08rem; }
  @media (min-width: 900px) {
    .hra.cela .hra-stul { grid-template-columns: minmax(0, 1fr) minmax(330px, 440px); grid-template-rows: auto minmax(0, 1fr); grid-template-areas: 'karta skore' 'karta ovladani'; column-gap: clamp(1.5rem, 4vw, 3.5rem); align-items: stretch; }
    .hra.cela .hra-stul__ovladani { height: auto; align-content: center; row-gap: 0.8rem; }
    .hra.cela .hra-scena { width: 68px; height: 68px; }
    .hra.cela .hra-scena--mala { width: 54px; height: 54px; }
    .hra.cela .hra-vyzva { font-size: 1.1rem; }
    .hra.cela .hra-hrac { display: block; padding: 0.5rem 0.8rem; }
    .hra.cela .hra-hrac__body b { font-size: 1.55rem; }
    .hra.cela .hra-moznost { min-height: 56px; font-size: 0.9rem; }
  }
  /* Bleskovka */
  .hra.cela .hra-blesk { max-width: 680px; }
  .hra.cela .hra-blesk [data-botazka] { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .hra.cela .hra-blesk .hra-otazka { flex: 1; min-height: 120px; margin-bottom: 0.6rem; container-type: size; gap: 0.5rem; padding: 0.7rem; }
  .hra.cela .hra-blesk .hra-otazka img.vlajka-velka { width: min(80cqw, 56cqh * 4 / 3); max-width: none; }
  .hra.cela .hra-blesk .hra-otazka img.vlajka-mala { width: min(40cqw, 34cqh * 4 / 3); max-width: none; }
  .hra.cela .hra-blesk .hra-otazka__mapa { width: min(100%, 76cqh * 1.75); aspect-ratio: 1.75; }
  .hra.cela .hra-blesk .hra-otazka__velke { font-size: clamp(1.25rem, 9cqh, 2.4rem); }
  .hra.cela .hra-blesk .hra-moznosti { flex: none; }
  .hra.cela .hra-blesk .hra-moznost--vlajka img { max-height: 15dvh; width: auto; max-width: 100%; margin-inline: auto; }
  .hra.cela .hra-blesk .hra-staty b { font-size: 1.7rem; }
  /* Studovna */
  .hra.cela .hra-stud { max-width: 620px; }
  .hra.cela .hra-stud .hra-dva { flex: none; margin-top: 0.7rem !important; }

  /* ============ SLEPÁ MAPA ============
     Barvy mapy (čte je canvas v src/lib/slepa-mapa.ts) a stavy: 1 napoprvé, 2 napodruhé, 3 napotřetí, 4 nenalezen */
  :root {
    --sm-more: #D5E7F3; --sm-aktivni: #FFFFFF; --sm-neaktivni: #E4DDD0; --sm-hranice: #A89D89; --sm-hranice-slaba: #D3CABA; --sm-hover: #FBD3AE;
    --sm-1: #1E9E91; --sm-2: #E0AE1C; --sm-3: #F08829; --sm-4: #D8473B;
  }
  :root[data-tema='tmavy'] {
    --sm-more: #172B4B; --sm-aktivni: #3B4B71; --sm-neaktivni: #27324D; --sm-hranice: #6879A3; --sm-hranice-slaba: #2E3A57; --sm-hover: #8A5A2E;
    --sm-1: #3BB9AC; --sm-2: #E6BC3C; --sm-3: #F5973F; --sm-4: #E2574A;
  }
  .hra-dl__nove { display: inline-block; vertical-align: 3px; margin-left: 0.35rem; padding: 2px 7px; border-radius: 99px; background: var(--orange); color: var(--na-oranzove); font-size: 0.6rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; }
  .sm-hra { display: flex; flex-direction: column; }
  .sm-mapa {
    position: relative; overflow: hidden; isolation: isolate; border-radius: var(--radius); border: 1px solid var(--line); background: var(--sm-more); box-shadow: var(--stin-maly);
    height: clamp(420px, calc(100dvh - var(--hlavicka-vyska, 64px) - 150px), 820px); user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .hra.cela .sm-mapa { flex: 1; min-height: 0; height: auto; }
  /* Na telefonu přes celou obrazovku jde mapa od kraje ke kraji a až dolů */
  @media (max-width: 700px) {
    .hra.cela:has(.sm-hra) { padding-left: 0; padding-right: 0; padding-bottom: 0; }
    .hra.cela .sm-hra .hra-lista { padding-inline: max(0.75rem, env(safe-area-inset-left)) max(0.75rem, env(safe-area-inset-right)); }
    .hra.cela .sm-mapa { border-radius: 18px 18px 0 0; border-width: 1px 0 0; box-shadow: none; }
    .hra.cela .sm-zoom { bottom: calc(0.6rem + env(safe-area-inset-bottom)); right: 0.6rem; }
  }
  .sm-platno { position: absolute; inset: 0; display: block; touch-action: none; cursor: grab; }
  .sm-platno.se-taha { cursor: grabbing; }
  .sm-zoom { z-index: 4; }
  .sm-mapa .zoom-napoveda { z-index: 5; }
  .sm-stitky { position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
  .sm-stitek { position: absolute; left: 0; top: 0; will-change: transform; }
  .sm-stitek span {
    display: block; transform: translate(-50%, calc(-100% - 11px)); padding: 0.3rem 0.7rem; border-radius: 999px; white-space: nowrap;
    background: var(--panel); color: var(--na-panelu); font-size: 0.82rem; font-weight: 800; box-shadow: var(--stin-maly);
    animation: sm-stitek 0.28s var(--ease-out); transition: opacity 0.25s ease;
  }
  .sm-stitek--chyba span { background: var(--sm-4); color: #fff; }
  .sm-stitek--ok span { background: var(--sm-1); color: #fff; }
  .sm-stitek.mizi span { opacity: 0; }
  @keyframes sm-stitek { from { opacity: 0; transform: translate(-50%, calc(-100% - 3px)) scale(0.85); } }

  /* Karta s otázkou nahoře přes mapu */
  .sm-otazka {
