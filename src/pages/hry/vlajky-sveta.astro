      <button class="hra-dl" data-a="slepaUvod" style="--ic:#D8473B"><span class="hra-dl__ikona">${ik('cil', 26)}</span><span><b>Slepá mapa <span class="hra-dl__nove">Nové</span></b><small>Najdi stát na mapě bez popisků. Kontinent po kontinentu.</small></span></button>
      <button class="hra-dl" data-a="studovnaUvod" style="--ic:var(--teal)"><span class="hra-dl__ikona">${ik('books', 26)}</span><span><b>Studovna</b><small>Kartičky na procvičení. Co neumíš, vrátí se.</small></span></button>
      <button class="hra-dl" data-a="atlas" style="--ic:#8E6CC9"><span class="hra-dl__ikona">${ik('map', 26)}</span><span><b>Atlas karet</b><small>Prohlédni si a hledej všech ${ZEME.length} karet.</small></span></button>
      <button class="hra-dl" data-a="pravidla" style="--ic:var(--slate)"><span class="hra-dl__ikona">${ik('book', 26)}</span><span><b>Pravidla</b><small>Jak se hraje a co dělají bonusy.</small></span></button>
    </div>
    <div class="hra-pata"><p class="drobne">${ZEME.length} států: 193 členů OSN, Vatikán, Palestina, Kosovo a Tchaj-wan. Údaje k listopadu 2026, zdroje v <a href="/metodika/#hra">metodice</a>.</p><a class="tlacitko tlacitko--male" href="/hry/" style="width:auto">${ik('back', 16)} Všechny hry</a></div>`, false);
  }
  AKCE.menu = menu;
  AKCE.pravidla = () => otevri(`<div class="hra-okno" role="dialog" aria-modal="true" aria-label="Pravidla">
    <h2>Pravidla</h2>
    <h3>${ik('dice', 18)} Desková hra</h3><ul>
      <li>Hráč na tahu vidí kartu s vlajkou a hodí kostkou.</li>
      <li>Kostka určí, co má o státu říct: <b>název, kontinent, měnu, počet sousedů, jazyk</b> nebo <b>hlavní město</b>.</li>
      <li>Odpoví nahlas, otočí kartu a ostatní rozhodnou, jestli to platí.</li>
      <li>Kdo první dosáhne cílového počtu bodů, vyhrává.</li></ul>
    <h3>${ik('norm', 18)} Akční kostka</h3><ul>
      <li><b>Běžný tah:</b> +1 bod</li><li><b>Dvojnásobek:</b> +2 body</li>
      <li><b>Hádají všichni:</b> každý řekne nebo napíše odpověď, bod dostane každý, kdo trefí</li>
      <li><b>Zloděj:</b> když uhádneš, vezmeš si bod od soupeře podle výběru</li>
      <li><b>Vabank:</b> +3 body, ale při chybě −1</li></ul>
    <h3>${ik('joker', 18)} Žolík 50/50</h3><p>Místo odpovídání z hlavy si necháš ukázat 4 možnosti. Žolíků je jen pár na celou hru.</p>
    <h3>${ik('flame', 18)} Série</h3><p>Tři správné odpovědi za sebou = bonusový bod.</p>
    <h3>${ik('cil', 18)} Slepá mapa</h3><ul>
      <li>Ťukni na mapě na stát, který hra chce. Na každý máš 3 pokusy, pak ti ho mapa ukáže.</li>
      <li>Barvy: <b>zelená</b> napoprvé, <b>žlutá</b> napodruhé, <b>oranžová</b> napotřetí, <b>červená</b> nenalezen.</li>
      <li>Bod do celkového skóre je za každý stát nalezený napoprvé.</li>
      <li>Malé státy jsou kroužky. Když ťukneš mezi víc malých států, mapa se tam sama přiblíží.</li></ul>
    <h3>${ik('check', 18)} Spory</h3><ul>
      <li>Jazyk: stačí jeden z úředních jazyků.</li>
      <li>Kontinent: u států na pomezí (Rusko, Turecko, Kypr…) platí obě odpovědi.</li>
      <li>Sousedé: počítají se pozemní hranice se státy z balíčku. Na mapě jsou vybarvení.</li>
      <li>Hlavní město: když jich stát má víc, stačí jedno.</li></ul>
    <div style="margin-top:1.2rem"><button class="tlacitko tlacitko--plny tlacitko--plna-sirka" data-a="zavri">Rozumím</button></div></div>`);

  /* ============ NASTAVENÍ DESKOVÉ HRY ============ */
  type Nastaveni = { hraci: string[]; cil: number; kont: string[]; akce: boolean; zolici: number; cas: number; serie: boolean };
  let N: Nastaveni = ulozeni.get('nastaveni', { hraci: ['Hráč 1', 'Hráč 2'], cil: 10, kont: Object.keys(KONT), akce: true, zolici: 2, cas: 0, serie: true });
  const ulozN = () => ulozeni.set('nastaveni', N);
  function nastaveni() {
    obrazovka(`<div class="hra-uzke">${lista('Nová hra', 'Desková hra s kostkou')}
      <div class="hra-panel"><h3>${ik('all', 18)} Hráči</h3><div class="hra-hraci" data-hraci></div>
        <button type="button" class="tlacitko tlacitko--male" data-a="pridej" ${N.hraci.length >= 6 ? 'disabled' : ''} style="width:auto">${ik('plus', 16)} Přidat hráče</button></div>
      <div class="hra-panel"><h3>${ik('trophy', 18)} Cíl hry</h3>${segment('cil', [5, 10, 15, 20], N.cil, (v) => v + ' bodů')}</div>
      <div class="hra-panel"><h3>${ik('kont', 18)} Balíček karet</h3>${kontinentyChips(N.kont, 'kont')}<p class="hra-pocet" data-pocet></p></div>
      <div class="hra-panel"><h3>${ik('norm', 18)} Zpestření</h3>
        <div class="hra-volba"><div><b>Akční kostka</b><small>Druhá kostka: dvojnásobek, hádají všichni, zloděj, vabank.</small></div><button type="button" class="prepinac-pilulka" data-a="prepni" data-k="akce" aria-pressed="${N.akce}">${N.akce ? 'Zapnuto' : 'Vypnuto'}</button></div>
        <div class="hra-volba"><div><b>Série</b><small>3 správně za sebou = bonusový bod.</small></div><button type="button" class="prepinac-pilulka" data-a="prepni" data-k="serie" aria-pressed="${N.serie}">${N.serie ? 'Zapnuto' : 'Vypnuto'}</button></div>
        <div class="hra-volba"><div><b>Žolíci 50/50</b><small>Kolik žolíků má každý hráč.</small>${segment('zolici', [0, 1, 2, 3], N.zolici, String)}</div></div>
        <div class="hra-volba"><div><b>Časovač</b><small>Kolik času je na odpověď.</small>${segment('cas', [0, 15, 30, 45], N.cas, (v) => (v ? v + ' s' : 'bez času'))}</div></div>
        <div class="hra-volba"><div><b>Celá obrazovka</b><small>Hra překryje web a vejde se na displej, nic se neposouvá.</small></div><button type="button" class="prepinac-pilulka" data-a="celaPref" aria-pressed="${celaPref}">${celaPref ? 'Zapnuto' : 'Vypnuto'}</button></div>
      </div>
      <button class="tlacitko tlacitko--oranzovy tlacitko--plna-sirka" data-a="start">${ik('dice', 20)} Rozdat karty</button></div>`);
    hraciPole(); pocet();
  }
  function hraciPole() {
    const el = $('[data-hraci]');
    el.innerHTML = N.hraci.map((p, i) => `<div class="hra-hrac-radek" style="--pc:${BARVY_HRACU[i]}"><i></i><input type="text" value="${esc(p)}" maxlength="14" data-i="${i}" aria-label="Jméno hráče ${i + 1}" autocomplete="off">${N.hraci.length > 1 ? `<button type="button" class="hra-kulate" data-a="odeber" data-i="${i}" aria-label="Odebrat hráče">${ik('x', 17)}</button>` : ''}</div>`).join('');
    el.querySelectorAll<HTMLInputElement>('input').forEach((inp) => inp.addEventListener('input', () => { N.hraci[+inp.dataset.i!] = inp.value; ulozN(); }));
  }
  function pocet() {
    const n = zKontinentu(N.kont).length;
    $('[data-pocet]').textContent = n ? `V balíčku: ${n} karet` : 'Vyber aspoň jeden kontinent';
    $<HTMLButtonElement>('[data-a="start"]').disabled = !n;
  }
  AKCE.nastaveni = nastaveni;
  AKCE.pridej = () => { if (N.hraci.length < 6) { N.hraci.push('Hráč ' + (N.hraci.length + 1)); ulozN(); nastaveni(); } };
  AKCE.odeber = (b) => { N.hraci.splice(+b.dataset.i!, 1); ulozN(); nastaveni(); };
  AKCE.seg = (b) => {
    const sk = b.parentElement!.dataset.skupina as 'cil' | 'zolici' | 'cas';
    (N as any)[sk] = +b.dataset.v!; b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); ulozN();
  };
  AKCE.prepni = (b) => { const k = b.dataset.k as 'akce' | 'serie'; N[k] = !N[k]; b.setAttribute('aria-pressed', String(N[k])); b.textContent = N[k] ? 'Zapnuto' : 'Vypnuto'; ulozN(); };
  AKCE.kont = (b) => { const on = prepniVSeznamu(N.kont, b.dataset.k!); b.setAttribute('aria-pressed', String(on)); ulozN(); pocet(); };

  AKCE.celaPref = (b) => { celaPref = !celaPref; ulozeni.set('cela', celaPref); b.setAttribute('aria-pressed', String(celaPref)); b.textContent = celaPref ? 'Zapnuto' : 'Vypnuto'; };

  /* ============ DESKOVÁ HRA ============ */
  type Hrac = { jmeno: string; barva: string; body: number; serie: number; zolici: number; ok: number; tahu: number; bonus?: boolean };
  type Hra = {
    hraci: Hrac[]; na: number; balicek: number[]; pos: number; cil: number; o: Nastaveni; faze: string; kat: string | null;
    ud: (typeof UDALOSTI)[number] | null; rot: { x: number; y: number }; arot: { x: number; y: number }; zolik: boolean;
    oznaceni: Set<number>; zprava: string; jmoz: string[] | null; jspr: string; casovac: number | null; konec?: boolean; vysledek: 'ano' | 'ne' | '';
    spravne: string[]; zaznam?: Zaznam | null; predSkore?: number;
  };
  let H: Hra;
  // Krok zpět: před každým rozhodnutím (správně/špatně, zloděj, další karta, žolík) se uloží snímek hry
  let historie: string[] = [];
  let casVysledku = 0;
  const snimek = () => JSON.stringify({ ...H, oznaceni: [...H.oznaceni], ud: null, udi: H.ud ? UDALOSTI.indexOf(H.ud) : -1, casovac: null, zaznam: null });
  const ulozKrok = () => { historie.push(snimek()); if (historie.length > 60) historie.shift(); };
  function zpetDeskovka() {
    const s = historie.pop(); if (!s) return;
    clearTimeout(casVysledku); zastavCas();
    // Konec hry se vrací i se zápisem do skóre
    if (H.zaznam) { vrat(H.zaznam); H.zaznam = null; }
    const o = JSON.parse(s); o.oznaceni = new Set(o.oznaceni); o.ud = o.udi >= 0 ? UDALOSTI[o.udi] : null; delete o.udi;
    H = o; zavri(); vykresliStav();
  }
  AKCE.start = () => {
    zavri(); clearTimeout(casVysledku);
    const hraci = N.hraci.map((n, i) => ({ jmeno: (n || '').trim() || 'Hráč ' + (i + 1), barva: BARVY_HRACU[i], body: 0, serie: 0, zolici: N.zolici, ok: 0, tahu: 0 }));
    H = { hraci, na: 0, balicek: zamichej(zKontinentu(N.kont)), pos: 0, cil: N.cil, o: { ...N }, faze: 'pripraven', kat: null, ud: null, rot: { x: 0, y: 0 }, arot: { x: 0, y: 0 }, zolik: false, oznaceni: new Set(), zprava: '', jmoz: null, jspr: '', casovac: null, vysledek: '', spravne: [], zaznam: null };
    historie = [];
    vstupDoHry(); zvuk('otoc'); stul(); novaKarta();
  };
  const STENY = (h: number) => [`translateZ(${h}px)`, `rotateX(90deg) translateZ(${h}px)`, `rotateY(90deg) translateZ(${h}px)`, `rotateY(-90deg) translateZ(${h}px)`, `rotateX(-90deg) translateZ(${h}px)`, `rotateY(180deg) translateZ(${h}px)`];
  const OTOCENI_STEN = [[0, 0], [-90, 0], [0, -90], [0, 90], [90, 0], [0, 180]];
  function stul() {
    obrazovka(`${lista('Desková hra', '', 'konec', true)}
      <div class="hra-stul">
        <div class="hra-stul__skore"><div class="hra-skore" data-skore></div></div>
        <div class="hra-stul__karta hra-misto"><div class="hra-karta-obal" data-karta></div></div>
        <div class="hra-stul__ovladani">
          <div class="hra-kostky">
            <div class="hra-scena"><div class="hra-kostka" data-kostka>${KAT.map((c) => `<div class="hra-stena" style="--sc:${c.barva}">${ik(c.ik, 26)}<small>${c.kratce}</small></div>`).join('')}</div></div>
            ${H.o.akce ? `<div class="hra-scena hra-scena--mala"><div class="hra-kostka" data-akostka>${UDALOSTI.map((u) => `<div class="hra-stena">${ik(u.ik, 21)}<small>${u.kratce}</small></div>`).join('')}</div></div>` : ''}
          </div>
          <div class="hra-vyzva-obal" data-vyzva></div><div data-cas></div><div class="hra-ovl" data-ovl></div>
        </div>
      </div>`, true, true);
    ZPET = { mozno: () => historie.length > 0 && !['hazi', 'posuzuje'].includes(H.faze), proved: zpetDeskovka };
    // Stěny kostky se skládají podle skutečné velikosti (mění se s celou obrazovkou i výškou displeje)
    rozmerKostek();
    const ro = new ResizeObserver(rozmerKostek);
    app.querySelectorAll('.hra-scena').forEach((e) => ro.observe(e)); stopky.push(() => ro.disconnect());
  }
  function rozmerKostek() {
    ['[data-kostka]', '[data-akostka]'].forEach((s) => {
      const d = app.querySelector<HTMLElement>(s); if (!d) return;
      const T = STENY(Math.round((d.parentElement as HTMLElement).offsetWidth / 2) || 34);
      d.querySelectorAll<HTMLElement>('.hra-stena').forEach((f, i) => (f.style.transform = T[i]));
    });
  }
  function hodNa(el: HTMLElement, rot: { x: number; y: number }, stena: number) {
    const [tx, ty] = OTOCENI_STEN[stena];
    rot.x = (Math.floor(rot.x / 360) + 2 + rnd(2)) * 360 + tx; rot.y = (Math.floor(rot.y / 360) + 2 + rnd(2)) * 360 + ty;
    el.style.transform = `rotateX(${rot.x}deg) rotateY(${rot.y}deg)`;
  }
  const karta = () => ZEME[H.balicek[H.pos]];
  const hrac = () => H.hraci[H.na];
  function vlozKartu() {
    const obal = $('[data-karta]', app); obal.innerHTML = kartaHTML(karta());
    $('.hra-karta', obal).addEventListener('click', () => { if (H.faze === 'hozeno') AKCE.otoc(obal, new Event('click')); });
    return obal;
  }
  function novaKarta() {
    Object.assign(H, { faze: 'pripraven', kat: null, ud: null, zolik: false, oznaceni: new Set(), zprava: '', jmoz: null, vysledek: '' });
    vlozKartu(); hlavicka(); ovladani();
  }
  function zvyrazni() {
    const k = $('[data-karta]', app);
    k.querySelectorAll('.zvyr').forEach((r) => r.classList.remove('zvyr'));
    if (!H.kat) return;
    if (H.kat === 'n') $('.hra-rub__hlava', k).classList.add('zvyr');
    else k.querySelectorAll('.hra-radek')[RADKY_RUBU.indexOf(H.kat)].classList.add('zvyr');
  }
  // Vykreslí stůl přesně podle stavu H (po kroku zpět): karta, otočení, kostky, skóre, ovládání
  function vykresliStav() {
    const obal = vlozKartu(), k = $('.hra-karta', obal);
    k.classList.remove('rozdat');
    zvyrazni();
    if (['odkryto', 'zlodej', 'hotovo', 'konec'].includes(H.faze)) {
      k.style.transition = 'none'; k.classList.add('otocena'); void k.offsetWidth; k.style.transition = '';
      const radky = obal.querySelector<HTMLElement>('.hra-radky'), zv = radky?.querySelector<HTMLElement>('.zvyr');
      if (radky && zv) radky.scrollTop = Math.max(0, zv.offsetTop - radky.clientHeight / 2 + zv.offsetHeight / 2);
    }
    ([['[data-kostka]', H.rot], ['[data-akostka]', H.arot]] as [string, { x: number; y: number }][]).forEach(([s, r]) => {
      const d = app.querySelector<HTMLElement>(s); if (!d) return;
      d.style.transition = 'none'; d.style.transform = `rotateX(${r.x}deg) rotateY(${r.y}deg)`; void d.offsetWidth; d.style.transition = '';
    });
    hlavicka(); ovladani();
  }
  function hlavicka() {
    const p = hrac();
    $('[data-skore]', app).innerHTML = H.hraci.map((q, i) => `<div class="hra-hrac${i === H.na ? ' na-tahu' : ''}" style="--pc:${q.barva}" data-hrac="${i}"><div class="hra-hrac__jmeno"><i></i>${esc(q.jmeno)}</div><div class="hra-hrac__body"><b>${q.body}</b>${H.o.serie && q.serie ? `<span class="hra-hrac__meta hra-hrac__meta--serie" title="Série">${ik('flame', 13)}${q.serie}</span>` : ''}${H.o.zolici ? `<span class="hra-hrac__meta" title="Žolíci">${ik('joker', 13)}${q.zolici}</span>` : ''}</div></div>`).join('');
    $('[data-titul]', app).innerHTML = `<span class="hra-tah__kdo" style="--pc:${p.barva}">${H.hraci.length > 1 ? `Na tahu: <b>${esc(p.jmeno)}</b>` : 'Sólo hra'}</span><small>karta ${H.pos + 1} z ${H.balicek.length} · do ${H.cil} bodů</small>`;
  }
  function bump(i: number, text: string, minus = false) {
    const el = app.querySelector(`[data-hrac="${i}"]`); if (!el) return;
    const b = document.createElement('div'); b.className = 'hra-bump' + (minus ? ' minus' : ''); b.textContent = text; el.appendChild(b); setTimeout(() => b.remove(), 1300);
  }
  function vyzva() {
    if (!H.kat) return '';
    const c = KAT.find((x) => x.k === H.kat)!; const u = H.ud;
    return `<span class="hra-vyzva" style="--rc:${c.barva}">${ik(c.ik, 20)} ${c.nazev}</span>${u && u.k !== 'norm' ? `<div class="hra-udalost">${ik(u.ik, 17)}<span><b>${u.nazev}</b> · ${u.popis}</span></div>` : ''}`;
  }
  // Ovládání musí být vidět nad spodní lištou telefonu: když není, stránka se posune
  function ukazDole(sel: string) {
    if (cela) return;
    requestAnimationFrame(() => {
      const c = app.querySelector(sel); if (!c) return;
      const r = c.getBoundingClientRect(); const dok = innerWidth <= 760 ? 100 : 0;
      if (r.bottom > innerHeight - dok) scrollBy({ top: r.bottom - (innerHeight - dok) + 12, behavior: 'smooth' });
    });
  }
  function ovladani() {
    vykresliOvladani();
    if (['pripraven', 'hozeno', 'odkryto', 'zlodej', 'hotovo', 'zolik', 'konec'].includes(H.faze)) ukazDole('[data-ovl]');
  }
  function vykresliOvladani() {
    const o = $('[data-ovl]', app), p = hrac();
    aktualizujZpet();
    $('[data-vyzva]', app).innerHTML = vyzva();
    if (H.faze !== 'hozeno' && H.faze !== 'zolik') $('[data-cas]', app).innerHTML = '';
    const nap = H.kat ? NAPOVEDY[H.kat] : '';
    switch (H.faze) {
      case 'pripraven': o.innerHTML = `<button class="tlacitko tlacitko--oranzovy" data-a="hod">${ik('dice', 20)} Hodit kostkou</button>`; return;
      case 'hazi': o.innerHTML = `<button class="tlacitko tlacitko--oranzovy" disabled>Kostka se kutálí…</button>`; return;
      case 'hozeno': {
        const zolik = H.o.zolici > 0 && p.zolici > 0 && H.ud?.k !== 'all';
        o.innerHTML = `<p class="hra-tip">${H.ud?.k === 'all' ? 'Všichni řeknou nebo napíšou odpověď, pak otočte kartu.' : 'Odpověz nahlas, pak otoč kartu.'}</p>
          <div class="${zolik ? 'hra-dva' : ''}">${zolik ? `<button class="tlacitko" data-a="zolik">${ik('joker', 18)} Žolík 50/50</button>` : ''}<button class="tlacitko tlacitko--plny" data-a="otoc">${ik('flip', 18)} Otočit kartu</button></div>`;
