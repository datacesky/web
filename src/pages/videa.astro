---
// Videa: všechna videa na jednom místě. Nahoře hledání a filtry (série, témata), pod tím nejnovější video,
// série jako vodorovné řady a ostatní videa. Při hledání nebo filtru se místo přehledu ukáže mřížka výsledků.
// Filtr jde nastavit odkazem: /videa/#ceske-rody (série), /videa/#t=historie (téma), /videa/#q=brno (hledání).
import Base from '../layouts/Base.astro';
import SerieObalka from '../components/SerieObalka.astro';
import VideoKarta from '../components/VideoKarta.astro';
import { nactiVidea } from '../lib/dily';
import { TEMATA, type Tema } from '../data/serie';
import { epizody } from '../data/epizody';
import { datum, sklonuj } from '../lib/format';
import { ikona } from '../lib/ikony';
import { hlasovaniZapnute } from '../data/hlasovani';

const { vse, ostatni, rady } = await nactiVidea();
// Nejnovější video nahoře, nikdy video, které ještě nevyšlo
const vyslo = vse.filter((d) => !d.brzy);
const nejnovejsi = vyslo[0];
const dalsiNova = vyslo.filter((d) => d !== nejnovejsi).slice(0, 3);
const zemi = new Set(epizody.map((e) => e.a3)).size;
const slovo = (n: number, a: string, b: string, c: string) => sklonuj(n, a, b, c).replace(/^\d+ /, '');
const videi = (n: number) => sklonuj(n, 'video', 'videa', 'videí');
const dilu = (n: number) => sklonuj(n, 'díl', 'díly', 'dílů');

// Témata, která mají aspoň jedno video, od nejčastějšího
const pocetTemat = new Map<Tema, number>();
for (const d of vse) for (const t of d.tema) pocetTemat.set(t, (pocetTemat.get(t) ?? 0) + 1);
const temata = [...pocetTemat.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);

// Popisy filtrů pro nadpis výsledků
const filtry = JSON.stringify({
  serie: Object.fromEntries([
    ...rady.map((r) => [r.id, { nazev: r.nazev, popis: r.popis }]),
    ['ostatni', { nazev: 'Další videa', popis: 'Videa mimo série: mapy, žebříčky a příběhy z dat.' }],
  ]),
  tema: Object.fromEntries(temata.map((t) => [t, { nazev: TEMATA[t].nazev }])),
});
---

<Base
  titul="Videa — data.cesky"
  popis="Všechna videa @data.cesky na jednom místě: Česko vs. svět, 24 hodin MHD, České rody, Češi, kteří změnili svět a další. S hledáním a filtrem podle tématu."
>
  <div class="vi-uvod">
    <section class="obal vi-uvod__obsah">
      <span class="nadhlavi">Videa</span>
      <h1>Všechna videa na jednom místě</h1>
      <p class="perex">Každé video vyšlo nejdřív na Instagramu, TikToku a Facebooku. Tady jsou pohromadě, s hledáním podle názvu, místa, země nebo tématu.</p>
      <ul class="vi-cisla">
        <li><strong data-pocitej>{vse.length}</strong><span>{slovo(vse.length, 'video', 'videa', 'videí')}</span></li>
        <li><strong data-pocitej>{rady.length}</strong><span>{slovo(rady.length, 'série', 'série', 'sérií')}</span></li>
        <li><strong data-pocitej>{zemi}</strong><span>{slovo(zemi, 'země', 'země', 'zemí')} vedle Česka</span></li>
      </ul>

      <div class="vi-hledani" role="search">
        <div class="hledani__pole">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 4a6 6 0 1 0 0 12a6 6 0 1 0 0-12 M20 20l-5.6-5.6" /></svg>
          <input type="search" enterkeyhint="search" placeholder="Hledej třeba Brno nebo Karel IV." aria-label="Hledat ve videích" autocomplete="off" data-vi-hledat />
          <button type="button" class="vi-hledani__smazat" data-vi-smazat aria-label="Smazat hledání" hidden>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12 M18 6L6 18" /></svg>
          </button>
        </div>
      </div>
    </section>

    <nav class="obal vi-filtry" aria-label="Filtrovat videa">
      <div class="vi-filtry__rada">
        <span class="vi-filtry__titul">Série</span>
        <div class="vi-filtry__chipy">
          <button type="button" class="chip vi-chip" data-filtr="" aria-pressed="true">Vše <small>{vse.length}</small></button>
          {rady.map((r) => (
            <button type="button" class="chip vi-chip" data-filtr={r.id} aria-pressed="false">{r.nazev} <small>{r.dily.length}</small></button>
          ))}
          <button type="button" class="chip vi-chip" data-filtr="ostatni" aria-pressed="false">Další videa <small>{ostatni.length}</small></button>
        </div>
      </div>
      <div class="vi-filtry__rada">
        <span class="vi-filtry__titul">Téma</span>
        <div class="vi-filtry__chipy">
          {temata.map((t) => (
            <button type="button" class="chip vi-chip vi-chip--tema" data-filtr={`t=${t}`} aria-pressed="false">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={ikona(TEMATA[t].ikona)} /></svg>
              {TEMATA[t].nazev} <small>{pocetTemat.get(t)}</small>
            </button>
          ))}
        </div>
      </div>
    </nav>
  </div>

  <div data-vi-prehled>
    {nejnovejsi && (
      <section class="obal sekce--mala">
        <div class="vi-nove">
          <a class="vi-nove__obalka" href={nejnovejsi.odkaz} aria-label={`${nejnovejsi.titul}, přehrát na Instagramu`}>
            <SerieObalka slug={nejnovejsi.slug} serie={nejnovejsi.stitek} typ={nejnovejsi.typ} dil={nejnovejsi.dil} nazev={nejnovejsi.nazev} a3={nejnovejsi.a3} ikonaId={nejnovejsi.ikona} velka />
          </a>
          <div class="vi-nove__text">
            <span class="nadhlavi nadhlavi--zive">Nejnovější video · {datum(new Date(nejnovejsi.datum))}</span>
            {nejnovejsi.serie && <span class="vi-nove__serie">{nejnovejsi.serie}{nejnovejsi.dil ? `, ${nejnovejsi.dil}. díl` : ''}</span>}
            <h2>{nejnovejsi.titul}</h2>
            <p class="perex">{nejnovejsi.popis}</p>
            <div class="rada">
              <a class="tlacitko tlacitko--plny" href={nejnovejsi.odkaz}>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d={ikona('prehrat')} /></svg>
                Přehrát na Instagramu
              </a>
              {nejnovejsi.a3 && <a class="tlacitko" href={`/svet/#z=${nejnovejsi.a3}`}>{nejnovejsi.nazev} na glóbusu</a>}
              {nejnovejsi.web && <a class="tlacitko" href={nejnovejsi.web}>Interaktivně na webu</a>}
            </div>
            {nejnovejsi.typ === 'vs' && hlasovaniZapnute && (
              <a class="vi-nove__hlasuj" href="/hlasovani/">
                <span>Díl {epizody.length + 1} vybíráš ty</span>
                <strong>Hlasuj, kterou zemi chceš příště →</strong>
              </a>
            )}
            {dalsiNova.length > 0 && (
              <div class="vi-nove__dalsi">
                <span class="vi-nove__dalsi-titul">Taky nově</span>
                <ul>
                  {dalsiNova.map((d) => (
                    <li>
                      <a href={d.odkaz} class="vi-mini">
                        <span class="vi-mini__obalka"><SerieObalka slug={d.slug} serie={d.stitek} typ={d.typ} dil={d.dil} nazev={d.nazev} a3={d.a3} ikonaId={d.ikona} /></span>
                        <span class="vi-mini__text">
                          <small>{d.serie || d.tema.map((t) => TEMATA[t].nazev).join(' · ')} · {datum(new Date(d.datum))}</small>
                          <strong>{d.titul}</strong>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {rady.map((r) => (
      <section class="obal vi-serie" data-rada={r.id}>
        <header class="vi-serie__hlava">
          <span class="vi-serie__ikona" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ikona(r.ikona)} /></svg>
          </span>
          <div class="vi-serie__text">
            <h2>{r.nazev} <span class="vi-serie__pocet">{dilu(r.dily.length)}</span></h2>
            <p>{r.popis}</p>
          </div>
          <div class="vi-serie__ovladani">
            <button type="button" class="vi-sipka" data-posun="-1" aria-label={`${r.nazev}: předchozí díly`} hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
            </button>
            <button type="button" class="vi-sipka" data-posun="1" aria-label={`${r.nazev}: další díly`} hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            <a class="tlacitko tlacitko--male" href={`#${r.id}`} data-filtr={r.id}>Celá série</a>
          </div>
        </header>
        <ul class="vi-rada" data-rada-seznam>
          {[...r.dily].reverse().map((d) => (
            <li><VideoKarta d={d} rada /></li>
          ))}
        </ul>
      </section>
    ))}

    {ostatni.length > 0 && (
      <section class="obal vi-serie vi-serie--ostatni">
        <header class="vi-serie__hlava">
          <span class="vi-serie__ikona vi-serie__ikona--svetla" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ikona('graf')} /></svg>
          </span>
          <div class="vi-serie__text">
            <h2>Další videa <span class="vi-serie__pocet">{videi(ostatni.length)}</span></h2>
            <p>Mapy, žebříčky a příběhy z dat, které nepatří do žádné série.</p>
          </div>
        </header>
        <ul class="vi-mrizka">
          {ostatni.map((d) => <li><VideoKarta d={d} /></li>)}
        </ul>
      </section>
    )}
  </div>

  <section class="obal sekce--mala vi-vysledky" data-vi-vysledky hidden aria-live="polite">
    <header class="vi-vysledky__hlava">
      <div>
        <h2 data-vi-titul>Výsledky</h2>
        <p class="drobne" data-vi-popis hidden></p>
      </div>
      <div class="vi-vysledky__ovladani">
        <span class="vi-vysledky__pocet" data-vi-pocet></span>
        <div class="vi-razeni" role="group" aria-label="Řazení">
          <button type="button" data-razeni="nove" aria-pressed="true">Nejnovější</button>
          <button type="button" data-razeni="stare" aria-pressed="false">Od nejstaršího</button>
        </div>
        <button type="button" class="tlacitko tlacitko--male" data-vi-zrusit>Zrušit filtr</button>
      </div>
    </header>
    <ul class="vi-mrizka" data-vi-mrizka>
      {vse.map((d) => <li data-polozka><VideoKarta d={d} /></li>)}
    </ul>
    <div class="vi-nic" data-vi-nic hidden>
      <strong>Nic takového jsme nenašli.</strong>
      <p class="drobne">Zkus jiné slovo, třeba název města, země nebo panovníka. Nebo vyber sérii nahoře.</p>
    </div>
  </section>

  <script is:inline type="application/json" id="vi-filtry" set:html={filtry} />
</Base>

<style>
  .vi-uvod { position: relative; isolation: isolate; padding-bottom: 0.5rem; }
  .vi-uvod::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: url('/vrstevnice.svg') center top / cover no-repeat; opacity: calc(0.7 * var(--vrstevnice-sila));
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
  }
  .vi-uvod__obsah { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; padding-block: clamp(2.5rem, 6vw, 4rem) 1.25rem; }
  .vi-uvod__obsah h1 { font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1.1; text-wrap: balance; }
  .vi-uvod__obsah .perex { max-width: 56ch; margin: 0; }
  .vi-cisla { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; list-style: none; margin: 0.2rem 0 0; padding: 0; }
  .vi-cisla li { display: flex; align-items: baseline; gap: 0.4rem; padding: 0.45rem 1rem; border-radius: 999px; background: var(--paper); box-shadow: 0 0 0 1px var(--line), var(--stin-maly); }
  .vi-cisla strong { font-size: 1.15rem; font-weight: 900; color: var(--orange-text); font-variant-numeric: tabular-nums; }
  .vi-cisla span { font-size: 0.86rem; font-weight: 700; color: var(--muted); }
  .vi-hledani { width: min(100%, 560px); margin-top: 0.6rem; }
  .vi-hledani .hledani__pole { min-height: 58px; padding: 0 0.6rem 0 1.25rem; }
  .vi-hledani input { font-size: 1.02rem; }
  .vi-hledani__smazat { display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--hover); color: var(--navy); cursor: pointer; transition: transform var(--stisk) var(--ease-out); }
  .vi-hledani__smazat:active { transform: scale(0.9); }

  .vi-filtry { display: flex; flex-direction: column; gap: 0.5rem; align-items: center; }
  .vi-filtry__rada { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.4rem; max-width: 100%; }
  .vi-filtry__chipy { display: contents; }
  .vi-filtry__titul { flex: 0 0 auto; margin-right: 0.35rem; font-size: 0.7rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .vi-chip { min-height: 38px; padding: 0 0.85rem; gap: 0.4rem; font-size: 0.86rem; white-space: nowrap; }
  .vi-chip small { font-size: 0.74rem; font-weight: 800; color: var(--muted); font-variant-numeric: tabular-nums; }
  .vi-chip[aria-pressed='true'] small { color: var(--akcent-na-inkoustu); }
  .vi-chip svg { color: var(--orange-text); flex-shrink: 0; }
  .vi-chip[aria-pressed='true'] svg { color: var(--akcent-na-inkoustu); }
  .vi-chip:active { transform: scale(0.96); }
  @media (hover: hover) and (pointer: fine) { .vi-chip[aria-pressed='false']:hover { border-color: var(--navy); } }
  /* Na telefonu jedna řada na posun do strany, ať filtry nezaberou půl obrazovky */
  @media (max-width: 760px) {
    .vi-filtry { align-items: stretch; gap: 0.7rem; }
    .vi-filtry__rada { flex-direction: column; flex-wrap: nowrap; align-items: flex-start; gap: 0.35rem; }
    .vi-filtry__chipy { display: flex; flex-wrap: nowrap; gap: 0.4rem; overflow-x: auto; width: calc(100% + 2.5rem); margin-inline: -1.25rem; padding: 0.15rem 1.25rem 0.4rem; scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding-inline: 1.25rem; }
    .vi-filtry__chipy::-webkit-scrollbar { display: none; }
    .vi-chip { scroll-snap-align: start; }
    .vi-filtry__titul { padding-left: 0.1rem; }
  }

  /* Nejnovější video */
  .vi-nove { display: grid; grid-template-columns: minmax(200px, 300px) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; padding: clamp(1.25rem, 3vw, 2rem); border-radius: 28px; background: var(--paper); box-shadow: 0 0 0 1px var(--line), var(--stin); }
  @media (max-width: 720px) { .vi-nove { grid-template-columns: 1fr; justify-items: center; text-align: center; } .vi-nove__obalka { width: min(70%, 260px); } }
  .vi-nove__obalka { display: block; border-radius: 18px; transition: transform 0.35s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .vi-nove__obalka:hover { transform: translateY(-4px) rotate(-0.6deg); } }
  .vi-nove__obalka:active { transform: scale(0.98); }
  .vi-nove__text { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; min-width: 0; }
  @media (max-width: 720px) { .vi-nove__text { align-items: center; } .vi-nove__text .rada { justify-content: center; } }
  .vi-nove__text h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); line-height: 1.15; text-wrap: balance; }
  .vi-nove__text .perex { margin: 0; max-width: 52ch; }
  .vi-nove__serie { font-size: 0.9rem; font-weight: 800; color: var(--muted); margin-bottom: -0.4rem; }
  .vi-nove__hlasuj { display: inline-flex; flex-direction: column; gap: 0.1rem; padding: 0.75rem 1rem; border-radius: 16px; background: var(--panel); color: var(--na-panelu); text-decoration: none; transition: transform var(--stisk) var(--ease-out); }
  .vi-nove__hlasuj span { font-size: 0.78rem; font-weight: 800; color: var(--na-panelu-akcent); }
  .vi-nove__hlasuj strong { font-size: 0.95rem; }
  .vi-nove__hlasuj:active { transform: scale(0.98); }
  .vi-nove__dalsi { width: 100%; margin-top: 0.5rem; padding-top: 1rem; border-top: 1px solid var(--line); text-align: left; }
  .vi-nove__dalsi-titul { display: block; margin-bottom: 0.6rem; font-size: 0.72rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .vi-nove__dalsi ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  @media (max-width: 960px) { .vi-nove__dalsi ul { grid-template-columns: 1fr; } }
  .vi-mini { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 0.7rem; align-items: center; padding: 0.35rem; border-radius: 14px; color: inherit; text-decoration: none; transition: background-color 0.2s ease, transform var(--stisk) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .vi-mini:hover { background: var(--hover); } }
  .vi-mini:active { transform: scale(0.98); }
  .vi-mini__obalka :global(.so) { border-radius: 9px; }
  .vi-mini__obalka :global(.so__prehrat) { display: none; }
  .vi-mini__text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .vi-mini__text small { font-size: 0.72rem; font-weight: 700; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vi-mini__text strong { font-size: 0.88rem; font-weight: 900; line-height: 1.3; color: var(--navy); display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Série jako vodorovné řady */
  .vi-serie { padding-block: clamp(1.25rem, 3vw, 2rem); }
  .vi-serie + .vi-serie { border-top: 1px solid var(--line-jemna); }
  .vi-serie__hlava { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1rem; align-items: center; margin-bottom: 1.1rem; }
  .vi-serie__ikona { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 15px; background: var(--panel); color: var(--orange); box-shadow: var(--stin-maly); }
  .vi-serie__ikona svg { width: 26px; height: 26px; }
  .vi-serie__ikona--svetla { background: var(--oranzova-svetla); color: var(--orange-text); }
  .vi-serie__text h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.7rem; font-size: clamp(1.3rem, 2.4vw, 1.6rem); line-height: 1.2; }
  .vi-serie__pocet { font-size: 0.82rem; font-weight: 800; color: var(--orange-text); }
  .vi-serie__text p { margin: 0.2rem 0 0; font-size: 0.92rem; color: var(--muted); max-width: 70ch; line-height: 1.55; }
  .vi-serie__ovladani { display: flex; align-items: center; gap: 0.4rem; }
  @media (max-width: 640px) {
    .vi-serie__hlava { grid-template-columns: auto minmax(0, 1fr); }
    .vi-serie__ovladani { grid-column: 1 / -1; }
    .vi-serie__ikona { width: 42px; height: 42px; border-radius: 13px; }
  }
  .vi-sipka { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid var(--line-2); background: var(--paper); color: var(--navy); cursor: pointer; transition: transform var(--stisk) var(--ease-out), opacity 0.2s ease, border-color 0.2s ease; }
  .vi-sipka:disabled { opacity: 0.35; cursor: default; }
  .vi-sipka:not(:disabled):active { transform: scale(0.92); }
  @media (hover: hover) and (pointer: fine) { .vi-sipka:not(:disabled):hover { border-color: var(--navy); } }
  .vi-rada {
    list-style: none; margin: 0 -1.25rem; padding: 0.5rem 1.25rem 1rem; display: grid; grid-auto-flow: column;
    grid-auto-columns: clamp(140px, 17vw, 186px); gap: clamp(0.85rem, 1.6vw, 1.25rem);
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 1.25rem; scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 1.25rem, #000 calc(100% - 2.5rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 1.25rem, #000 calc(100% - 2.5rem), transparent 100%);
  }
  .vi-rada::-webkit-scrollbar { display: none; }
  .vi-rada > li { scroll-snap-align: start; min-width: 0; }
  @media (prefers-reduced-motion: no-preference) { .vi-rada { scroll-behavior: smooth; } }

  .vi-mrizka { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 176px), 1fr)); gap: clamp(1.25rem, 2.4vw, 1.75rem) clamp(0.9rem, 1.8vw, 1.25rem); }
  @media (max-width: 480px) { .vi-mrizka { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Výsledky hledání a filtru */
  .vi-vysledky { scroll-margin-top: 80px; }
  .vi-vysledky__hlava { display: flex; flex-wrap: wrap; gap: 0.8rem 1.5rem; align-items: flex-end; justify-content: space-between; margin-bottom: 1.5rem; }
  .vi-vysledky__hlava h2 { font-size: clamp(1.4rem, 2.8vw, 1.9rem); }
  .vi-vysledky__hlava p { margin: 0.3rem 0 0; max-width: 64ch; }
  .vi-vysledky__ovladani { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .vi-vysledky__pocet { font-size: 0.9rem; font-weight: 800; color: var(--orange-text); }
  .vi-razeni { display: inline-flex; padding: 3px; border-radius: 999px; background: var(--draha); }
  .vi-razeni button { min-height: 34px; padding: 0 0.85rem; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-family: inherit; font-size: 0.82rem; font-weight: 800; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease; }
  .vi-razeni button[aria-pressed='true'] { background: var(--paper); color: var(--navy); box-shadow: var(--stin-maly); }
  .vi-nic { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; padding: 3rem 1rem; text-align: center; border-radius: 22px; border: 1.5px dashed var(--line-2); }
  .vi-nic strong { font-size: 1.1rem; }
  .vi-nic p { margin: 0; max-width: 46ch; }
  .vi-mrizka > li[hidden] { display: none; }
  .js .vi-mrizka.je-nova > li:not([hidden]) { animation: vi-vjezd 0.4s var(--ease-out) both; animation-delay: calc(min(var(--i, 0), 12) * 28ms); }
  @keyframes vi-vjezd { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .js .vi-mrizka.je-nova > li:not([hidden]) { animation: none; } }
</style>

<script>
  import { bezDiakritiky } from '../lib/naseptavac';

  type Popis = { nazev: string; popis?: string };
  const F = JSON.parse(document.getElementById('vi-filtry')!.textContent!) as { serie: Record<string, Popis>; tema: Record<string, Popis> };
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const vstup = $<HTMLInputElement>('[data-vi-hledat]');
  const smazat = $<HTMLButtonElement>('[data-vi-smazat]');
  const prehled = $<HTMLElement>('[data-vi-prehled]');
  const vysledky = $<HTMLElement>('[data-vi-vysledky]');
  const mrizka = $<HTMLElement>('[data-vi-mrizka]');
  const titul = $<HTMLElement>('[data-vi-titul]');
  const popis = $<HTMLElement>('[data-vi-popis]');
  const pocet = $<HTMLElement>('[data-vi-pocet]');
  const nic = $<HTMLElement>('[data-vi-nic]');
  const chipy = [...document.querySelectorAll<HTMLButtonElement>('.vi-chip')];
  const razeniTl = [...document.querySelectorAll<HTMLButtonElement>('[data-razeni]')];
  const polozky = [...mrizka.querySelectorAll<HTMLElement>('[data-polozka]')].map((li) => {
    const k = li.querySelector<HTMLElement>('[data-video]')!;
    return { li, serie: k.dataset.serie!, tema: k.dataset.tema!.split(' '), text: k.dataset.hledat!, datum: k.dataset.datum!, dil: Number(k.dataset.dil || 0) };
  });

  let filtr = ''; // id série, 'ostatni' nebo 't=tema'
  let dotaz = '';
  let razeni: 'nove' | 'stare' = 'nove';

  const videi = (n: number) => `${n} ${n === 1 ? 'video' : n >= 2 && n <= 4 ? 'videa' : 'videí'}`;

  function vykresli(posun = false) {
    const slova = bezDiakritiky(dotaz).split(/\s+/).filter(Boolean);
    const aktivni = Boolean(filtr || slova.length);
    prehled.hidden = aktivni;
    vysledky.hidden = !aktivni;
    chipy.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.filtr ?? '') === filtr)));
    smazat.hidden = !dotaz;
    if (!aktivni) return;

    const tema = filtr.startsWith('t=') ? filtr.slice(2) : '';
    const serie = !tema ? filtr : '';
    const vyhovuje = polozky.filter((p) =>
      (!serie || p.serie === serie) && (!tema || p.tema.includes(tema)) && slova.every((s) => p.text.includes(s)));
    const mnozina = new Set(vyhovuje);
    // Série se řadí podle dílů, ostatní podle data
    const klic = (p: (typeof polozky)[number]) => (serie && serie !== 'ostatni' && p.dil ? p.dil : 0);
    const serazene = [...polozky].sort((a, b) => {
      const r = razeni === 'nove' ? b.datum.localeCompare(a.datum) || klic(b) - klic(a) : a.datum.localeCompare(b.datum) || klic(a) - klic(b);
      return r;
    });
    let i = 0;
    for (const p of serazene) {
      p.li.hidden = !mnozina.has(p);
      if (!p.li.hidden) p.li.style.setProperty('--i', String(i++));
      mrizka.append(p.li);
    }
    mrizka.classList.remove('je-nova');
    void mrizka.offsetWidth;
    mrizka.classList.add('je-nova');

    const info = serie ? F.serie[serie] : tema ? F.tema[tema] : null;
    titul.textContent = info ? (slova.length ? `${info.nazev}: „${dotaz.trim()}“` : info.nazev) : `Hledání „${dotaz.trim()}“`;
    popis.hidden = !info?.popis || slova.length > 0;
    popis.textContent = info?.popis ?? '';
    pocet.textContent = videi(vyhovuje.length);
    nic.hidden = vyhovuje.length > 0;
    if (posun) vysledky.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }

  function zapisAdresu() {
    const h = filtr ? filtr : dotaz.trim() ? `q=${encodeURIComponent(dotaz.trim())}` : '';
    history.replaceState(null, '', h ? `#${h}` : location.pathname + location.search);
  }

  function nastavFiltr(f: string, posun: boolean) {
    filtr = filtr === f ? '' : f;
    // Série od prvního dílu, ostatní od nejnovějšího
    razeni = filtr && !filtr.startsWith('t=') && filtr !== 'ostatni' ? 'stare' : 'nove';
    razeniTl.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.razeni === razeni)));
    zapisAdresu();
    vykresli(posun);
  }

  chipy.forEach((c) => c.addEventListener('click', () => nastavFiltr(c.dataset.filtr ?? '', false)));
  document.querySelectorAll<HTMLAnchorElement>('a[data-filtr]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    nastavFiltr(a.dataset.filtr!, false);
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }));
  razeniTl.forEach((b) => b.addEventListener('click', () => {
    razeni = b.dataset.razeni as 'nove' | 'stare';
    razeniTl.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    vykresli();
  }));
  $<HTMLButtonElement>('[data-vi-zrusit]').addEventListener('click', () => {
    filtr = ''; dotaz = ''; vstup.value = '';
    zapisAdresu(); vykresli();
  });

  let casovac = 0;
  vstup.addEventListener('input', () => {
    clearTimeout(casovac);
    casovac = window.setTimeout(() => { dotaz = vstup.value; zapisAdresu(); vykresli(); }, 120);
  });
  vstup.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { vstup.value = ''; dotaz = ''; zapisAdresu(); vykresli(); }
    if (e.key === 'Enter') { e.preventDefault(); vstup.blur(); vysledky.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  });
  smazat.addEventListener('click', () => { vstup.value = ''; dotaz = ''; zapisAdresu(); vykresli(); vstup.focus(); });

  // Filtr z adresy: #ceske-rody, #t=historie, #q=brno
  function zAdresy() {
    const h = decodeURIComponent(location.hash.slice(1));
    filtr = ''; dotaz = '';
    if (h.startsWith('q=')) dotaz = h.slice(2);
    else if (h.startsWith('t=') ? F.tema[h.slice(2)] : F.serie[h]) filtr = h;
    vstup.value = dotaz;
    razeni = filtr && !filtr.startsWith('t=') && filtr !== 'ostatni' ? 'stare' : 'nove';
    razeniTl.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.razeni === razeni)));
    vykresli(Boolean(filtr || dotaz) && location.hash.length > 1);
  }
  window.addEventListener('hashchange', zAdresy);
  zAdresy();

  // Šipky u řad sérií (jen když se řada nevejde)
  document.querySelectorAll<HTMLElement>('[data-rada]').forEach((sekce) => {
    const seznam = sekce.querySelector<HTMLElement>('[data-rada-seznam]')!;
    const [zpet, dal] = [...sekce.querySelectorAll<HTMLButtonElement>('[data-posun]')];
    const stav = () => {
      const preteka = seznam.scrollWidth > seznam.clientWidth + 4;
      zpet.hidden = dal.hidden = !preteka || matchMedia('(hover: none)').matches;
      zpet.disabled = seznam.scrollLeft < 4;
      dal.disabled = seznam.scrollLeft + seznam.clientWidth > seznam.scrollWidth - 4;
    };
    [zpet, dal].forEach((b) => b.addEventListener('click', () => seznam.scrollBy({ left: Number(b.dataset.posun) * seznam.clientWidth * 0.8 })));
    seznam.addEventListener('scroll', stav, { passive: true });
    new ResizeObserver(stav).observe(seznam);
  });
</script>
