---
import Base from '../layouts/Base.astro';
import NovinkaKarta from '../components/NovinkaKarta.astro';
import { vydaniNovinek } from '../lib/novinky';
import { datum } from '../lib/format';

const vydani = await vydaniNovinek();
// kotvy z pásu čísel míří vždy na nejnovější výskyt ukazatele
const kotvy = new Set<string>();
---

<Base
  titul="Novinky z dat — data.cesky"
  popis="Nejzajímavější čísla, která za poslední měsíc zveřejnil Český statistický úřad a Eurostat. Inflace, ceny, mzdy, nezaměstnanost, HDP, porodnost i turisté."
>
  <section class="obal sekce--mala sloupec" style="gap: 2rem;">
    <div class="sloupec" style="max-width: 62ch;">
      <span class="nadhlavi nadhlavi--zive">Novinky z dat{vydani[0] && ` · ${datum(vydani[0].data.datum)}`}</span>
      <h1>Co nového ukázala data</h1>
      <p class="perex">Jednou měsíčně vybírám nejzajímavější čísla, která zveřejnil Český statistický úřad a Eurostat. U každého je malý graf a odkaz na datovou sadu, ze které pochází.</p>
    </div>

    {vydani.length === 0 && <p class="drobne">První vydání chystám.</p>}
    {vydani.map((v) => (
      <section class="sloupec" style="gap: 1.1rem;" id={v.id}>
        <h2 class="vydani__titul">{v.data.titul.replace('Novinky z dat: ', '')}</h2>
        <ul class="mrizka-novinek">
          {v.data.polozky.map((p) => {
            const kotva = !kotvy.has(p.id);
            kotvy.add(p.id);
            return <NovinkaKarta p={p} kotva={kotva} />;
          })}
        </ul>
      </section>
    ))}

    <p class="drobne" style="max-width: 70ch;">
      Čísla stahuje automat přímo z otevřených dat ČSÚ (DataStat) a Eurostatu. Před zveřejněním každé vydání projdu a ověřím.
      Najdeš chybu? Napiš na <a href="mailto:data.cesky@gmail.com">data.cesky@gmail.com</a>.
    </p>
  </section>
</Base>

<style>
  .vydani__titul { font-size: clamp(1.4rem, 3vw, 1.9rem); text-transform: none; }
  .vydani__titul::first-letter { text-transform: uppercase; }
  .mrizka-novinek { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 1020px) { .mrizka-novinek { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .mrizka-novinek { grid-template-columns: 1fr; } }
</style>
