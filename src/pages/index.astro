---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BarChart from '../components/BarChart.astro';
import HeroGlobus from '../components/uvod/HeroGlobus.astro';
import ZebrickyUpoutavka from '../components/ZebrickyUpoutavka.astro';
import { posledniNovinky } from '../lib/novinky';
import MapaMini from '../components/uvod/MapaMini.astro';
import HlasovaniPozvanka from '../components/HlasovaniPozvanka.astro';
import NovinkaKarta from '../components/NovinkaKarta.astro';
import SerieObalka from '../components/SerieObalka.astro';
import { vsechnyDily } from '../lib/dily';
import { ZEME } from '../lib/svet';
import { epizody } from '../data/epizody';
import { datum } from '../lib/format';

const grafy = (await getCollection('grafy')).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const tydne = grafy[0];
const novinky = await posledniNovinky(6);
const aktualizovano = novinky.length ? new Date(Math.max(...novinky.map((n) => n.datumVydani.valueOf()))) : null;
// Seznam zemí pro vyhledávání v úvodu (jen název a vlajka, ať je stránka lehká)
const zemeHledani = JSON.stringify(Object.entries(ZEME).filter(([a3]) => a3 !== 'EUZ' && a3 !== 'CZE').map(([a3, [n, a2]]) => [a3, n, a2]));

// V grafu týdne ukážeme až 10 řádků a Česko vždycky.
const polozkyTydne = (() => {
  if (!tydne) return [];
  const p = tydne.data.polozky;
  const prvni = p.slice(0, 10);
  const cesko = p.find((x) => x.kategorie === 'Česko');
  return cesko && !prvni.includes(cesko) ? [...prvni.slice(0, 9), cesko] : prvni;
})();

const IG = 'https://www.instagram.com/data.cesky/';
const TT = 'https://www.tiktok.com/@data.cesky';
const FB = 'https://www.facebook.com/data.cesky';
---

<Base titul="data.cesky — Česko v mapách, grafech a číslech" obrazek="/og/uvod.png">
  <div class="vrstevnice">
  <section class="uvod obal">
    <div class="uvod__text">
      <h1>Česko v mapách, grafech a&nbsp;číslech</h1>
      <p class="perex">Data z ČSÚ, Eurostatu, Světové banky a dalších primárních zdrojů. Všechno, co tu vidíš, se dá rozkliknout.</p>
      <div class="uvod__hledani" data-uvod-hledani data-zeme={zemeHledani}>
        <label class="uvod__hledani-titul" for="uvod-hledani">Porovnej Česko s jakoukoli zemí</label>
        <div class="hledani">
          <div class="hledani__pole">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 4a6 6 0 1 0 0 12a6 6 0 1 0 0-12 M20 20l-5.6-5.6" /></svg>
            <input id="uvod-hledani" type="search" enterkeyhint="search" placeholder="Napiš zemi, třeba Japonsko" />
          </div>
          <ul class="naseptavac" hidden></ul>
        </div>
      </div>
      <div class="uvod__hlasovani"><HlasovaniPozvanka mala /></div>
      <div class="uvod__legenda">
        <span><i style="background: #F08829;"></i>Česko</span>
        <span><i style="background: #1B2A4A;"></i>{epizody.length} zemí ze série Česko vs. svět</span>
      </div>
    </div>
    <a href="/svet/" class="uvod__globus" aria-label="Otevřít glóbus">
      <HeroGlobus />
    </a>
  </section>
  </div>

  {novinky.length > 0 && (
    <section class="obal sekce--mala novinky-uvod">
      <div class="nadpis-sekce">
        <div class="nadpis">
          <span class="nadhlavi nadhlavi--zive">Nová data{aktualizovano && ` · ${datum(aktualizovano)}`}</span>
          <h2>Novinky z dat</h2>
          <p class="drobne">Nejzajímavější čísla, která za poslední měsíc zveřejnil ČSÚ a Eurostat.</p>
        </div>
        <a class="tlacitko tlacitko--male" href="/novinky/">Všechny novinky</a>
      </div>
      <ul class="posuvnik" data-posuvnik>
        {novinky.slice(0, 6).map((p) => <NovinkaKarta p={p} />)}
      </ul>
      <div class="tecky" aria-hidden="true" data-tecky>{novinky.slice(0, 6).map((_, i) => <i class:list={{ 'je-aktivni': i === 0 }}></i>)}</div>
    </section>
  )}

  <section class="obal sekce--mala">
    <div class="nadpis-sekce">
      <div class="nadpis">
        <span class="nadhlavi">Žebříčky</span>
        <h2>Kde je Česko ve světě</h2>
      </div>
      <a class="tlacitko tlacitko--male" href="/zebricky/">Všechny žebříčky</a>
    </div>
    <ZebrickyUpoutavka />
  </section>

  <section class="obal sekce--mala">
    <div class="nadpis-sekce">
      <div class="nadpis">
        <span class="nadhlavi">Série</span>
        <h2>Poslední díly</h2>
      </div>
      <a class="tlacitko tlacitko--male" href="/serie/">Všechny díly</a>
    </div>
    <ul class="dily-uvod">
      {vsechnyDily.slice(0, 5).map((d) => (
        <li>
          <a class="dily-uvod__dil" href={d.odkaz}>
            <SerieObalka slug={d.slug} serie={d.serie} typ={d.typ} dil={d.dil} nazev={d.nazev} a3={d.a3} ikonaId={d.ikona} />
            <span class="dily-uvod__nazev">{d.typ === 'vs' ? `Česko vs. ${d.nazev}` : d.nazev}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {tydne && (
    <section class="obal sekce--mala">
      <a class="tydne" href={`/grafy/${tydne.id}/`}>
        <div class="tydne__text">
          <span class="nadhlavi">Graf týdne</span>
          <h2>{tydne.data.titul}</h2>
          <p class="perex">{tydne.data.perex}</p>
          <span class="drobne tydne__meta"><span>Zdroj: {tydne.data.zdroj}</span><span>Vyšlo {datum(tydne.data.datum)}</span></span>
        </div>
        <div class="tydne__graf">
          <div class="sloupec" style="gap: 0.3rem; text-align: center;">
            <span class="nadpis-grafu">{tydne.data.titul}</span>
            {tydne.data.popisGrafu && <span class="stitek">{tydne.data.popisGrafu}</span>}
          </div>
          <BarChart polozky={polozkyTydne} barvy={tydne.data.barvy} desetinna={tydne.data.desetinna} legenda={true} />
          <div class="rada rada--mezi">
            <span class="drobne">Zdroj: {tydne.data.zdroj}</span>
            <span class="znacka">@data<span>.cesky</span></span>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="obal sekce--mala">
    <div class="nadpis-sekce" style="justify-content: center; text-align: center;">
      <h2>Porovnej kraje na jedné mapě</h2>
    </div>
    <MapaMini />
    <div class="mapa-odkaz">
      <a class="tlacitko tlacitko--plny" href="/mapa/">Otevřít celou mapu</a>
      <span class="drobne">Na celé mapě jsou i města, satelit a vývoj v čase.</span>
    </div>
  </section>

  <section class="obal sekce--mala">
    <div class="pas">
      <div class="sloupec">
        <h2>Nový graf každý týden</h2>
        <p style="font-size: 1.1rem; max-width: 52ch;">
          Animované verze grafů vycházejí nejdřív na sociálních sítích. Sleduj data.cesky, ať ti nic neuteče.
        </p>
      </div>
      <div class="rada pas__site">
        <a class="tlacitko tlacitko--oranzovy" href={IG}>Instagram</a>
        <a class="tlacitko tlacitko--svetly" href={TT}>TikTok</a>
        <a class="tlacitko tlacitko--svetly" href={FB}>Facebook</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { naseptavac } from '../lib/naseptavac';
  const box = document.querySelector<HTMLElement>('[data-uvod-hledani]');
  if (box) {
    const zeme = JSON.parse(box.dataset.zeme!) as [string, string, string][];
    naseptavac(box.querySelector('input')!, box.querySelector('.naseptavac')!, zeme.map(([kod, nazev, a2]) => ({ kod, nazev, vlajka: `/vlajky/${a2}.svg` })), (p) => {
      location.href = `/svet/#z=${p.kod}`;
    });
  }
</script>

<style>
  /* Vrstevnice jako na titulních slidech: jen v úvodu, dole se ztratí do stránky */
  .vrstevnice { position: relative; isolation: isolate; }
  .vrstevnice::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: url('/vrstevnice.svg') center top / cover no-repeat;
    opacity: 0.8;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }
  .uvod { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding-block: clamp(2rem, 5vw, 4rem) clamp(0.5rem, 2vw, 1.5rem); }
  @media (max-width: 860px) { .uvod { grid-template-columns: 1fr; text-align: center; } .uvod__text { align-items: center; } }
  .uvod__text { display: flex; flex-direction: column; gap: 1.3rem; align-items: flex-start; }
  .uvod h1 { font-size: clamp(2.2rem, 4vw, 3.1rem); line-height: 1.14; }
  .uvod__hledani { display: flex; flex-direction: column; gap: 0.45rem; width: min(100%, 420px); position: relative; z-index: 15; }
  .uvod__hledani .hledani { width: 100%; }
  .uvod__hledani-titul { font-size: 0.92rem; font-weight: 800; color: var(--navy); }
  @media (max-width: 860px) { .uvod__hledani { margin-inline: auto; text-align: left; } }
  .uvod__hlasovani { width: min(100%, 420px); }
  .uvod__hlasovani:empty { display: none; }
  .uvod__legenda { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; font-size: 0.85rem; font-weight: 700; color: var(--text-2); }
  .uvod__legenda span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .uvod__legenda i { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .uvod__globus { display: block; max-width: 560px; justify-self: center; width: 100%; -webkit-touch-callout: none; transition: transform 0.2s var(--ease-out); }
  @media (max-width: 860px) { .uvod__globus { max-width: 340px; } }
  /* Na telefonu menší glóbus, ať jsou novinky blíž nahoře */
  @media (max-width: 560px) { .uvod { padding-block: 1.75rem 0.5rem; gap: 1.25rem; } .uvod__globus { max-width: 250px; } .uvod__text { gap: 1rem; } }
  .uvod__globus:active { transform: scale(0.985); }

  .tydne { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; text-decoration: none; color: var(--navy); }
  .tydne:hover { color: var(--navy); }
  @media (hover: hover) and (pointer: fine) { .tydne:hover .tydne__graf { box-shadow: 0 1px 2px rgba(27, 42, 74, 0.05), 0 18px 40px -14px rgba(27, 42, 74, 0.3); } }
  .tydne:active .tydne__graf { transform: scale(0.99); }
  @media (max-width: 880px) { .tydne { grid-template-columns: 1fr; } }
  .tydne__text { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .tydne__graf { background: var(--paper); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--stin); padding: clamp(1.25rem, 3vw, 2.25rem); display: flex; flex-direction: column; gap: 1.2rem; transition: box-shadow 0.25s var(--ease-out), transform 0.2s var(--ease-out); }
  :global(.tydne__graf .legenda) { justify-content: center; }
  .tydne__meta { display: flex; flex-direction: column; gap: 0.15rem; }
  .dily-uvod { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 900px) {
    .dily-uvod { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: -1.25rem; padding: 0.25rem 1.25rem 0.75rem; scroll-padding-inline: 1.25rem; gap: 0.8rem; }
    .dily-uvod::-webkit-scrollbar { display: none; }
    .dily-uvod > li { flex: 0 0 min(40vw, 190px); scroll-snap-align: start; }
  }
  .dily-uvod__dil { display: flex; flex-direction: column; gap: 0.6rem; color: var(--navy); text-decoration: none; -webkit-touch-callout: none; }
  .dily-uvod__dil :global(.so) { transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .dily-uvod__dil:hover :global(.so) { transform: translateY(-4px); } .dily-uvod__dil:hover { color: var(--navy); } }
  .dily-uvod__dil:active :global(.so) { transform: scale(0.98); }
  .dily-uvod__nazev { font-size: 0.92rem; font-weight: 800; line-height: 1.3; }
  .mapa-odkaz { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: 1.4rem; text-align: center; }
  @media (max-width: 560px) {
    .pas__site { display: grid; grid-template-columns: 1fr; width: 100%; }
  }
</style>
