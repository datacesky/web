---
import Base from '../layouts/Base.astro';
import Hlasovani from '../components/Hlasovani.astro';
import { epizody, odkazDilu } from '../data/epizody';
import { ZEME } from '../lib/svet';

const dily = [...epizody].reverse();
---

<Base
  titul="Hlasování: další díl Česko vs. svět — data.cesky"
  popis="Vyber zemi, kterou postavíme vedle Česka v dalším dílu série Česko vs. svět."
  obrazek="/og/hlasovani.png"
>
  <section class="obal sekce--mala sloupec" style="gap: 2rem;">
    <div class="hlava">
      <div class="sloupec" style="gap: 0.6rem; max-width: 60ch;">
        <span class="nadpis__stitek">Česko vs. svět · díl {epizody.length + 1}</span>
        <h1 class="hlava__titul">Kterou zemi postavíme vedle Česka příště?</h1>
        <p class="perex">Každý díl série srovná Česko s jednou zemí: lidi, rozlohu, peníze i to, čím je země zvláštní. O dalším dílu rozhoduješ ty.</p>
      </div>
    </div>

    <Hlasovani />
  </section>

  <section class="obal sekce--mala sloupec" style="gap: 1.25rem;">
    <div class="nadpis-sekce" style="margin-bottom: 0;">
      <div class="nadpis">
        <span class="nadpis__stitek">Už hotové</span>
        <h2>{epizody.length} dílů série</h2>
      </div>
      <a class="tlacitko tlacitko--male" href="/svet/#dily">Srovnání všech dílů</a>
    </div>
    <ul class="hotove">
      {dily.map((d) => (
        <li>
          <a href={odkazDilu(d)} class="hotove__dil">
            <img src={`/vlajky/${ZEME[d.a3][1]}.svg`} alt="" class="vlajka" width="44" height="33" loading="lazy" />
            <span><small>Díl {d.dil}</small>{d.nazev}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hlava__titul { font-size: clamp(2rem, 4.6vw, 3.2rem); line-height: 1.12; }
  .hotove { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 0.6rem; }
  .hotove__dil { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.9rem; border-radius: 16px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--stin-maly); text-decoration: none; color: var(--navy); font-weight: 800; transition: transform 0.2s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .hotove__dil:hover { transform: translateY(-2px); color: var(--navy); } }
  .hotove__dil:active { transform: scale(0.98); }
  .hotove__dil .vlajka { width: 44px; height: 33px; border-radius: 6px; }
  .hotove__dil span { display: flex; flex-direction: column; line-height: 1.3; }
  .hotove__dil small { font-size: 0.72rem; font-weight: 700; color: var(--muted); }
</style>
