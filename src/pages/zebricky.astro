---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ZebrickySveta from '../components/ZebrickySveta.astro';
import ArchivGrafu from '../components/ArchivGrafu.astro';

const grafy = (await getCollection('grafy')).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
---

<Base
  titul="Žebříčky — data.cesky"
  popis="Kde je Česko ve světových žebříčcích štěstí, bohatství, svobody tisku nebo korupce a kdo vede v žebříčcích z Česka. Každý žebříček má uvedený zdroj."
>
  <div class="zb-uvod vrstevnice-pas">
    <section class="obal zb-uvod__obsah">
      <span class="nadhlavi">Žebříčky</span>
      <h1>Kde je Česko a kdo vede</h1>
      <p class="perex">Česko ve světových žebříčcích a žebříčky z Česka. U každého je zdroj a rok dat.</p>
      <nav class="zb-uvod__skok" aria-label="Části stránky">
        <a class="chip" href="#svet">Česko ve světě</a>
        <a class="chip" href="#grafy">Žebříčky z Česka</a>
      </nav>
    </section>
  </div>

  <section class="obal sekce--mala" id="svet">
    <div class="nadpis-sekce">
      <div class="nadpis">
        <span class="nadhlavi">Česko ve světě</span>
        <h2>Na kolikátém místě je Česko</h2>
      </div>
      <p class="drobne" style="max-width: 40ch;">Vyber žebříček. Uvidíš, kde je Česko mezi všemi zeměmi, kdo vede a jak jsou na tom sousedé.</p>
    </div>
    <ZebrickySveta />
  </section>

  <section class="obal sekce--mala" id="grafy">
    <div class="nadpis-sekce">
      <div class="nadpis">
        <span class="nadhlavi">Žebříčky z Česka</span>
        <h2>Firmy, boháči, obchody a turisté</h2>
      </div>
      <p class="drobne" style="max-width: 40ch;">Klikni na graf. Uvnitř je celý žebříček, zdroj, metodika a u některých i vývoj v čase nebo porovnání se sebou.</p>
    </div>
    <ArchivGrafu grafy={grafy} />
  </section>
</Base>

<style>
  .vrstevnice-pas { position: relative; isolation: isolate; }
  .vrstevnice-pas::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: url('/vrstevnice.svg') center top / cover no-repeat; opacity: 0.7;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
  }
  .zb-uvod__obsah { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(0.5rem, 2vw, 1rem); }
  .zb-uvod__obsah h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); }
  .zb-uvod__obsah .perex { max-width: 52ch; }
  .zb-uvod__skok { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 0.4rem; }
  .zb-uvod__skok .chip { text-decoration: none; }
</style>
