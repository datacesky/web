---
import Base from '../layouts/Base.astro';
import { epizody } from '../data/epizody';
import svet from '../data/svet.json';
import { datum } from '../lib/format';

const bmDatum = datum(new Date(svet.bigmac.datum));
---

<Base
  titul="Svět vedle Česka — data.cesky"
  popis="Interaktivní glóbus a mapa světa. Klikni na stát a porovnej ho s Českem: počet obyvatel, vzdálenost od Prahy, cena Big Macu a díly série Česko vs. svět."
>
  <section class="obal sekce--mala sloupec" style="gap: 1.5rem;">
    <div class="sloupec" style="gap: 0.5rem; max-width: 62ch;">
      <h1>Svět vedle Česka</h1>
      <p class="perex">Zatoč glóbusem nebo přepni na plochou mapu a klikni na stát. Uvidíš ho vedle Česka a u zvýrazněných zemí najdeš i náš díl Česko vs. svět.</p>
    </div>

    <div class="svet-ovladani">
      <div class="prepinac" role="group" aria-label="Zobrazení">
        <button type="button" aria-pressed="true" data-rezim="globus">Glóbus</button>
        <button type="button" aria-pressed="false" data-rezim="mapa">Mapa</button>
      </div>
      <div class="rada" role="group" aria-label="Vrstvy" style="gap: 0.5rem;">
        <button type="button" class="chip" data-vrstva="epizody" aria-pressed="true">Česko vs. svět</button>
        <button type="button" class="chip" data-vrstva="pop" aria-pressed="false">Počet obyvatel</button>
        <button type="button" class="chip" data-vrstva="bm" aria-pressed="false">Big Mac index</button>
        <button type="button" class="chip" data-vrstva="km" aria-pressed="false">Vzdálenost od Prahy</button>
      </div>
    </div>

    <div class="svet">
      <div class="karta svet__platno">
        <div class="svet__obal" data-obal>
          <svg class="svet__svg" data-svg role="img" aria-label="Mapa světa">
            <path class="svet__more" data-more></path>
            <path class="svet__sit" data-sit></path>
            <g data-zeme></g>
          </svg>
          <div class="svet__tooltip" data-tooltip hidden></div>
          <noscript><p class="drobne">Glóbus potřebuje zapnutý JavaScript.</p></noscript>
        </div>
        <ul class="legenda" data-legenda></ul>
        <div class="rada rada--mezi">
          <span class="drobne" data-zdroj></span>
          <span class="drobne" data-napoveda>Táhni myší nebo prstem a glóbus se otočí.</span>
        </div>
      </div>

      <aside class="svet__panel" aria-live="polite" data-detail></aside>
    </div>

    <section class="sloupec" style="gap: 1rem; margin-top: 1rem;">
      <div class="nadpis-sekce" style="margin-bottom: 0;">
        <div class="sloupec" style="gap: 0.3rem;">
          <h2>Česko vs. svět</h2>
          <p class="drobne">Série, kde stavíme Česko vedle jedné země. Klikni na vlajku a země se ukáže na mapě.</p>
        </div>
      </div>
      <ul class="epizody">
        {epizody.map((e) => (
          <li>
            <button type="button" class="epizoda" data-zeme-kod={e.a3}>
              <img src={`/vlajky/${
                ({ PRT: 'pt', HND: 'hn', SWE: 'se', SVK: 'sk', HRV: 'hr', AZE: 'az', TUN: 'tn', BOL: 'bo' } as Record<string, string>)[e.a3]
              }.svg`} alt="" width="48" height="36" loading="lazy" />
              <span class="stitek">Díl {e.dil}</span>
              <strong>{e.nazev}</strong>
            </button>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <div id="svet-meta" data-bm-datum={bmDatum} hidden></div>
</Base>

<style>
  .svet-ovladani { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; }
  .prepinac { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); }
  .prepinac button { min-height: 44px; padding: 0 1.3rem; border: 0; border-radius: 999px; background: transparent; color: var(--navy); font-family: inherit; font-size: 0.95rem; font-weight: 800; cursor: pointer; }
  .prepinac button[aria-pressed='true'] { background: var(--navy); color: var(--cream); }

  .svet { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 1.5rem; align-items: start; }
  @media (max-width: 980px) { .svet { grid-template-columns: 1fr; } }
  .svet__platno { display: flex; flex-direction: column; gap: 1rem; }
  .svet__obal { position: relative; display: flex; justify-content: center; }
  .svet__svg { width: 100%; height: auto; display: block; max-height: 72vh; cursor: grab; user-select: none; }
  .svet__svg--globus { touch-action: none; }
  .svet__svg:active { cursor: grabbing; }
  .svet__more { fill: #E6E0D3; stroke: var(--line-2); stroke-width: 1; }
  .svet__svg--mapa .svet__more { fill: #EAE4D8; }
  .svet__sit { fill: none; stroke: #D6CEBE; stroke-width: 0.6; }
  :global(.zeme) { stroke: var(--paper); stroke-width: 0.6; stroke-linejoin: round; cursor: pointer; transition: fill 0.4s ease; }
  :global(.zeme:hover) { filter: brightness(1.12); }
  :global(.zeme--vybrana) { stroke: var(--orange); stroke-width: 2.5; }
  .svet__tooltip {
    position: absolute; pointer-events: none; z-index: 5; transform: translate(-50%, calc(-100% - 14px));
    background: var(--navy); color: var(--cream); padding: 0.5rem 0.8rem; border-radius: 10px;
    font-size: 0.85rem; font-weight: 700; white-space: nowrap; box-shadow: 0 8px 20px rgba(27, 42, 74, 0.25);
  }
  .svet__panel { background: var(--navy); color: var(--cream); border-radius: var(--radius); padding: 1.5rem; min-height: 260px; display: flex; flex-direction: column; gap: 0.6rem; }
  :global(.svet__panel .hlava) { display: flex; align-items: center; gap: 0.9rem; }
  :global(.svet__panel .hlava img) { width: 56px; height: 42px; border-radius: 6px; object-fit: cover; box-shadow: 0 0 0 1px rgba(242, 237, 227, 0.3); }
  :global(.svet__panel .jmeno) { font-size: 1.45rem; font-weight: 900; line-height: 1.2; }
  :global(.svet__panel .maly) { font-size: 0.82rem; font-weight: 700; color: #D9D3C7; }
  :global(.svet__panel .fakt) { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.7rem 0.9rem; border-radius: 12px; background: var(--navy-2); }
  :global(.svet__panel .fakt strong) { font-size: 1.15rem; font-weight: 900; color: var(--orange); }
  :global(.svet__panel .fakt span) { font-size: 0.88rem; font-weight: 600; color: #D9D3C7; }
  :global(.svet__panel .video) { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.9rem; border-radius: 14px; border: 1.5px solid rgba(240, 136, 41, 0.6); }
  :global(.svet__panel a.tlacitko) { border-color: var(--orange); background: var(--orange); color: var(--navy); }
  :global(.svet__panel p) { color: #D9D3C7; font-size: 0.95rem; line-height: 1.6; }

  .epizody { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.75rem; }
  .epizoda {
    width: 100%; display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; padding: 0.9rem;
    border: 1px solid var(--line); border-radius: 16px; background: var(--paper); color: var(--navy);
    font-family: inherit; font-size: 1rem; text-align: left; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .epizoda:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(27, 42, 74, 0.08); }
  .epizoda img { border-radius: 6px; box-shadow: 0 0 0 1px var(--line); }
  @media (prefers-reduced-motion: reduce) { :global(.zeme), .epizoda { transition: none; } }
</style>

<script>
  import { geoOrthographic, geoEqualEarth, geoPath, geoGraticule10, geoCentroid } from 'd3-geo';
  import { feature } from 'topojson-client';
  import svet from '../data/svet.json';
  import { epizody } from '../data/epizody';
  import { hranice, trida, barvaTridy, BEZ_DAT } from '../lib/mapa';

  type Zeme = { type: 'Feature'; id?: string; properties: { n: string; a2?: string }; geometry: any };
  type Udaje = { pop?: { v: number; y: number }; km?: number; bm?: { usd: number; poradi: number } };
  const data = svet.data as Record<string, Udaje>;
  const zeme = (feature(svet.topo as any, (svet.topo as any).objects.countries) as any).features as Zeme[];
  const CZ = data['CZE'];
  const epMapa = new Map(epizody.map((e) => [e.a3, e]));
  const bmDatum = document.getElementById('svet-meta')!.dataset.bmDatum!;
  const ORANZ = '#F08829', NAVY = '#1B2A4A', SVETLA = '#DDE2EA';
  const klidne = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const svg = $<SVGSVGElement>('[data-svg]');
  const skupina = $<SVGGElement>('[data-zeme]');
  const more = $<SVGPathElement>('[data-more]');
  const sit = $<SVGPathElement>('[data-sit]');
  const tooltip = $<HTMLElement>('[data-tooltip]');
  const obal = $<HTMLElement>('[data-obal]');
  const panel = $<HTMLElement>('[data-detail]');

  const cislo = (v: number, d = 0) => new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: d, minimumFractionDigits: d }).format(v);
  const lidi = (v: number) => (v >= 1e6 ? `${cislo(v / 1e6, v >= 1e8 ? 0 : 1)} mil.` : `${cislo(v / 1e3, 0)} tis.`);
  const el = (tag: string, trida?: string, text?: string) => {
    const e = document.createElement(tag);
    if (trida) e.className = trida;
    if (text !== undefined) e.textContent = text;
    return e;
  };

  // --- vrstvy
  type Vrstva = { id: string; hodnota: (a3: string) => number | undefined; format: (v: number) => string; zdroj: string };
  const VRSTVY: Record<string, Vrstva> = {
    epizody: { id: 'epizody', hodnota: () => undefined, format: String, zdroj: 'Série Česko vs. svět, data.cesky' },
    pop: { id: 'pop', hodnota: (a) => data[a]?.pop?.v, format: lidi, zdroj: `Světová banka, počet obyvatel (poslední dostupný rok, většinou ${svet.popRok})` },
    bm: { id: 'bm', hodnota: (a) => data[a]?.bm?.usd, format: (v) => `${cislo(v, 2)} USD`, zdroj: `The Economist, Big Mac index k ${bmDatum}` },
    km: { id: 'km', hodnota: (a) => data[a]?.km, format: (v) => `${cislo(v)} km`, zdroj: 'Natural Earth, vzdušná vzdálenost hlavních měst od Prahy' },
  };
  let vrstva = VRSTVY.epizody;
  let rezim: 'globus' | 'mapa' = 'globus';
  let vybrana: string | null = null;
  let hr: number[] = [];

  function barva(f: Zeme): string {
    const a3 = f.id;
    if (a3 === 'CZE') return ORANZ;
    if (!a3) return BEZ_DAT;
    if (vrstva.id === 'epizody') return epMapa.has(a3) ? NAVY : SVETLA;
    const v = vrstva.hodnota(a3);
    return v === undefined ? BEZ_DAT : barvaTridy(trida(v, hr), hr.length + 1);
  }

  // --- projekce
  const globus = geoOrthographic().rotate([-15, -35]);
  const plocha = geoEqualEarth();
  const cesta = geoPath();
  const sfera = { type: 'Sphere' } as any;
  const mrizka = geoGraticule10();

  const prvky = zeme.map((f) => {
    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('class', 'zeme');
    if (f.id) p.dataset.kod = f.id;
    skupina.append(p);
    return { f, p };
  });

  function nastavRezim(r: 'globus' | 'mapa') {
    rezim = r;
    if (r === 'globus') {
      svg.setAttribute('viewBox', '0 0 800 800');
      globus.fitExtent([[12, 12], [788, 788]], sfera);
      cesta.projection(globus);
    } else {
      svg.setAttribute('viewBox', '0 0 1000 520');
      plocha.fitExtent([[6, 6], [994, 514]], sfera);
      cesta.projection(plocha);
    }
    svg.classList.toggle('svet__svg--globus', r === 'globus');
    svg.classList.toggle('svet__svg--mapa', r === 'mapa');
    $<HTMLElement>('[data-napoveda]').textContent = r === 'globus' ? 'Táhni myší nebo prstem a glóbus se otočí.' : 'Klikni na stát a uvidíš podrobnosti.';
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-rezim]')) b.setAttribute('aria-pressed', String(b.dataset.rezim === r));
    kresli();
  }

  function kresli() {
    more.setAttribute('d', cesta(sfera) ?? '');
    sit.setAttribute('d', cesta(mrizka) ?? '');
    for (const { f, p } of prvky) p.setAttribute('d', cesta(f) ?? '');
  }

  function obarvi() {
    if (vrstva.id !== 'epizody') {
      const hodnoty = zeme.map((f) => (f.id ? vrstva.hodnota(f.id) : undefined)).filter((v): v is number => v !== undefined);
      hr = hranice(hodnoty);
    }
    for (const { f, p } of prvky) {
      p.style.fill = barva(f);
      p.classList.toggle('zeme--vybrana', !!f.id && f.id === vybrana);
    }
    const vybranyPrvek = prvky.find((x) => x.f.id === vybrana);
    if (vybranyPrvek) skupina.append(vybranyPrvek.p);
    legenda();
    $<HTMLElement>('[data-zdroj]').textContent = `Zdroj: ${vrstva.zdroj}`;
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-vrstva]')) b.setAttribute('aria-pressed', String(b.dataset.vrstva === vrstva.id));
  }

  function legenda() {
    const ul = $<HTMLElement>('[data-legenda]');
    const polozky: [string, string][] = [];
    if (vrstva.id === 'epizody') {
      polozky.push([NAVY, 'má díl Česko vs. svět'], [ORANZ, 'Česko']);
    } else {
      const n = hr.length + 1;
      for (let i = 0; i < n; i++) {
        const t = i === 0 ? `do ${vrstva.format(hr[0])}` : i === n - 1 ? `nad ${vrstva.format(hr[n - 2])}` : `${vrstva.format(hr[i - 1])} až ${vrstva.format(hr[i])}`;
        polozky.push([barvaTridy(i, n), t]);
      }
      polozky.push([BEZ_DAT, 'bez dat'], [ORANZ, 'Česko']);
    }
    ul.replaceChildren(...polozky.map(([b, t]) => {
      const li = el('li');
      const tecka = el('span', 'legenda__tecka');
      tecka.style.background = b;
      li.append(tecka, t);
      return li;
    }));
  }

  function fakt(hodnota: string, popis: string) {
    const d = el('div', 'fakt');
    d.append(el('strong', undefined, hodnota), el('span', undefined, popis));
    return d;
  }

  function detail() {
    panel.replaceChildren();
    if (!vybrana) {
      panel.append(
        el('span', 'maly', 'Svět vedle Česka'),
        el('span', 'jmeno', 'Klikni na stát'),
        el('p', undefined, 'Tmavě zvýrazněné státy mají svůj díl Česko vs. svět. U každého státu uvidíš, kolik má obyvatel, jak daleko je jeho hlavní město od Prahy a kolik tam stojí Big Mac.'),
      );
      return;
    }
    const f = zeme.find((z) => z.id === vybrana)!;
    const u = data[vybrana] ?? {};
    const hlava = el('div', 'hlava');
    if (f.properties.a2) {
      const img = el('img') as HTMLImageElement;
      img.src = `/vlajky/${f.properties.a2}.svg`;
      img.alt = '';
      hlava.append(img);
    }
    hlava.append(el('span', 'jmeno', f.properties.n));
    panel.append(hlava);

    if (u.pop) {
      let srovnani = '';
      if (vybrana !== 'CZE' && CZ.pop) {
        const r = u.pop.v / CZ.pop.v;
        srovnani = r > 1.05 ? `${cislo(r, 1)}× víc lidí než v Česku` : r < 0.95 ? `${cislo(1 / r, 1)}× méně lidí než v Česku` : 'skoro stejně lidí jako Česko';
      }
      panel.append(fakt(lidi(u.pop.v), `obyvatel (${u.pop.y})${srovnani ? ', ' + srovnani : ''}`));
    }
    if (u.km !== undefined) panel.append(fakt(`${cislo(u.km)} km`, 'vzdušnou čarou z Prahy do hlavního města'));
    if (u.bm) {
      const cz = vybrana === 'CZE' ? '' : `, v Česku ${cislo(CZ.bm!.usd, 2)} USD`;
      panel.append(fakt(`${cislo(u.bm.usd, 2)} USD`, `Big Mac, ${u.bm.poradi}. nejdražší z ${svet.bigmac.zemi} zemí${cz}`));
    }
    const ep = epMapa.get(vybrana);
    if (ep) {
      const box = el('div', 'video');
      box.append(el('span', 'maly', `Česko vs. svět, díl ${ep.dil}`), el('p', undefined, ep.popis));
      const a = el('a', 'tlacitko tlacitko--male', 'Přehrát na Instagramu') as HTMLAnchorElement;
      a.href = ep.instagram;
      box.append(a);
      panel.append(box);
    }
    if (!u.pop && u.km === undefined && !u.bm && !ep) panel.append(el('p', undefined, 'K tomuto státu zatím data nemáme.'));
  }

  // --- otáčení glóbusu
  let rotace: [number, number] = [-15, -35];
  let interakce = false;
  let animace: number | null = null;
  function otoc(r: [number, number]) {
    rotace = r;
    globus.rotate(r);
    if (rezim === 'globus') kresli();
  }
  function letNa(a3: string) {
    if (rezim !== 'globus') return;
    const f = zeme.find((z) => z.id === a3);
    if (!f) return;
    const [lon, lat] = geoCentroid(f);
    const z = rotace.slice() as [number, number];
    let dl = -lon - z[0];
    dl = ((dl + 540) % 360) - 180;
    const cil: [number, number] = [z[0] + dl, Math.max(-70, Math.min(70, -lat))];
    if (klidne) return otoc(cil);
    const start = performance.now();
    if (animace) cancelAnimationFrame(animace);
    const krok = (t: number) => {
      const k = Math.min(1, (t - start) / 850);
      const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
      otoc([z[0] + (cil[0] - z[0]) * e, z[1] + (cil[1] - z[1]) * e]);
      if (k < 1) animace = requestAnimationFrame(krok);
    };
    animace = requestAnimationFrame(krok);
  }

  let posledni = 0;
  function samoOtaceni(t: number) {
    if (!interakce && rezim === 'globus' && !klidne && !document.hidden) {
      if (t - posledni > 33) { otoc([rotace[0] + 0.25, rotace[1]]); posledni = t; }
    }
    if (!interakce) requestAnimationFrame(samoOtaceni);
  }

  let tah: { x: number; y: number; r: [number, number]; posun: number } | null = null;
  svg.addEventListener('pointerdown', (e) => {
    interakce = true;
    tah = { x: e.clientX, y: e.clientY, r: rotace, posun: 0 };
    if (rezim === 'globus') svg.setPointerCapture(e.pointerId);
  });
  svg.addEventListener('pointermove', (e) => {
    if (tah && rezim === 'globus') {
      const dx = e.clientX - tah.x, dy = e.clientY - tah.y;
      tah.posun = Math.max(tah.posun, Math.hypot(dx, dy));
      const k = 0.35 * (800 / svg.getBoundingClientRect().width);
      otoc([tah.r[0] + dx * k, Math.max(-70, Math.min(70, tah.r[1] - dy * k))]);
    }
    if (e.pointerType === 'mouse') {
      const cil = (tah && rezim === 'globus') ? null : document.elementFromPoint(e.clientX, e.clientY) as SVGPathElement | null;
      const kod = cil?.dataset?.kod;
      if (kod) {
        const f = zeme.find((z) => z.id === kod)!;
        const v = vrstva.id === 'epizody' ? (epMapa.has(kod) ? `díl ${epMapa.get(kod)!.dil}` : '') : (vrstva.hodnota(kod) !== undefined ? vrstva.format(vrstva.hodnota(kod)!) : 'bez dat');
        const r = obal.getBoundingClientRect();
        tooltip.hidden = false;
        tooltip.textContent = v ? `${f.properties.n}: ${v}` : f.properties.n;
        tooltip.style.left = `${e.clientX - r.left}px`;
        tooltip.style.top = `${e.clientY - r.top}px`;
      } else tooltip.hidden = true;
    }
  });
  svg.addEventListener('pointerleave', () => (tooltip.hidden = true));
  svg.addEventListener('pointerup', (e) => {
    const kliknuti = !tah || tah.posun < 6;
    tah = null;
    if (!kliknuti) return;
    const cil = document.elementFromPoint(e.clientX, e.clientY) as SVGPathElement | null;
    const kod = cil?.dataset?.kod;
    vyber(kod && kod !== vybrana ? kod : null, true);
  });

  function vyber(a3: string | null, letet = false) {
    vybrana = a3;
    obarvi();
    detail();
    if (a3 && letet) letNa(a3);
  }

  // --- ovládací prvky
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-rezim]')) b.addEventListener('click', () => nastavRezim(b.dataset.rezim as 'globus' | 'mapa'));
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-vrstva]')) b.addEventListener('click', () => { vrstva = VRSTVY[b.dataset.vrstva!]; obarvi(); });
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-zeme-kod]')) {
    b.addEventListener('click', () => {
      interakce = true;
      vyber(b.dataset.zemeKod!, true);
      svg.scrollIntoView({ behavior: klidne ? 'auto' : 'smooth', block: 'center' });
    });
  }

  nastavRezim('globus');
  obarvi();
  detail();
  requestAnimationFrame(samoOtaceni);
</script>
